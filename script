local scrapBeaconFolder = workspace:FindFirstChild("SIM_ScrapBeacons")
if scrapBeaconFolder then scrapBeaconFolder:Destroy() end
scrapBeaconFolder = Instance.new("Folder")
scrapBeaconFolder.Name = "SIM_ScrapBeacons"
scrapBeaconFolder.Parent = workspace

local scrapPieces = {}
local lastScrapMapFolder = nil
local nextScrapBeaconId = 0

local function findNearestDebrisPos(anchorPos, maxDist)
	local limit = maxDist or 26
	local bestPos, bestDist = nil, limit
	for obj, pos in pairs(scrapPieces) do
		if obj and obj:IsDescendantOf(workspace) then
			local livePos = getItemPosition(obj) or pos
			local d = (livePos - anchorPos).Magnitude
			if d < bestDist then
				bestDist = d
				bestPos = livePos
			end
		end
	end
	return bestPos
end

local function updateScrapBeacons()
	local gameFolder = workspace:FindFirstChild("Game")
	local mapFolder  = gameFolder and gameFolder:FindFirstChild("Map")
	if not mapFolder then
		table.clear(scrapPieces)
		for _, b in ipairs(scrapBeaconFolder:GetChildren()) do b:Destroy() end
		return
	end

	for obj in pairs(scrapPieces) do
		if not obj or not obj:IsDescendantOf(workspace) then
			scrapPieces[obj] = nil
		end
	end

	local groups = {}
	for obj, pos in pairs(scrapPieces) do
		local livePos = getItemPosition(obj) or pos
		scrapPieces[obj] = livePos
		local found = false
		for _, g in ipairs(groups) do
			if (g.position - livePos).Magnitude <= 18 then
				found = true
				break
			end
		end
		if not found then
			table.insert(groups, {object = obj, position = livePos})
		end
	end

	-- Match existing beacons by proximity so breaking one barge never shifts/destroys another's beacon
	local existing = {}
	for _, b in ipairs(scrapBeaconFolder:GetChildren()) do
		existing[b] = true
	end

	for _, g in ipairs(groups) do
		local matchedBeacon = nil
		local bestDist = 26
		for b in pairs(existing) do
			local d = (b.Position - g.position).Magnitude
			if d < bestDist then
				bestDist = d
				matchedBeacon = b
			end
		end
		if matchedBeacon then
			existing[matchedBeacon] = nil
			if (matchedBeacon.Position - g.position).Magnitude > 0.5 then
				matchedBeacon.Position = g.position
			end
		else
			nextScrapBeaconId += 1
			local beacon = Instance.new("Part")
			beacon.Name = "Scrap Barge " .. nextScrapBeaconId
			beacon.Anchored = true
			beacon.CanCollide = false
			beacon.Transparency = 1
			beacon.Size = Vector3.new(1, 1, 1)
			beacon.Position = g.position
			beacon.Parent = scrapBeaconFolder
		end
	end

	for b in pairs(existing) do
		b:Destroy()
	end
end

local scrapUpdateScheduled = false
local function scheduleScrapUpdate()
	if scrapUpdateScheduled then return end
	scrapUpdateScheduled = true
	task.delay(0.25, function()
		scrapUpdateScheduled = false
		updateScrapBeacons()
	end)
end

local function rescanScrapPieces()
	local gameFolder = workspace:FindFirstChild("Game")
	local mapFolder  = gameFolder and gameFolder:FindFirstChild("Map")
	if not mapFolder then
		table.clear(scrapPieces)
		updateScrapBeacons()
		return
	end

	local newPieces = {}
	for _, obj in ipairs(mapFolder:GetDescendants()) do
		if obj.Name == "DebrisPiece" and obj:IsDescendantOf(workspace) then
			local pos = getItemPosition(obj)
			if pos then newPieces[obj] = pos end
		end
	end

	local changed = false
	local prevCount = 0
	for _ in pairs(scrapPieces) do prevCount += 1 end
	local newCount = 0
	for _ in pairs(newPieces) do newCount += 1 end

	if prevCount ~= newCount then
		changed = true
	else
		for obj, pos in pairs(newPieces) do
			local prev = scrapPieces[obj]
			if not prev or (prev - pos).Magnitude > 2 then
				changed = true
				break
			end
		end
	end

	scrapPieces = newPieces
	if changed then
		updateScrapBeacons()
		if activeTab and activeTab.name == "Scrap Barges" and activeTab.rebuild then
			activeTab.rebuild()
		end
	end
end

local mapListenerConns = {}
local function setupMapListeners(force)
	local gameFolder = workspace:FindFirstChild("Game")
	local mapFolder  = gameFolder and gameFolder:FindFirstChild("Map")
	if not mapFolder then
		for _, c in ipairs(mapListenerConns) do c:Disconnect() end
		mapListenerConns = {}
		lastScrapMapFolder = nil
		return false
	end

	if not force and mapFolder == lastScrapMapFolder and #mapListenerConns > 0 then
		return true
	end

	for _, c in ipairs(mapListenerConns) do c:Disconnect() end
	mapListenerConns = {}
	lastScrapMapFolder = mapFolder
	table.clear(scrapPieces)

	rescanScrapPieces()
	updateScrapBeacons()

	table.insert(mapListenerConns, mapFolder.DescendantAdded:Connect(function(obj)
		if obj.Name == "DebrisPiece" then
			local pos = getItemPosition(obj)
			if pos then
				scrapPieces[obj] = pos
				scheduleScrapUpdate()
			else
				task.delay(0.1, function()
					if obj:IsDescendantOf(workspace) then
						local p = getItemPosition(obj)
						if p then
							scrapPieces[obj] = p
							scheduleScrapUpdate()
						end
					end
				end)
			end
		end
	end))

	table.insert(mapListenerConns, mapFolder.DescendantRemoving:Connect(function(obj)
		if obj.Name == "DebrisPiece" and scrapPieces[obj] then
			scrapPieces[obj] = nil
			scheduleScrapUpdate()
			task.delay(0.15, function()
				if activeTab and activeTab.name == "Scrap Barges" and activeTab.rebuild then
					activeTab.rebuild()
				end
			end)
		end
	end))

	table.insert(mapListenerConns, mapFolder.AncestryChanged:Connect(function(_, parent)
		if not parent then
			for _, c in ipairs(mapListenerConns) do c:Disconnect() end
			mapListenerConns = {}
			lastScrapMapFolder = nil
		end
	end))

	return true
end

task.spawn(function()
	while true do
		if not isInstanceAlive() then return end
		setupMapListeners(false)
		rescanScrapPieces()
		updateScrapBeacons()
		task.wait(1.0)
	end
end)

--=====================================================================
-- Barge 30x30 Invisible Platform (despawns 15s after tied barge breaks)
--=====================================================================
local bargePlatforms = {}

local function scheduleBargePlatformDespawn(bargeKey)
	local entry = bargePlatforms[bargeKey]
	if not entry or entry.destroying then return end
	entry.destroying = true
	task.delay(BARGE_PLATFORM_DESPAWN_DELAY, function()
		if entry.part and entry.part.Parent then
			entry.part:Destroy()
		end
		if bargePlatforms[bargeKey] == entry then
			bargePlatforms[bargeKey] = nil
		end
	end)
end

local function isBargeStillAlive(bargeKey, anchorPos)
	if not bargeKey or not bargeKey:IsDescendantOf(workspace) then
		return false
	end
	if bargeKey.Parent == scrapBeaconFolder then
		for obj, pos in pairs(scrapPieces) do
			if obj and obj:IsDescendantOf(workspace) then
				local livePos = getItemPosition(obj) or pos
				if (livePos - anchorPos).Magnitude <= 20 then
					return true
				end
			end
		end
		return false
	end
	return true
end

local function ensureBargePlatform(bargeKey, standPos)
	if not bargeKey or not standPos then return nil end

	local targetPos = Vector3.new(standPos.X, standPos.Y - 4.0, standPos.Z)
	local existing = bargePlatforms[bargeKey]
	if existing and existing.part and existing.part.Parent and not existing.destroying then
		existing.part.Position = targetPos
		return existing.part
	end

	local plat = Instance.new("Part")
	plat.Name = "SIM_BargePlatform"
	plat.Size = BARGE_PLATFORM_SIZE
	plat.Position = targetPos
	plat.Anchored = true
	plat.CanCollide = true
	plat.Transparency = 1
	plat.TopSurface = Enum.SurfaceType.Smooth
	plat.BottomSurface = Enum.SurfaceType.Smooth
	plat.Parent = workspace

	local entry = { part = plat, destroying = false }
	bargePlatforms[bargeKey] = entry

	local anchorPos = getItemPosition(bargeKey) or standPos
	task.spawn(function()
		while isInstanceAlive() and not entry.destroying do
			if not isBargeStillAlive(bargeKey, anchorPos) then
				scheduleBargePlatformDespawn(bargeKey)
				return
			end
			task.wait(0.5)
		end
	end)

	return plat
end

