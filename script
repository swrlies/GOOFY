					card.stateLbl.Text = "ACTIVE"
					card.stateLbl.TextColor3 = C_OK
					card.toggleBtn.Text = "ON"
					card.toggleBtn.BackgroundColor3 = C_OK
					card.rankBg.BackgroundColor3 = C_ACCENT
				elseif hasW then
					card.stateLbl.Text = "YIELDED"
					card.stateLbl.TextColor3 = C_WARN
					card.toggleBtn.Text = "ON"
					card.toggleBtn.BackgroundColor3 = C_OK
