-- Temporary Spawn Route Logic (Arrow Spawns Only)
--=====================================================================
local spawnRouteState = {
	running     = false,
	speed       = 75,
	pauseTime   = 3.0,
	loopRoute   = false,
	useNoclip   = true,
	cancelMove  = nil,
	statusLabel = nil,
	progressLbl = nil,
	startBtn    = nil,
}

local function gatherArrowSpawnNodes()
	local gameFolder = workspace:FindFirstChild("Game")
	local nodesFolder = gameFolder and gameFolder:FindFirstChild("ItemSpawnNodes")
	if not nodesFolder then return {} end

	local targetRoot = nodesFolder:FindFirstChild("Arrows") or nodesFolder
	local raw = {}

	for _, desc in ipairs(targetRoot:GetDescendants()) do
		local isArrowNode = (targetRoot.Name == "Arrows")
			or (desc.Name:lower():find("arrow", 1, true) ~= nil)
			or (desc.Parent and desc.Parent.Name:lower():find("arrow", 1, true) ~= nil)

		if isArrowNode then
			if desc:IsA("BasePart") then
				table.insert(raw, {
					inst = desc,
					name = desc.Name,
					pos  = desc.Position,
				})
			elseif desc:IsA("Model") and not desc:FindFirstChildWhichIsA("BasePart") then
				local ok, cf = pcall(function() return desc:GetPivot() end)
				if ok and cf then
					table.insert(raw, {
						inst = desc,
						name = desc.Name,
						pos  = cf.Position,
					})
				end
			end
		end
	end

	local ordered = {}
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local currentPos = hrp and hrp.Position or Vector3.zero

	while #raw > 0 do
		local bestIdx = 1
		local bestDist = math.huge
		for i, node in ipairs(raw) do
			local d = (node.pos - currentPos).Magnitude
			if d < bestDist then
				bestDist = d
				bestIdx = i
			end
		end
		local chosen = table.remove(raw, bestIdx)
		table.insert(ordered, chosen)
		currentPos = chosen.pos
	end

	return ordered
end

local function tweenRouteToNode(nodeData)
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	local startCF  = hrp.CFrame
	local endCF    = CFrame.new(nodeData.pos + Vector3.new(0, 3, 0))
	local dist     = (startCF.Position - endCF.Position).Magnitude
	local duration = math.max(0.1, dist / math.max(1, spawnRouteState.speed))

	createTweenVisuals(hrp, nodeData.inst, nodeData.pos)

	hrp.Anchored = true
	local cancelled = false
	spawnRouteState.cancelMove = function() cancelled = true end

	local t0 = os.clock()
	while os.clock() - t0 < duration do
		if cancelled or not spawnRouteState.running then
			cancelled = true
			break
		end
		local alpha = math.clamp((os.clock() - t0) / duration, 0, 1)
		if hrp and hrp.Parent then
			hrp.CFrame = startCF:Lerp(endCF, alpha)
		end
		task.wait()
	end

	spawnRouteState.cancelMove = nil
	if hrp and hrp.Parent then
		if not cancelled and spawnRouteState.running then
			hrp.CFrame = endCF
		end
		hrp.Anchored = (not cancelled and spawnRouteState.running)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	return not cancelled
end

local function stopSpawnRoute(reasonText)
	spawnRouteState.running = false
	if spawnRouteState.cancelMove then
		spawnRouteState.cancelMove()
		spawnRouteState.cancelMove = nil
	end
	clearTweenVisuals()
	setRouteNoclip(false)

	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
	end

	if spawnRouteState.startBtn then
		spawnRouteState.startBtn.Text = "Start Arrow Route"
		spawnRouteState.startBtn.BackgroundColor3 = C_ACCENT
	end
	if spawnRouteState.statusLabel then
		spawnRouteState.statusLabel.Text = reasonText or "Status: Idle"
		spawnRouteState.statusLabel.TextColor3 = C_SUB
	end
	updateCountLabel()
end

local function runSpawnRoute()
	task.spawn(function()
		while spawnRouteState.running do
			local nodes = gatherArrowSpawnNodes()
			if #nodes == 0 then
				stopSpawnRoute("No Arrow spawn nodes found.")
				return
			end

			if spawnRouteState.useNoclip then
				setRouteNoclip(true)
			end

			for idx, node in ipairs(nodes) do
				if not spawnRouteState.running then break end

				if spawnRouteState.progressLbl then
					spawnRouteState.progressLbl.Text = string.format("Progress: %d / %d (%s)", idx, #nodes, node.name)
				end
				if spawnRouteState.statusLabel then
					spawnRouteState.statusLabel.Text = "Tweening to: " .. node.name
					spawnRouteState.statusLabel.TextColor3 = C_OK
				end

				local arrived = tweenRouteToNode(node)
				if not arrived or not spawnRouteState.running then
					clearTweenVisuals()
					break
				end

				local pStart = os.clock()
				while (os.clock() - pStart) < spawnRouteState.pauseTime do
					if not spawnRouteState.running then break end
					local rem = math.max(0, spawnRouteState.pauseTime - (os.clock() - pStart))
					if spawnRouteState.statusLabel then
						spawnRouteState.statusLabel.Text = string.format("At %s — Pausing (%.1fs)...", node.name, rem)
						spawnRouteState.statusLabel.TextColor3 = C_WARN
					end
					task.wait(0.1)
				end

				clearTweenVisuals()
			end

			if not spawnRouteState.running then
				break
			end

			if not spawnRouteState.loopRoute then
				stopSpawnRoute("Route complete! Visited all " .. #nodes .. " arrow spawns.")
				break
			end
		end
	end)
end

