task.spawn(function()
	while true do
		task.wait(1.5)
		for _, tab in ipairs(tabs) do
			if tab.isAutoCollect or tab.isMisc or tab.isSpawnRoute then continue end
			if tab.getContainer() ~= tab.state.lastContainer then
				tab.rebuild()
			end
		end
	end
end)

