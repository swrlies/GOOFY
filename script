		subLbl.TextColor3 = isAuto and C_OK or C_SUB
		subLbl.BackgroundTransparency = 1
		subLbl.Position = UDim2.fromOffset(12, 24)
		subLbl.Size = UDim2.new(1, -182, 0, 14)
		subLbl.TextXAlignment = Enum.TextXAlignment.Left
		subLbl.Parent = row

		local loadBtn = Instance.new("TextButton")
		loadBtn.Text = "Load"
		loadBtn.Font = Enum.Font.GothamBold
		loadBtn.TextSize = 11
		loadBtn.TextColor3 = C_TEXT
		loadBtn.BackgroundColor3 = C_ACCENT
		loadBtn.BorderSizePixel = 0
		loadBtn.Position = UDim2.new(1, -162, 0.5, -13)
		loadBtn.Size = UDim2.fromOffset(48, 26)
		loadBtn.Parent = row
		corner(loadBtn, 5)

		local autoBtn = Instance.new("TextButton")
		autoBtn.Text = isAuto and "Auto On" or "Set Auto"
		autoBtn.Font = Enum.Font.GothamBold
		autoBtn.TextSize = 10
		autoBtn.TextColor3 = C_TEXT
		autoBtn.BackgroundColor3 = isAuto and C_OK or C_PANEL
		autoBtn.BorderSizePixel = 0
		autoBtn.Position = UDim2.new(1, -108, 0.5, -13)
		autoBtn.Size = UDim2.fromOffset(60, 26)
		autoBtn.Parent = row
		corner(autoBtn, 5)
		if not isAuto then
			stroke(autoBtn, C_STROKE, 1, 0.4)
		end

		local delBtn = Instance.new("TextButton")
		delBtn.Text = "Del"
		delBtn.Font = Enum.Font.GothamBold
		delBtn.TextSize = 11
		delBtn.TextColor3 = C_ERR
		delBtn.BackgroundColor3 = C_PANEL
		delBtn.BorderSizePixel = 0
		delBtn.Position = UDim2.new(1, -42, 0.5, -13)
		delBtn.Size = UDim2.fromOffset(34, 26)
		delBtn.Parent = row
		corner(delBtn, 5)
		stroke(delBtn, C_STROKE, 1, 0.4)

		loadBtn.MouseButton1Click:Connect(function()
			local ok, err = loadNamedConfig(name)
			if ok then
				tab.nameBox.Text = name
