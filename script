;(function()
local BOSS_DURATION_SECONDS = 1200

local function refreshBossMonitorUI()
	if appMod.refreshBossMonitorUI then appMod.refreshBossMonitorUI() end
end

local function setBossFarmStatus(txt, color)
	local lbl = bossFarmUi.statusLbl or (bossMonitorState.tab and bossMonitorState.tab.status)
	if not lbl then return end
	if lbl.Text ~= txt then lbl.Text = txt end
	local col = color or C_SUB
	if lbl.TextColor3 ~= col then lbl.TextColor3 = col end
end

local function isGameNight()
	local ct = LightingService.ClockTime
	return ct >= 18 or ct < 6
end

local function formatClockTime(ct)
	local totalMins = math.floor((ct % 24) * 60)
	local hh = math.floor(totalMins / 60) % 24
	local mm = totalMins % 60
	return string.format("%02d:%02d", hh, mm)
end

local function formatCountdown(sec)
	sec = math.max(0, math.floor(sec + 0.5))
	local m = math.floor(sec / 60)
	local s = sec % 60
	return string.format("%02d:%02d", m, s)
end

local function classifyEventBoss(ev)
	if type(ev) ~= "table" then return nil end
	local idStr = tostring(ev.Id or "")
	local bossName = tostring(ev.BossName or "")
	if idStr == "DIO" or bossName == "DIO" then
		return "DIO"
	end
	if idStr == "StandBoss" or bossName == "Jotaro" then
		return "Jotaro"
	end
	return nil
end

local function classifyModelBoss(model)
	if not model or not model:IsA("Model") then return nil end
	if model:GetAttribute("BossNPC") ~= true then return nil end
	local cfg = tostring(model:GetAttribute("Config") or "")
	if cfg == "DIO" or model.Name:match("^DIO") then
		return "DIO"
	end
	if cfg == "Jotaro" or cfg == "StandBoss" or model.Name:match("^Jotaro") then
		return "Jotaro"
	end
	return nil
end

local function computeEventRemaining(ev)
	local dur = tonumber(ev.Duration) or BOSS_DURATION_SECONDS
	local elapsed = tonumber(ev.Elapsed) or 0
	local stamp = tonumber(ev.Stamp)
	local rem
	if stamp then
		local nowOk, srvNow = pcall(function() return workspace:GetServerTimeNow() end)
		if nowOk and type(srvNow) == "number" then
			rem = (dur - elapsed) - (srvNow - stamp)
		else
			rem = dur - elapsed
		end
	else
		rem = dur - elapsed
	end
	return math.max(0, rem)
end

local function isWorldEventEnded(ev)
	if type(ev) ~= "table" then return true end
	if ev.Removed == true or ev.Active == false then return true end
	local phase = tostring(ev.Phase or "")
	if phase == "Ended" or phase == "Complete" or phase == "Expired" then
		return true
	end
	if ev.Duration and ev.Elapsed and tonumber(ev.Elapsed) >= tonumber(ev.Duration) and phase ~= "Boss" then
		return true
	end
	return computeEventRemaining(ev) <= 0
end

local weRemoteRef = nil

local function requestWorldEventsSnapshot()
	task.spawn(function()
		local rem = weRemoteRef
		if not rem then
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			rem = remotes and remotes:FindFirstChild("WorldEvents")
			weRemoteRef = rem
		end
		if rem and rem:IsA("RemoteEvent") then
			pcall(function()
				rem.FireServer(rem, "Snapshot")
			end)
		end
	end)
end

local function gatherActiveBosses()
	local activeEvents = {}
	local eventByEventId = {}

	for key, ev in pairs(bossMonitorState.eventsById) do
		local bossKind = classifyEventBoss(ev)
		if not bossKind or isWorldEventEnded(ev) then
			bossMonitorState.eventsById[key] = nil
		else
			local wanted = (bossKind == "DIO" and bossMonitorState.monitorDIO)
				or (bossKind == "Jotaro" and bossMonitorState.monitorJotaro)
			if wanted then
				local rec = {
					key      = key,
					bossKind = bossKind,
					ev       = ev,
					eventId  = ev.EventId or key,
					site     = ev.Site,
					pos      = (typeof(ev.Position) == "Vector3") and ev.Position or nil,
					matched  = false,
				}
				table.insert(activeEvents, rec)
				if rec.eventId then
					eventByEventId[rec.eventId] = rec
				end
			end
		end
	end

	local results = {}
	local modelSeen = {}
	local gameFolder = workspace:FindFirstChild("Game")
	local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")

	if playersFolder then
		for _, m in ipairs(playersFolder:GetChildren()) do
			local bossKind = classifyModelBoss(m)
			if bossKind then
				local hum = m:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health > 0 then
					local wanted = (bossKind == "DIO" and bossMonitorState.monitorDIO)
						or (bossKind == "Jotaro" and bossMonitorState.monitorJotaro)
					if wanted then
						modelSeen[m] = true
						if not bossMonitorState.firstSeen[m] then
							bossMonitorState.firstSeen[m] = os.clock()
						end

						local weId = m:GetAttribute("WorldEventBoss")
						local evRec = weId and eventByEventId[weId] or nil
						if not evRec then
							for _, rec in ipairs(activeEvents) do
								if not rec.matched and rec.bossKind == bossKind then
									evRec = rec
									break
								end
							end
						end
						if evRec then evRec.matched = true end

						local part = getPart(m)
						local pos = (part and part.Position) or getItemPosition(m) or (evRec and evRec.pos)
						local remSec, isExact
						if evRec and evRec.ev then
							remSec = computeEventRemaining(evRec.ev)
							isExact = true
						else
							remSec = math.max(0, BOSS_DURATION_SECONDS - (os.clock() - bossMonitorState.firstSeen[m]))
							isExact = false
						end

						local lvl = m:GetAttribute("BossLevel")
						local stableId = weId and ("we:" .. tostring(weId)) or ("model:" .. tostring(m:GetDebugId()))
						table.insert(results, {
							id       = stableId,
							bossKind = bossKind,
							model    = m,
							part     = part,
							pos      = pos,
							site     = (evRec and evRec.site) or "Active in World",
							hp       = hum and hum.Health or nil,
							maxHp    = hum and hum.MaxHealth or nil,
							level    = lvl,
							remSec   = remSec,
							isExact  = isExact,
							phase    = evRec and evRec.ev and evRec.ev.Phase or "Boss",
						})
					end
				end
			end
		end
	end

	-- Cleanup stale firstSeen/highlights for vanished models
	for m in pairs(bossMonitorState.firstSeen) do
		if not modelSeen[m] then
			bossMonitorState.firstSeen[m] = nil
		end
	end
	for m in pairs(bossMonitorState.highlighted) do
		if not modelSeen[m] then
			clearHighlight(m)
			bossMonitorState.highlighted[m] = nil
		end
	end

	-- Include WorldEvents that haven't streamed in as models yet
	for _, rec in ipairs(activeEvents) do
		if not rec.matched then
			local remSec = computeEventRemaining(rec.ev)
			table.insert(results, {
				id       = "we:" .. tostring(rec.eventId or rec.key),
				bossKind = rec.bossKind,
				model    = nil,
				part     = nil,
				pos      = rec.pos,
				site     = rec.site or "Unknown",
				hp       = nil,
				maxHp    = nil,
				level    = nil,
				remSec   = remSec,
				isExact  = true,
				phase    = rec.ev.Phase or "Boss",
			})
		end
	end

	table.sort(results, function(a, b)
		if a.bossKind ~= b.bossKind then return a.bossKind < b.bossKind end
		return a.remSec < b.remSec
	end)

	-- Auto-highlight active bosses
	for _, item in ipairs(results) do
		if item.model and item.part and bossMonitorState.autoHighlight then
			if not highlights[item.model] then
				applyHighlight(item.model, item.part)
				bossMonitorState.highlighted[item.model] = true
			end
		end
	end

	return results
end

