local function isValidItem(item, tabName)
	if tabName ~= "Items" then return true end

	local name = getDisplayName(item, tabName)
	if name == "Mysterious Arrow" then
		local gameFolder = workspace:FindFirstChild("Game")
		local nodesFolder = gameFolder and gameFolder:FindFirstChild("ItemSpawnNodes")
		local arrowsFolder = nodesFolder and nodesFolder:FindFirstChild("Arrows")

		if not arrowsFolder then return true end

		local part = getPart(item)
		if not part then return false end
		local pos = part.Position

		for _, node in ipairs(arrowsFolder:GetChildren()) do
			if node.Name:match("^Arrow0%d$") then
				local nodePos = node:IsA("BasePart") and node.Position or node:GetPivot().Position
				if (nodePos - pos).Magnitude <= 10 then
					return true
				end
			end
		end
		return false
	end
	return true
end

local function collectEntries(container, tabName)
	local entries = {}
	if not container then return entries end

	if tabName == "Supplies" then
		for _, child in container:GetChildren() do
			if child.Name:match("^BuriedSupplies") then
				table.insert(entries, child)
			end
		end
		return entries
	end

	local function walk(node)
		for _, child in node:GetChildren() do
			if child:IsA("BasePart") or child:IsA("Model") then
				table.insert(entries, child)
			elseif child:IsA("Folder") then
				walk(child)
			end
		end
	end
	walk(container)
	return entries
end

