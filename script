	button.Size = UDim2.new(1, 0, 0, 30)
	button.Position = UDim2.new(0, 0, 0, 18)
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Parent = container
	corner(button, 6)
	stroke(button, C_STROKE, 1, 0.35)
	local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 8); sp.Parent = button

	local arrow = Instance.new("TextLabel")
	arrow.Text = "▼"
	arrow.Font = Enum.Font.GothamBold
	arrow.TextSize = 10
	arrow.TextColor3 = C_SUB
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromOffset(20, 30)
	arrow.Position = UDim2.new(1, -25, 0, 0)
	arrow.Parent = button

	local rowStep = 26
	local listH = math.min(#options * rowStep + 6, 136)
	local optionsFrame = Instance.new("Frame")
	optionsFrame.Name = "DropdownOptions"
	optionsFrame.Size = UDim2.new(1, 0, 0, listH)
	optionsFrame.Position = UDim2.new(0, 0, 0, 50)
	optionsFrame.BackgroundColor3 = C_PANEL
	optionsFrame.BorderSizePixel = 0
	optionsFrame.Visible = false
	optionsFrame.ZIndex = 20
	optionsFrame.Parent = container
	corner(optionsFrame, 6)
