							local dist = math.floor((lhrp.Position - char.HumanoidRootPart.Position).Magnitude)
							data.txtDist.Text = "[" .. dist .. " studs]"
						else
							data.txtDist.Text = ""
						end
					end
				end
			end
		end
	end
end)

--=====================================================================
-- Fly (Zero-Gravity Hover Fix)
--=====================================================================
local flyEnabled = false
local flySpeed = 50
local flyBodyVel = nil

local function cleanupFlyForce()
	if flyBodyVel then
		flyBodyVel:Destroy()
		flyBodyVel = nil
	end
end

local function ensureFlyForce(hrp)
	if not flyBodyVel or flyBodyVel.Parent ~= hrp then
		cleanupFlyForce()
		local bv = Instance.new("BodyVelocity")
		bv.Name = "SIM_FlyHover"
		bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp
		flyBodyVel = bv
	end
	flyBodyVel.Velocity = Vector3.zero
end

local function toggleFly(state)
	flyEnabled = state
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not state then
		cleanupFlyForce()
		if hum then hum.PlatformStand = false end
	else
		if hrp then ensureFlyForce(hrp) end
		Camera.CameraType = Enum.CameraType.Custom
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	cleanupFlyForce()
	if flyEnabled then
		task.wait(0.3)
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hum then hum.PlatformStand = true end
		if hrp and flyEnabled then ensureFlyForce(hrp) end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not flyEnabled then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	hum.PlatformStand = true
	ensureFlyForce(hrp)
	Camera.CameraType = Enum.CameraType.Custom

	local cam = workspace.CurrentCamera
	local moveDir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	if moveDir.Magnitude > 0 then
		hrp.CFrame = hrp.CFrame + (moveDir.Unit * flySpeed * dt)
	end
end)

--=====================================================================
-- Noclip (Fixed for multi-wall collisions without breaking pickups)
--=====================================================================
local noclipEnabled = false
local routeNoclipActive = false
local origCollide = {}

local function isAnyNoclipActive()
	return noclipEnabled or routeNoclipActive
end

local function setCharCollide(char, disableCollide)
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, not disableCollide)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not disableCollide)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not disableCollide)
	end

	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			if disableCollide then
				if origCollide[p] == nil then
					origCollide[p] = p.CanCollide
				end
				p.CanCollide = false
			else
				if origCollide[p] ~= nil then
					p.CanCollide = origCollide[p]
				else
					p.CanCollide = true
				end
			end
		end
	end
	if not disableCollide then
		table.clear(origCollide)
	end
end

local function toggleNoclip(state)
	noclipEnabled = state
	if not isAnyNoclipActive() then
		setCharCollide(LocalPlayer.Character, false)
	end
end

local function setRouteNoclip(state)
	routeNoclipActive = state
	if not isAnyNoclipActive() then
		setCharCollide(LocalPlayer.Character, false)
	end
end

RunService.Stepped:Connect(function()
	if not isAnyNoclipActive() then return end
	setCharCollide(LocalPlayer.Character, true)
end)

