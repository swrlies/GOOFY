--=====================================================================
-- Scrap Barges Radar
--=====================================================================
local scrapBeaconFolder = Instance.new("Folder")
scrapBeaconFolder.Name = "SIM_ScrapBeacons"
scrapBeaconFolder.Parent = workspace

local function updateScrapBeacons()
	local gameFolder = workspace:FindFirstChild("Game")
	local mapFolder  = gameFolder and gameFolder:FindFirstChild("Map")
	if not mapFolder then
		for _, b in ipairs(scrapBeaconFolder:GetChildren()) do b:Destroy() end
		return
	end

	local pieces = {}
	for _, obj in ipairs(mapFolder:GetDescendants()) do
		if obj.Name == "DebrisPiece" then
			local pos = obj:IsA("Model") and obj:GetPivot().Position or (obj:IsA("BasePart") and obj.Position)
			if pos then
				table.insert(pieces, {object = obj, position = pos})
			end
		end
	end

	local groups = {}
	for _, piece in ipairs(pieces) do
		local found = false
		for _, g in ipairs(groups) do
			if (g.position - piece.position).Magnitude <= 15 then
				found = true
				break
			end
		end
		if not found then
			table.insert(groups, piece)
		end
	end

	local existing = {}
	for _, b in ipairs(scrapBeaconFolder:GetChildren()) do
		existing[b] = true
	end

	for i, g in ipairs(groups) do
		local name = "Scrap Barge " .. i
		local beacon = scrapBeaconFolder:FindFirstChild(name)
		if not beacon then
			beacon = Instance.new("Part")
			beacon.Name = name
			beacon.Anchored = true
			beacon.CanCollide = false
			beacon.Transparency = 1
			beacon.Size = Vector3.new(1,1,1)
			beacon.Parent = scrapBeaconFolder
		end
		beacon.Position = g.position
		existing[beacon] = nil
	end

	for b in pairs(existing) do
		b:Destroy()
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		updateScrapBeacons()
	end
end)

