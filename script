			timerLbl.BackgroundTransparency = 1
			timerLbl.Position = UDim2.fromOffset(10, 21)
			timerLbl.Size = UDim2.new(1, -118, 0, 14)
			timerLbl.TextXAlignment = Enum.TextXAlignment.Left
			timerLbl.Parent = row

			local infoLbl = Instance.new("TextLabel")
			infoLbl.Font = Enum.Font.Gotham
			infoLbl.TextSize = 11
			infoLbl.TextColor3 = C_SUB
			infoLbl.BackgroundTransparency = 1
			infoLbl.Position = UDim2.fromOffset(10, 36)
			infoLbl.Size = UDim2.new(1, -118, 0, 14)
			infoLbl.TextXAlignment = Enum.TextXAlignment.Left
			infoLbl.TextTruncate = Enum.TextTruncate.AtEnd
			infoLbl.Parent = row

			local tpBtn = Instance.new("TextButton")
			tpBtn.Text = "TP"
			tpBtn.Font = Enum.Font.GothamBold
			tpBtn.TextSize = 11
			tpBtn.TextColor3 = C_TEXT
			tpBtn.BackgroundColor3 = C_ACCENT
			tpBtn.BorderSizePixel = 0
			tpBtn.Position = UDim2.new(1, -98, 0.5, -13)
			tpBtn.Size = UDim2.fromOffset(48, 26)
			tpBtn.Parent = row
			corner(tpBtn, 5)

			local hlBtn = Instance.new("TextButton")
			hlBtn.Text = "HL"
			hlBtn.Font = Enum.Font.GothamBold
			hlBtn.TextSize = 11
			hlBtn.TextColor3 = C_TEXT
			hlBtn.BackgroundColor3 = C_PANEL
			hlBtn.BorderSizePixel = 0
			hlBtn.Position = UDim2.new(1, -44, 0.5, -13)
			hlBtn.Size = UDim2.fromOffset(36, 26)
			hlBtn.Parent = row
			corner(hlBtn, 5)

			local rowData = {
				frame = row,
				title = titleLbl,
				timer = timerLbl,
				info  = infoLbl,
				tp    = tpBtn,
				hl    = hlBtn,
				item  = item,
			}
			bossMonitorState.rows[item.id] = rowData

			tpBtn.MouseButton1Click:Connect(function()
				local cur = rowData.item
				local targetPos = cur.pos or (cur.model and getItemPosition(cur.model))
				if targetPos then
					local ok, err = teleportToCFrame(CFrame.new(targetPos + Vector3.new(0, 5, 0)), false)
					if ok then
						tab.status.Text = "Teleported to " .. cur.bossKind .. " (" .. tostring(cur.site) .. ")"
						tab.status.TextColor3 = C_OK
					else
						tab.status.Text = err or "Teleport failed."
						tab.status.TextColor3 = C_ERR
					end
				else
					tab.status.Text = "Boss position unavailable."
					tab.status.TextColor3 = C_ERR
				end
			end)

			hlBtn.MouseButton1Click:Connect(function()
				local cur = rowData.item
				if not cur.model or not cur.part or not cur.model:IsDescendantOf(workspace) then
					tab.status.Text = "Move closer (or TP) so boss streams in to highlight."
					tab.status.TextColor3 = C_WARN
					return
				end
				if highlights[cur.model] then
					clearHighlight(cur.model)
					bossMonitorState.highlighted[cur.model] = nil
				else
					applyHighlight(cur.model, cur.part)
					bossMonitorState.highlighted[cur.model] = true
				end
				hlBtn.BackgroundColor3 = highlights[cur.model] and C_OK or C_PANEL
			end)
		end
	end

	-- Update row text/state in place cleanly with no flicker
	local pChar = LocalPlayer.Character
	local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
	local pPos = pRoot and pRoot.Position or nil

	for _, item in ipairs(bosses) do
		local rowData = bossMonitorState.rows[item.id]
		if rowData then
			rowData.item = item
			local lvlTag = item.level and (" [Lvl " .. tostring(item.level) .. "]") or ""
			local siteTag = (item.site and item.site ~= "") and (" — " .. tostring(item.site)) or ""
			rowData.title.Text = item.bossKind .. lvlTag .. siteTag

			local prefix = item.isExact and "Despawns in: " or "Despawns in: ~"
			rowData.timer.Text = prefix .. formatCountdown(item.remSec)
			rowData.timer.TextColor3 = (item.remSec <= 180) and C_WARN or C_OK

			local hpStr = (item.hp and item.maxHp) and string.format("HP: %d/%d", math.floor(item.hp + 0.5), math.floor(item.maxHp + 0.5)) or "HP: Streamed out"
			local distStr = (pPos and item.pos) and string.format("%d studs", math.round((item.pos - pPos).Magnitude)) or "Dist: ?"
			rowData.info.Text = hpStr .. "  •  " .. distStr

			rowData.hl.BackgroundColor3 = (item.model and highlights[item.model]) and C_OK or C_PANEL
		end
	end

	tab.empty.Visible = (#bosses == 0)
	if #bosses == 0 then
		if not bossMonitorState.monitorDIO and not bossMonitorState.monitorJotaro then
			tab.empty.Text = "Enable DIO or Jotaro above to monitor bosses."
		elseif not night and bossMonitorState.monitorDIO and not bossMonitorState.monitorJotaro then
			tab.empty.Text = "No DIO spawned (DIO only spawns at night)."
		else
			tab.empty.Text = "No monitored bosses currently spawned."
		end
	end
end

local function releaseBossCharacterLock()
	if appMod.combat and appMod.combat.releaseLock then
		appMod.combat.releaseLock(bossFarmState)
	end
end

local function pickActiveBossTarget()
	local bosses = gatherActiveBosses()
	if #bosses == 0 then return nil end
	for _, b in ipairs(bosses) do
		if b.model and appMod.combat and appMod.combat.isModelAlive(b.model) then
			return b
		end
	end
	return bosses[1]
end

local function hasBossFarmWork()
	if not bossFarmState.running then return false end
	if not bossMonitorState.monitorDIO and not bossMonitorState.monitorJotaro then
		return false
	end
	for _, ev in pairs(bossMonitorState.eventsById) do
		local bossKind = classifyEventBoss(ev)
		if bossKind and not isWorldEventEnded(ev) then
			if (bossKind == "DIO" and bossMonitorState.monitorDIO)
				or (bossKind == "Jotaro" and bossMonitorState.monitorJotaro) then
				return true
			end
		end
	end
	local gameFolder = workspace:FindFirstChild("Game")
	local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
	if playersFolder then
		for _, m in ipairs(playersFolder:GetChildren()) do
			local bossKind = classifyModelBoss(m)
			if bossKind and ((bossKind == "DIO" and bossMonitorState.monitorDIO)
				or (bossKind == "Jotaro" and bossMonitorState.monitorJotaro)) then
				local hum = m:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health > 0 then
					return true
				end
			end
		end
	end
	return false
end

local function setBossFarmRunning(shouldRun)
	shouldRun = (shouldRun == true)
	if shouldRun == bossFarmState.running then return end
	bossFarmState.running = shouldRun

	if bossFarmUi.startBtn then
		bossFarmUi.startBtn.Text = shouldRun and "Stop Boss Farm" or "Start Boss Farm"
		bossFarmUi.startBtn.BackgroundColor3 = shouldRun and C_ERR or C_ACCENT
	end

	if shouldRun then
		setBossFarmStatus("Status: Monitoring for spawned bosses...", C_OK)
		requestWorldEventsSnapshot()
	else
		bossFarmState.activeBossId = nil
		releaseBossCharacterLock()
		setBossFarmStatus("Status: Stopped | Clears: " .. tostring(bossFarmState.completedCount), C_SUB)
	end

	if appMod.getActiveFarmOwner then appMod.getActiveFarmOwner(true) end
	if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
	if activeTab and activeTab.isAutoFarm then updateCountLabel() end
end

