	if not tab or not tab.scroll then return end

	for _, child in ipairs(tab.scroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	local autoName = getAutoLoadName()
	if autoName then
		tab.autoBadge.Text = "AUTO-LOAD"
		tab.autoBadge.BackgroundColor3 = C_OK
		tab.autoLbl.Text = autoName
		tab.autoLbl.TextColor3 = C_TEXT
	else
		tab.autoBadge.Text = "MANUAL"
		tab.autoBadge.BackgroundColor3 = C_ROW_HOT
		tab.autoLbl.Text = "No auto-load profile selected"
		tab.autoLbl.TextColor3 = C_SUB
	end

	local names = listSavedConfigNames()
	tab.state.shownCount = #names
	if tab == activeTab then updateCountLabel() end
