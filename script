local function moveToCFrame(endCF, visualItem, visualPos, keepAnchoredOnArrive, onComplete)
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if onComplete then onComplete(false) end
		return false
	end

	local startCF  = hrp.CFrame
	local dist     = (startCF.Position - endCF.Position).Magnitude
	local duration = math.max(0.05, dist / math.max(1, autoCollectState.tweenSpeed))

	if visualPos then
		createTweenVisuals(hrp, visualItem, visualPos)
	end

	hrp.Anchored = true
	local cancelled = false
	autoCollectState.cancelMove = function() cancelled = true end

	local t0 = os.clock()
	while os.clock() - t0 < duration do
		if cancelled or not autoCollectState.running then
			cancelled = true
			break
		end
		local alpha = math.clamp((os.clock() - t0) / duration, 0, 1)
		if hrp and hrp.Parent then
			hrp.CFrame = startCF:Lerp(endCF, alpha)
		end
		if visualItem and tweenVisuals.targetNode then
			local updatedPos = getItemPosition(visualItem)
			if updatedPos then
				tweenVisuals.targetNode.Position = updatedPos
			end
		end
		task.wait()
	end

	autoCollectState.cancelMove = nil
	clearTweenVisuals()

	if hrp and hrp.Parent then
		if not cancelled and autoCollectState.running then
			hrp.CFrame = endCF
		end
		hrp.Anchored = (keepAnchoredOnArrive == true and not cancelled and autoCollectState.running)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	if onComplete then onComplete(not cancelled) end
	return not cancelled
end

local function moveToItem(item, onComplete)
	local targetPos = getItemPosition(item)
	if not targetPos then
		if onComplete then onComplete(false) end
		return false
	end
	local endCF = CFrame.new(targetPos + Vector3.new(0, 3, 0))
	return moveToCFrame(endCF, item, targetPos, false, onComplete)
end

--=====================================================================
-- Priority cache + interruptible wait
--=====================================================================
local priorityCache = {
	prio = math.huge,
	item = nil,
	catName = nil,
	lastUpdate = 0,
}

local function getPriorityCache()
	local now = os.clock()
	if now - priorityCache.lastUpdate < 0.1 then
		return priorityCache
	end
	priorityCache.lastUpdate = now

	local bestPrio, bestItem, bestCat = math.huge, nil, nil
	for targetName in pairs(autoCollectState.targets) do
		if targetName ~= "Scrap Barges" then
			local prio = CATEGORY_PRIORITY[targetName] or 2
			if prio < bestPrio then
				local items = getItemsForCategory(targetName)
				for _, item in ipairs(items) do
					if not autoCollectState.collected[item] and item:IsDescendantOf(workspace) then
						bestPrio = prio
						bestItem = item
						bestCat  = targetName
						break
					end
				end
			end
		end
	end

	priorityCache.prio    = bestPrio
	priorityCache.item    = bestItem
	priorityCache.catName = bestCat
	return priorityCache
end

local function shouldPreempt(currentPriority, currentItem)
	if appMod.isFarmOwner and not appMod.isFarmOwner("AutoCollect") then
		return true, nil, "Priority"
	end
	local cache = getPriorityCache()
	if cache.prio < currentPriority and cache.item ~= currentItem then
		return true, cache.item, cache.catName
	end
	return false
end

local function interruptibleWait(duration, currentPriority, currentItem)
	local t0 = os.clock()
	while os.clock() - t0 < duration do
		if not autoCollectState.running then return false, "stopped" end
		if currentItem and not currentItem:IsDescendantOf(workspace) then return false, "gone" end
		if shouldPreempt(currentPriority, currentItem) then return false, "preempt" end
		task.wait(0.05)
	end
	return true, "done"
end

