--=====================================================================
-- Configs System & Auto-Load Persistence
--=====================================================================
;(function()
local CONFIG_DIR = "StandOutConfigs"
local AUTOLOAD_PATH = CONFIG_DIR .. "/_autoload.txt"
local configTabRef = nil

local function hasConfigFileApi()
	return typeof(isfolder) == "function"
		and typeof(makefolder) == "function"
		and typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(isfile) == "function"
		and typeof(listfiles) == "function"
		and typeof(delfile) == "function"
end

local function ensureConfigDir()
	if not hasConfigFileApi() then return false end
	local okExists, exists = pcall(isfolder, CONFIG_DIR)
	if okExists and not exists then
		pcall(makefolder, CONFIG_DIR)
	end
	local ok2, exists2 = pcall(isfolder, CONFIG_DIR)
	return ok2 and exists2 == true
end

local function sanitizeConfigName(name)
	local s = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	s = s:gsub("[^%w%-%s_]", ""):gsub("%s+$", ""):gsub("^%s+", "")
	if s == "" or s:sub(1, 1) == "_" then
		return nil
	end
	return s
end

local function getConfigPath(name)
	return CONFIG_DIR .. "/" .. name .. ".json"
end

local function getAutoLoadName()
	if not hasConfigFileApi() then return nil end
	local okFile, exists = pcall(isfile, AUTOLOAD_PATH)
	if not (okFile and exists) then return nil end
	local okRead, raw = pcall(readfile, AUTOLOAD_PATH)
	if not okRead then return nil end
	local clean = sanitizeConfigName(raw)
	if not clean then return nil end
	local okCfg, cfgExists = pcall(isfile, getConfigPath(clean))
	if not (okCfg and cfgExists) then return nil end
	return clean
end

local function setAutoLoadName(name)
	if not ensureConfigDir() then return false end
	if name == nil or name == "" then
		local okEx, ex = pcall(isfile, AUTOLOAD_PATH)
		if okEx and ex then pcall(delfile, AUTOLOAD_PATH) end
		return true
	end
	local clean = sanitizeConfigName(name)
	if not clean then return false end
	return pcall(writefile, AUTOLOAD_PATH, clean)
end

local function listSavedConfigNames()
	if not ensureConfigDir() then return {} end
	local okList, files = pcall(listfiles, CONFIG_DIR)
	if not okList or type(files) ~= "table" then return {} end
	local names = {}
	for _, full in ipairs(files) do
		local base = tostring(full):match("([^/\\]+)%.json$")
		if base and base:sub(1, 1) ~= "_" then
			table.insert(names, base)
		end
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	return names
end

local function serializeCurrentConfig()
	return {
		version = 1,
		autoCollect = {
			targets    = configControls.targets and configControls.targets.getValue() or {},
			mode       = configControls.mode and configControls.mode.getValue() or autoCollectState.mode,
			tweenSpeed = configControls.tweenSpeed and configControls.tweenSpeed.getValue() or autoCollectState.tweenSpeed,
			delayTime  = configControls.delayTime and configControls.delayTime.getValue() or autoCollectState.delayTime,
			running    = autoCollectState.running == true,
			ecoMode     = configControls.ecoMode and configControls.ecoMode.getState() or ecoState.enabled,
			ecoKey      = configControls.ecoMode and configControls.ecoMode.getKeybind and configControls.ecoMode.getKeybind() or nil,
			no3dRender  = configControls.no3dRender and configControls.no3dRender.getState() or ecoState.no3d,
			no3dKey     = configControls.no3dRender and configControls.no3dRender.getKeybind and configControls.no3dRender.getKeybind() or nil,
			autoPlay    = configControls.autoPlay and configControls.autoPlay.getState() or autoCollectState.autoPlay == true,
			autoPlayKey = configControls.autoPlay and configControls.autoPlay.getKeybind and configControls.autoPlay.getKeybind() or nil,
		},
		perf = {
			ecoMode          = configControls.ecoMode and configControls.ecoMode.getState() or ecoState.enabled,
			no3dRender       = configControls.no3dRender and configControls.no3dRender.getState() or ecoState.no3d,
			autoPlay         = configControls.autoPlay and configControls.autoPlay.getState() or autoCollectState.autoPlay == true,
			hideWhileWaiting = configControls.hideWhileWaiting and configControls.hideWhileWaiting.getState() or (appMod.isHideWhileWaitingEnabled and appMod.isHideWhileWaitingEnabled() == true),
			autoCloak        = configControls.autoCloak and configControls.autoCloak.getState() or (appMod.isAutoCloakEnabled and appMod.isAutoCloakEnabled() == true),
		},
		misc = {
			esp         = configControls.esp and configControls.esp.getState() or false,
			espKey      = configControls.esp and configControls.esp.getKeybind() or nil,
			espDistance = configControls.espDistance and configControls.espDistance.getState() or false,
			espDistKey  = configControls.espDistance and configControls.espDistance.getKeybind() or nil,
			fly         = configControls.fly and configControls.fly.getState() or false,
			flyKey      = configControls.fly and configControls.fly.getKeybind() or nil,
			flySpeed    = configControls.flySpeed and configControls.flySpeed.getValue() or flySpeed,
			noclip      = configControls.noclip and configControls.noclip.getState() or false,
			noclipKey   = configControls.noclip and configControls.noclip.getKeybind() or nil,
			walkspeed   = configControls.walkspeed and configControls.walkspeed.getState() or false,
			wsKey       = configControls.walkspeed and configControls.walkspeed.getKeybind() or nil,
			wsSpeed     = configControls.wsSpeed and configControls.wsSpeed.getValue() or wsSpeed,
		},
		bosses       = appMod.serializeBossConfig and appMod.serializeBossConfig() or nil,
		eliminations = appMod.serializeElimConfig and appMod.serializeElimConfig() or nil,
		priority     = appMod.farmPriority and { order = table.clone(appMod.farmPriority.order) } or nil,
	}
end

local function applyConfigTable(cfg)
	if type(cfg) ~= "table" then return false end

	if type(cfg.priority) == "table" and type(cfg.priority.order) == "table" and appMod.setFarmOrder then
		appMod.setFarmOrder(cfg.priority.order)
	end

	if type(cfg.misc) == "table" then
		local m = cfg.misc
		if configControls.flySpeed and m.flySpeed ~= nil then configControls.flySpeed.setValue(m.flySpeed) end
		if configControls.wsSpeed and m.wsSpeed ~= nil then configControls.wsSpeed.setValue(m.wsSpeed) end
		if configControls.esp and m.esp ~= nil then configControls.esp.setState(m.esp) end
		if configControls.esp and m.espKey ~= nil then configControls.esp.setKeybind(m.espKey) end
		if configControls.espDistance and m.espDistance ~= nil then configControls.espDistance.setState(m.espDistance) end
		if configControls.espDistance and m.espDistKey ~= nil then configControls.espDistance.setKeybind(m.espDistKey) end
		if configControls.fly and m.fly ~= nil then configControls.fly.setState(m.fly) end
		if configControls.fly and m.flyKey ~= nil then configControls.fly.setKeybind(m.flyKey) end
		if configControls.noclip and m.noclip ~= nil then configControls.noclip.setState(m.noclip) end
		if configControls.noclip and m.noclipKey ~= nil then configControls.noclip.setKeybind(m.noclipKey) end
		if configControls.walkspeed and m.walkspeed ~= nil then configControls.walkspeed.setState(m.walkspeed) end
		if configControls.walkspeed and m.wsKey ~= nil then configControls.walkspeed.setKeybind(m.wsKey) end
	end

	if type(cfg.bosses) == "table" and appMod.applyBossConfig then
		appMod.applyBossConfig(cfg.bosses)
	end

	if type(cfg.eliminations) == "table" and appMod.applyElimConfig then
		appMod.applyElimConfig(cfg.eliminations)
	end

	local perfCfg = type(cfg.perf) == "table" and cfg.perf or cfg.autoCollect
	if type(perfCfg) == "table" then
		if configControls.ecoMode then
			configControls.ecoMode.setState(perfCfg.ecoMode == true)
			if configControls.ecoMode.setKeybind and perfCfg.ecoKey ~= nil then configControls.ecoMode.setKeybind(perfCfg.ecoKey) end
		elseif appMod.toggleEcoMode then
			appMod.toggleEcoMode(perfCfg.ecoMode == true)
		end
		if configControls.no3dRender then
			configControls.no3dRender.setState(perfCfg.no3dRender == true)
			if configControls.no3dRender.setKeybind and perfCfg.no3dKey ~= nil then configControls.no3dRender.setKeybind(perfCfg.no3dKey) end
		elseif appMod.toggleNo3DRender then
			appMod.toggleNo3DRender(perfCfg.no3dRender == true)
		end
		if configControls.autoPlay and perfCfg.autoPlay ~= nil then
			configControls.autoPlay.setState(perfCfg.autoPlay == true)
			if configControls.autoPlay.setKeybind and perfCfg.autoPlayKey ~= nil then configControls.autoPlay.setKeybind(perfCfg.autoPlayKey) end
		end
		if configControls.hideWhileWaiting and perfCfg.hideWhileWaiting ~= nil then
			configControls.hideWhileWaiting.setState(perfCfg.hideWhileWaiting == true)
		elseif appMod.setHideWhileWaiting and perfCfg.hideWhileWaiting ~= nil then
			appMod.setHideWhileWaiting(perfCfg.hideWhileWaiting == true)
		end
		if configControls.autoCloak and perfCfg.autoCloak ~= nil then
			configControls.autoCloak.setState(perfCfg.autoCloak == true)
		elseif appMod.setAutoCloak and perfCfg.autoCloak ~= nil then
			appMod.setAutoCloak(perfCfg.autoCloak == true)
		end
	end

	if type(cfg.autoCollect) == "table" then
		local ac = cfg.autoCollect
		if configControls.targets and type(ac.targets) == "table" then
			configControls.targets.setValue(ac.targets, true)
		end
		if configControls.mode and type(ac.mode) == "string" then
			configControls.mode.setValue(ac.mode, true)
		end
		if configControls.tweenSpeed and ac.tweenSpeed ~= nil then
			configControls.tweenSpeed.setValue(ac.tweenSpeed)
		end
		if configControls.delayTime and ac.delayTime ~= nil then
			configControls.delayTime.setValue(ac.delayTime)
		end
	end

	local wantAuto = type(cfg.autoCollect) == "table" and cfg.autoCollect.running == true
	if autoCollectState.setRunning then
		autoCollectState.setRunning(wantAuto)
	end

	return true
end

local function loadNamedConfig(name)
	if not hasConfigFileApi() then return false, "File API unavailable" end
	local clean = sanitizeConfigName(name)
	if not clean then return false, "Invalid config name" end
	local path = getConfigPath(clean)
	local okEx, ex = pcall(isfile, path)
	if not (okEx and ex) then return false, "Config file missing" end
	local okRead, raw = pcall(readfile, path)
	if not okRead or type(raw) ~= "string" then return false, "Failed to read config" end
	local okDec, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
	if not okDec or type(decoded) ~= "table" then return false, "Corrupt config JSON" end
	applyConfigTable(decoded)
	return true
end

local function refreshConfigList()
