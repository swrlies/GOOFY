local function buildDynamicLightPayload(char, token, standObj, iter)
	local standName = getEquippedStandName()
	local data = LocalPlayer:FindFirstChild("Data")
	local wov = data and data:FindFirstChild("WeaponOverride")
	local wv  = data and data:FindFirstChild("Weapon")
	local weaponName = (wov and wov.Value ~= "" and wov.Value) or (wv and wv.Value ~= "" and wv.Value) or "Fists"

	local Weapons, Stands, Utility = getCombatModules()
	local okW = Weapons ~= nil
	local okS = Stands ~= nil
	local okU = Utility ~= nil

	local sDef = (okS and type(Stands) == "table" and standName ~= "" and Stands.GetDefinition)
		and Stands:GetDefinition(char, standName) or nil
	local combatName = (okW and type(Weapons) == "table" and sDef and Weapons.GetStandCombatName)
		and Weapons:GetStandCombatName(standName, sDef) or weaponName
	local animName = (okW and type(Weapons) == "table" and sDef and Weapons.GetStandAnimationName)
		and Weapons:GetStandAnimationName(standName, sDef) or combatName

	local useStand = (standName ~= "" and char:GetAttribute("Summoned") == true and sDef ~= nil and not sDef.NoStandM1)

	local profile = useStand and combatName or weaponName
	local pInfo = (okW and type(Weapons) == "table" and type(Weapons.weaponInfo) == "table")
		and (Weapons.weaponInfo[profile] or Weapons.weaponInfo.Fists) or nil

	local comboLen = (pInfo and type(pInfo.SwingActiveTimes) == "table" and #pInfo.SwingActiveTimes) or 4
	if comboLen < 1 then comboLen = 4 end
	-- Loop non-finisher swings continuously to avoid 1.0s M1Cooldown finisher lockout & knockback
	local loopLen = (comboLen > 1) and (comboLen - 1) or 1
	local safeIter = ((iter - 1) % loopLen) + 1
	if pInfo and ((pInfo.LightExtraHits and pInfo.LightExtraHits[safeIter])
		or (pInfo.SpecialSwings and pInfo.SpecialSwings[1] == safeIter)) then
		safeIter = 1
	end

	local mult = 1
	if okU and type(Utility) == "table" and type(Utility.getAttackTimeMultiplier) == "function" then
		local okM, m = pcall(Utility.getAttackTimeMultiplier, Utility, char, nil, nil, {
			BasicAttack = "Light",
			BasicAttackProfile = profile,
		})
		if okM and type(m) == "number" and m > 0 then mult = m end
	end

	local activeTimes = pInfo and pInfo.SwingActiveTimes and pInfo.SwingActiveTimes[safeIter]
	local at1  = ((activeTimes and activeTimes[1]) or 0.14) * mult
	local len1 = ((activeTimes and activeTimes[2]) or 0.14) * mult
	local tail = ((activeTimes and activeTimes[3]) or 0.12) * mult
	local speed1 = (pInfo and pInfo.LightAnimationSpeed and pInfo.LightAnimationSpeed[safeIter]) or 1
	local size1 = (pInfo and pInfo.M1Hitbox and pInfo.M1Hitbox[safeIter]) or Vector3.new(6, 5.5, 6.5)
	local offset1 = (pInfo and pInfo.M1HitboxOffsets and pInfo.M1HitboxOffsets[safeIter]) or CFrame.new(0, 0, -size1.Z / 2)

	if useStand and okW and type(Weapons) == "table" and type(Weapons.StandHitbox) == "function" then
		local okSH, adjSize, adjOff = pcall(Weapons.StandHitbox, Weapons, size1, offset1, false, sDef and sDef.StandM1MinBack)
		if okSH and typeof(adjSize) == "Vector3" and typeof(adjOff) == "CFrame" then
			size1 = adjSize
			offset1 = adjOff
		end
	end

	local animObj
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local anims = assets and assets:FindFirstChild("Animations")
	if anims then
		local folder = anims:FindFirstChild(animName) or anims:FindFirstChild(profile) or anims:FindFirstChild("Fists")
		local lightFolder = folder and (folder:FindFirstChild("Light") or folder:FindFirstChild("M1"))
		animObj = lightFolder and lightFolder:FindFirstChild(tostring(safeIter))
	end
	local actorModel = useStand and (standObj or getStandActorModel()) or char
	local isFinisher = (comboLen == 1)
	local lightHitEvents = pInfo and pInfo.LightHitEvents and pInfo.LightHitEvents[safeIter]

	local animLen = math.max(0.28, at1 + len1 + 0.04)
	local animTbl
	if animObj and actorModel then
		animTbl = {
			Actor = actorModel,
			Id = animObj.AnimationId,
			Speed = speed1 / mult,
		}
	end

	local nextIter = (safeIter % loopLen) + 1
	local swingStepDelay = math.max(0.24, at1 + math.max(0.06, len1 * 0.45))
	return {
		Heavy = false,
		Size = size1,
		Offset = offset1,
		Profile = profile,
		ActorStand = useStand,
		Iteration = safeIter,
		Windup = lightHitEvents ~= nil,
		BlockedLag = pInfo and pInfo.BlockedEndlag or nil,
		FreeAfter = swingStepDelay,
		Anim = animTbl,
		Contacts = {
			{
				At = at1,
				Length = len1,
				SwingAtStart = not lightHitEvents,
				Swing = { HeavyHit = false, Iteration = safeIter, Length = animLen, Finisher = isFinisher },
				Hit = {
					Uptilt = false,
					SwingIteration = safeIter,
					HeavyIteration = 1,
					HeavyHit = isFinisher,
					AirBody = false,
					AirStand = false,
				},
			},
		},
		Token = token,
	}, nextIter, swingStepDelay
end

local function fireLightSwing(targetModel, stateObj)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hrp then return nil end

	local st = stateObj or elimState
	local ctrl, u69 = getPlayerController()
	local remote = getMeleeRemote(u69)
	if remote then
		resetStuckCombatStates(ctrl, u69)
		local _, standObj = ensureStandReadyForBarge(char, hrp)
		local isJob = (remote.Name == "Remote") or (workspace:GetAttribute("ServerMelee") == true)
		local nextToken = ((u69 and rawget(u69, "serverMeleeToken")) or _G.StandOut_LastToken or 0) + 1
		_G.StandOut_LastToken = nextToken

		local pend = { Token = nextToken, Chained = false }
		if u69 then
			rawset(u69, "serverMeleeToken", nextToken)
			rawset(u69, "serverMeleePending", pend)
		end

		local payload, nextIter, releaseDelay = buildDynamicLightPayload(char, nextToken, standObj, st.swingIter or 1)
		st.swingIter = nextIter

		local okFire = pcall(function()
			if isJob then
				remote.FireServer(remote, "Job", "BasicAttack", true, false, payload.Iteration, char)
				remote.FireServer(remote, "Job", "ServerMelee", payload, char)
			else
				remote.FireServer(remote, "BasicAttack", true, false, payload.Iteration, char)
				remote.FireServer(remote, "ServerMelee", payload, char)
			end
		end)
		if okFire then
			task.delay(releaseDelay, function()
				pcall(function()
					if isJob then
						remote.FireServer(remote, "Job", "BasicAttack", false, false)
					else
						remote.FireServer(remote, "BasicAttack", false, false)
					end
				end)
			end)
			return "remote-light", releaseDelay
		end
	end

	if ctrl and type(ctrl.lightSwing) == "function" then
		pcall(function() ctrl:lightSwing(targetModel) end)
		return "ctrl-light", 0.65
	end
	return nil, 0.45
end

local function tryCastSelectedEX(targetModel, tHrp, stateObj)
	local st = stateObj or elimState
	local sel = st.selectedEX
	if type(sel) ~= "table" or not next(sel) then return false, 0 end
	local cat = resolveElimSkillCatalog()
	if not cat.hasEX then return false, 0 end

	local char = LocalPlayer.Character
	local ctrl, u69 = getPlayerController()
	local states = (ctrl and type(ctrl.getStates) == "function") and ctrl:getStates() or {}

	for i = 1, 6 do
		if sel["EX Skill " .. i] then
			local exName = cat.exModeSlots["Skill" .. i]
			if (not exName or exName == "") and i >= 5 then
				exName = cat.exOnlyList[i - 4]
			end
			if exName and canCastSkillNow(exName, true, char, ctrl, u69, states, st) then
				local castOk, castDur = dispatchSkillAttack(exName, true, targetModel, tHrp, false, st)
				if castOk then
					return true, castDur
				end
			end
		end
	end

	return false, 0
end

local function tryCastSelectedBaseSkill(targetModel, tHrp, stateObj)
	local st = stateObj or elimState
	local sel = st.selectedSkills
	if type(sel) ~= "table" or not next(sel) then return false, 0 end
	local holdSel = st.heldSkills or {}
	local cat = resolveElimSkillCatalog()

	for i = 1, 6 do
		if sel["Skill " .. i] then
			local sName = cat.baseSkills[i]
			if sName and sName ~= "" then
				local castOk, castDur = dispatchSkillAttack(sName, false, targetModel, tHrp, holdSel["Skill " .. i] == true, st)
				if castOk then
					return true, castDur
				end
			end
		end
	end
	return false, 0
end

