local cachedHudSkillMissAt = {}
local function isHudSkillOnCooldown(skillName)
	local mainHud = PlayerGui:FindFirstChild("MainHUD")
	local skillsGui = mainHud and mainHud:FindFirstChild("Skills")
	if not skillsGui then return false end
	if cachedHudSkillsRoot ~= skillsGui then
		cachedHudSkillsRoot = skillsGui
		table.clear(cachedHudSkillEntries)
		table.clear(cachedHudSkillMissAt)
	end
	local entry = cachedHudSkillEntries[skillName]
	if entry ~= nil and (entry == false or not entry.Parent) then
		entry = nil
		cachedHudSkillEntries[skillName] = nil
	end
	if not entry then
		local now = os.clock()
		local missAt = cachedHudSkillMissAt[skillName] or 0
		if (now - missAt) >= 1.5 then
			entry = skillsGui:FindFirstChild(skillName, true)
			if entry then
				cachedHudSkillEntries[skillName] = entry
				cachedHudSkillMissAt[skillName] = nil
			else
				cachedHudSkillMissAt[skillName] = now
			end
		end
	end
	if not entry then return false end
	local cdFrame = entry:FindFirstChild("Cooldown")
	if cdFrame and cdFrame:IsA("GuiObject") and cdFrame.Size.X.Scale > 0.005 then
		return true
	end
	return false
end

local function canCastSkillNow(skillName, isEX, char, ctrl, u69, states, stateObj)
	if type(skillName) ~= "string" or skillName == "" then return false end
	if not char or not char.Parent then return false end
	local data = LocalPlayer:FindFirstChild("Data")
	local sa = data and data:FindFirstChild("SkillActive")
	if sa and sa.Value == true then return false end

	local standObj = getStandActorModel()
	local standSkillAttr = standObj and standObj:GetAttribute("Skill")
	if standSkillAttr == true or (type(standSkillAttr) == "string" and standSkillAttr ~= "") then
		return false
	end
	if char:GetAttribute("Stunned") == true then return false end
	if states and (states.Stunned == true or states.CombatDisabled == true) then return false end
	if states and type(states.OnCooldown) == "table" and states.OnCooldown[skillName] == true then
		return false
	end

	local st = stateObj or elimState
	local cdUntil = st.skillLocalCd[skillName]
	if cdUntil and os.clock() < cdUntil then
		return false
	end

	if isHudSkillOnCooldown(skillName) then
		return false
	end

	local skillsDefs = getSkillsDefModule()
	local sDef = skillsDefs and skillsDefs[skillName] or nil
	if type(sDef) == "table" and type(sDef.CooldownAttribute) == "string" then
		local cdAttr = char:GetAttribute(sDef.CooldownAttribute)
		if cdAttr == true or (type(cdAttr) == "number" and cdAttr > 0) then
			return false
		end
	end

	if isEX then
		if not ctrl or type(ctrl.hasEXAccess) ~= "function" then return false end
		local okEx, hasEx = pcall(ctrl.hasEXAccess, ctrl)
		if not (okEx and hasEx == true) then return false end

		if type(sDef) == "table" and type(sDef.ActiveAttribute) == "string" then
			if char:GetAttribute(sDef.ActiveAttribute) == true then
				return false
			end
		end

		local modeCost = (type(sDef) == "table" and tonumber(sDef.ModeCost)) or 1
		if modeCost > 0 then
			local modeInst = data and data:FindFirstChild("Mode")
			local modeVal = (modeInst and tonumber(modeInst.Value)) or 0
			local modeMax = (modeInst and tonumber(modeInst:GetAttribute("Max"))) or 100
			if modeMax <= 0 then modeMax = 100 end
			if modeVal < (modeCost * modeMax * 0.2) then
				return false
			end
		end
	end

	return true
end

local function buildSkillAim(hrp, targetModel, tHrp)
	local aimDir = tHrp.Position - hrp.Position
	local flatDir = Vector3.new(aimDir.X, 0, aimDir.Z)
	if flatDir.Magnitude < 0.05 then flatDir = Vector3.new(0, 0, -1) else flatDir = flatDir.Unit end
	local aimCFrame = CFrame.lookAt(hrp.Position, tHrp.Position)
	local closestMouse = {0, targetModel, aimDir.Magnitude, flatDir, tHrp.Position}
	return aimCFrame, closestMouse
end

local function dispatchSkillAttack(skillName, isEX, targetModel, tHrp, shouldHold, stateObj)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hrp or not tHrp then return false, 0 end

	local ctrl, u69 = getPlayerController()
	if not ctrl or not u69 or type(rawget(u69, "sendCombat")) ~= "function" then
		return false, 0
	end

	local st = stateObj or elimState
	local states = (type(ctrl.getStates) == "function") and ctrl:getStates() or {}
	if not canCastSkillNow(skillName, isEX, char, ctrl, u69, states, st) then
		return false, 0
	end

	resetStuckCombatStates(ctrl, u69)

	local aimCFrame, closestMouse = buildSkillAim(hrp, targetModel, tHrp)
	local statesCopy = (type(states) == "table") and table.clone(states) or {}
	if isEX then
		statesCopy.EXToggle = true
	end

	local skillsDefs = getSkillsDefModule()
	local sDef = skillsDefs and skillsDefs[skillName] or nil
	local holdMove = (not isEX) and (shouldHold == true)
	local holdDur = holdMove and math.clamp(tonumber(type(sDef) == "table" and sDef.MaxHold) or 0.75, 0.45, 1.6) or 0.08

	local sendFn = rawget(u69, "sendCombat")
	local ok = pcall(function()
		sendFn("Skill", skillName, aimCFrame, false, closestMouse, statesCopy)
	end)
	if ok then
		-- Short anti-double-fire guard; actual full cooldown comes from states.OnCooldown + HUD + attribute checks
		st.skillLocalCd[skillName] = os.clock() + 1.1
		st.lastSkillAt = os.clock()
		task.delay(holdDur, function()
			pcall(function()
				local c2 = LocalPlayer.Character
				local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
				local relAim, relMouse = aimCFrame, closestMouse
				if h2 and tHrp and tHrp.Parent then
					relAim, relMouse = buildSkillAim(h2, targetModel, tHrp)
				end
				sendFn("ReleasedSkill", skillName, relAim, false, relMouse, statesCopy)
			end)
		end)
		return true, (holdMove and (holdDur + 0.12) or 0.18)
	end
	return false, 0
end

