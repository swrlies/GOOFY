local function setElimRunning(shouldRun)
	shouldRun = (shouldRun == true)
	if shouldRun == elimState.running then return end
	elimState.running = shouldRun

	if elimUi.startBtn then
		elimUi.startBtn.Text = shouldRun and "Stop Eliminations" or "Start Eliminations"
		elimUi.startBtn.BackgroundColor3 = shouldRun and C_ERR or C_ACCENT
	end

	if shouldRun then
		setElimStatus("Status: Starting Elims...", C_OK)
		local pb = getPlayerBountiesRemote()
		if pb then
			pcall(function() pb.FireServer(pb, "Sync") end)
			elimState.lastSyncAt = os.clock()
		end
	else
		releaseElimCharacterLock()
		setElimStatus("Status: Stopped | Completed: " .. tostring(elimState.completedCount), C_SUB)
	end

	if appMod.getActiveFarmOwner then appMod.getActiveFarmOwner(true) end
	if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
	if activeTab and activeTab.isAutoFarm then
		updateCountLabel()
	end
end

