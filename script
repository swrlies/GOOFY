-- Main Elimination Farm & Combat Loop
task.spawn(function()
	local waitDur = 0.14
	while true do
		task.wait(waitDur)
		waitDur = 0.14
		if not isInstanceAlive() then return end

		if not elimState.running then
			continue
		end

		if appMod.isFarmOwner and not appMod.isFarmOwner("Eliminations") then
			local owner = appMod.getActiveFarmOwner()
			if owner then
				if next(elimState.noclipModified) or elimState.usedNoclipLatch then
					releaseElimCharacterLock()
				end
				setElimStatus("Status: Yielded to " .. tostring(owner), C_WARN)
				continue
			end
		end

		local b = elimState.bounty or { State = "Idle" }
		local pb = getPlayerBountiesRemote()
		local now = os.clock()

		if b.State == "Idle" or b.State == nil then
			if elimState.autoStart and pb then
				if now >= elimState.searchBackoffUntil and (now - elimState.lastStartReqAt) >= 2.0 then
					elimState.lastStartReqAt = now
					setElimStatus("Status: Starting new elimination...", C_WARN)
					pcall(function() pb.FireServer(pb, "Start") end)
				else
					local remWait = math.max(0, (elimState.searchBackoffUntil or 0) - now)
					if type(b.Message) == "string" and b.Message ~= "" then
						local suffix = (remWait >= 1) and string.format(" (retry %.0fs)", remWait) or ""
						setElimStatus("Status: " .. b.Message .. suffix, C_WARN)
					else
						setElimStatus("Status: Waiting to start quest...", C_SUB)
					end
				end
			else
				setElimStatus("Status: Idle (Auto-Start OFF)", C_SUB)
			end
			continue
		elseif b.State == "Searching" then
			setElimStatus("Status: " .. tostring(b.Message or "Finding NPC target..."), C_WARN)
			if (now - elimState.lastSyncAt) >= 6.0 and pb then
				elimState.lastSyncAt = now
				pcall(function() pb.FireServer(pb, "Sync") end)
			end
			continue
		elseif b.State == "Completing" then
			releaseElimCharacterLock()
			setElimStatus("Status: Collecting elimination reward...", C_OK)
			continue
		elseif b.State ~= "Active" then
			continue
		end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not char or not hrp or not hum or hum.Health <= 0 then
			setElimStatus("Status: Waiting for character...", C_WARN)
			continue
		end

		if b.Respawning then
			releaseElimCharacterLock()
			setElimStatus("Status: Target respawning...", C_WARN)
			continue
		end

		local targetModel = findElimTargetModel(b.CharacterName)
		local tHrp, tHum = isModelAlive(targetModel)

		if not tHrp or not tHum then
			releaseElimCharacterLock()
			if typeof(b.Position) == "Vector3" then
				local dist = (hrp.Position - b.Position).Magnitude
				if dist > 20 then
					hrp.CFrame = CFrame.new(b.Position + Vector3.new(0, 3, 0))
				end
				setElimStatus(string.format("Streaming target %s (%.0f studs)...", tostring(b.DisplayName or b.CharacterName), dist), C_WARN)
			else
				setElimStatus("Locating target " .. tostring(b.DisplayName or b.CharacterName) .. "...", C_WARN)
			end
			if pb and (now - elimState.lastSyncAt) >= 4.0 then
				elimState.lastSyncAt = now
				pcall(function() pb.FireServer(pb, "Sync") end)
			end
			continue
		end

		if getEquippedStandName() ~= "" and not isStandProperlySummoned(char) then
			releaseElimCharacterLock()
			setElimStatus("Status: Summoning Stand...", C_WARN)
			ensureStandReadyForBarge(char, hrp)
			continue
		end

		waitDur = 0.03
		local hpCur = math.floor(tHum.Health + 0.5)
		local hpMax = math.max(1, math.floor(tHum.MaxHealth + 0.5))
		setElimStatus(string.format("Fighting %s [Lvl %s] | HP: %d/%d | Clears: %d",
			tostring(b.DisplayName or b.CharacterName), tostring(b.Level or "-"), hpCur, hpMax, elimState.completedCount), C_OK)

		runComboCombatStep(elimState, char, hrp, targetModel, tHrp)
	end
end)

