			subHost.Position = UDim2.fromOffset(0, targetCardH + 50)
			subHost.Size = UDim2.new(1, 0, 1, -(targetCardH + 50))
		end)

		local collectShim = { state = { shownCount = 0 } }
		buildAutoCollectBody(collectShim, subHost)

		local elimShim = { state = { shownCount = 0 } }
		appMod.buildEliminationsBody(elimShim, subHost)

		local bossShim = { state = { shownCount = 0 } }
		appMod.buildSpawnedBossesBody(bossShim, subHost)

		local prioBody = buildPriorityBody(subHost)

		local subDefs = {
			{ key = "Collect",      label = "Collect",      body = collectShim.body },
			{ key = "Eliminations", label = "Elims.",       body = elimShim.body },
			{ key = "Bosses",       label = "Bosses",       body = bossShim.body },
			{ key = "Priority",     label = "Priority",     body = prioBody },
		}

		local subBtns = {}

		local function selectSubtab(key)
			closeAllDropdowns(subHost)
			for _, def in ipairs(subDefs) do
				local on = (def.key == key)
				if def.body then
					def.body.Visible = on
				end
				local btn = subBtns[def.key]
				if btn then
					btn.BackgroundColor3 = on and C_ACCENT or C_HEADER
					btn.BackgroundTransparency = on and 0 or 1
					btn.TextColor3       = on and C_TEXT or C_SUB
					btn.Font             = on and Enum.Font.GothamBold or Enum.Font.Gotham
				end
			end
			if key == "Priority" and appMod.refreshPriorityUI then
				appMod.refreshPriorityUI()
			elseif key == "Bosses" and appMod.refreshBossMonitorUI then
				appMod.refreshBossMonitorUI()
			end
		end

		for idx, def in ipairs(subDefs) do
			local btn = Instance.new("TextButton")
			btn.Text             = def.label
			btn.Font             = Enum.Font.Gotham
			btn.TextSize         = 11
			btn.TextColor3       = C_SUB
			btn.BackgroundColor3 = C_HEADER
			btn.BackgroundTransparency = 1
			btn.BorderSizePixel  = 0
			btn.LayoutOrder      = idx
			btn.Size             = UDim2.new(0.25, -3, 1, 0)
			btn.Parent           = subBar
			corner(btn, 5)
			subBtns[def.key] = btn

			btn.MouseButton1Click:Connect(function()
				selectSubtab(def.key)
			end)
		end

		appMod.selectAutoFarmSubtab = selectSubtab
		selectSubtab("Collect")

		tab.body = body
		tab.state = { shownCount = 0 }
	end

	-- Periodic Priority UI sync while active
	task.spawn(function()
		while true do
			task.wait(0.6)
			if not isInstanceAlive() then return end
			if appMod.getActiveFarmOwner then appMod.getActiveFarmOwner() end
			if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
		end
	end)
end)()

for i, tab in ipairs(tabs) do
