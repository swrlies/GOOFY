--=====================================================================
-- poll: rebuild only when item set changes
--=====================================================================
task.spawn(function()
	while true do
		task.wait(AUTO_REFRESH)
		for _, tab in ipairs(tabs) do
			if tab.isAutoCollect then continue end
			if tab.state.rebuildQueued then continue end
			local container = tab.getContainer()
			if container ~= tab.state.lastContainer then
				tab.rebuild()
			else
				local currentSet = tab.getItemSet(container)
				if not setsEqual(currentSet, tab.state.lastItemSet) then
					tab.rebuild()
				end
			end
		end
	end
end)

--=====================================================================
-- heartbeat: live studs text + fast container poll
--=====================================================================
local textAcc, pollAcc = 0, 0

local function playerPosition()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

RunService.Heartbeat:Connect(function(dt)
	pollAcc += dt
	if pollAcc >= POLL_RATE then
		pollAcc = 0
		for _, tab in ipairs(tabs) do
			if tab.isAutoCollect then continue end
			if tab.getContainer() ~= tab.state.lastContainer then
				tab.rebuild()
			end
		end
	end

	textAcc += dt
	if textAcc < 1 / TEXT_HZ then return end
	textAcc = 0

	if activeTab and not activeTab.isAutoCollect then
		local ppos = playerPosition()
		for item, data in pairs(activeTab.state.rows) do
			local p = data.part
			if p and p:IsDescendantOf(workspace) then
				if activeTab.state.showDistance then
					local pos = p.Position
					local txt = "Unknown distance"
					if ppos then
						txt = string.format("%d studs", math.round((pos - ppos).Magnitude))
					end
					if data.info.Text ~= txt then
						data.info.Text = txt
					end
				else
					if data.info.Text ~= "" then
						data.info.Text = ""
					end
				end
				if data.tp.BackgroundColor3 ~= C_ACCENT then
					data.tp.BackgroundColor3 = C_ACCENT
				end
			else
				if data.info.Text ~= "No BasePart found" then
					data.info.Text = "No BasePart found"
				end
				if data.tp.BackgroundColor3 ~= C_ROW_HOT then
					data.tp.BackgroundColor3 = C_ROW_HOT
				end
			end
		end
	end
end)

