_G.StandOut_OnSendCombat = function(actionName, ...)
	if actionName == "ServerMelee" then
		local payload = select(1, ...)
		if type(payload) == "table" and payload.Heavy == true then
			_G.StandOut_CachedServerMeleePayload = payload
			_G.StandOut_CachedServerMeleeChar = select(2, ...)
			_G.StandOut_LastServerMeleeAt = os.clock()
		end
