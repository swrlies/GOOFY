				local isEn = h.isEnabled and h.isEnabled() == true
				local hasW = false
				if isEn and type(h.hasWork) == "function" then
					local okW, resW = pcall(h.hasWork)
					hasW = (okW and resW == true)
				end

				if not isEn then
