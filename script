--=====================================================================
local function getPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function getAdornee(item, part)
	if item:IsA("Model") or item:IsA("BasePart") then return item end
	return part
end

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = parent
	return c
end

local function getDisplayName(item, tabName)
	if tabName == "Cases" or tabName == "Teleports" or tabName == "Scrap Barges" then
		return item.Name
	end

	if item.Name == "Handle" or item.Name == "SeedCorner" then
		return "Buried Supplies"
	end
	if tabName == "Supplies" then
		return "Buried Supplies"
	end

	if not item:IsA("Model") then return item.Name end
	local pp = item.PrimaryPart
	if pp and pp.Name ~= item.Name and pp.Name ~= "Handle" then
		return pp.Name
	end
	local candidates = {}
	for _, child in item:GetChildren() do
		if child:IsA("Model") then
			table.insert(candidates, child)
		elseif child:IsA("BasePart") then
			if child.Name ~= item.Name and child.Name ~= "Handle" and child.Name ~= "SeedCorner" then
				table.insert(candidates, child)
			end
		end
	end
	if #candidates == 1 then return candidates[1].Name end
	return item.Name
end

--=====================================================================
-- ANTI-FAKE: Mysterious Arrow Verification
--=====================================================================
local function isValidItem(item, tabName)
	if tabName ~= "Items" then return true end

	local name = getDisplayName(item, tabName)
	if name == "Mysterious Arrow" then
		local gameFolder = workspace:FindFirstChild("Game")
		local nodesFolder = gameFolder and gameFolder:FindFirstChild("ItemSpawnNodes")
		local arrowsFolder = nodesFolder and nodesFolder:FindFirstChild("Arrows")
		
		if not arrowsFolder then return true end 

		local part = getPart(item)
		if not part then return false end
		local pos = part.Position

		for _, node in arrowsFolder:GetChildren() do
			if node.Name:match("^Arrow0%d$") then
				local nodePos = node:IsA("BasePart") and node.Position or node:GetPivot().Position
				if (nodePos - pos).Magnitude <= 10 then
					return true
				end
			end
		end
		return false 
	end
	return true
end

local function collectEntries(container, tabName)
	local entries = {}
	if not container then return entries end

	if tabName == "Supplies" then
		for _, child in container:GetChildren() do
			if child.Name:match("^BuriedSupplies") then
				table.insert(entries, child)
			end
		end
		return entries
	end

	local function walk(node)
		for _, child in node:GetChildren() do
			if child:IsA("BasePart") or child:IsA("Model") then
				table.insert(entries, child)
			elseif child:IsA("Folder") then
				walk(child)
			end
		end
	end
	walk(container)
	return entries
end

local function setsEqual(a, b)
	for k in pairs(a) do if not b[k] then return false end end
	for k in pairs(b) do if not a[k] then return false end end
	return true
end

