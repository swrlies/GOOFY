--=====================================================================
updateCountLabel = function()
	if not activeTab then return end

	if activeTab.isAutoFarm then
		local owner = appMod.getActiveFarmOwner and appMod.getActiveFarmOwner() or nil
		if owner == "Bosses" then
			countLabel.Text = "BOSS"
			countLabel.BackgroundColor3 = C_OK
		elseif owner == "AutoCollect" then
			countLabel.Text = "COLLECT"
			countLabel.BackgroundColor3 = C_OK
		elseif owner == "Eliminations" then
			countLabel.Text = "ELIM"
			countLabel.BackgroundColor3 = C_OK
		else
			local anyOn = (autoCollectState.running == true)
				or (appMod.isBossFarmRunning and appMod.isBossFarmRunning())
				or (appMod.isEliminationsRunning and appMod.isEliminationsRunning())
			if anyOn then
				countLabel.Text = "WAIT"
				countLabel.BackgroundColor3 = C_WARN
			else
				countLabel.Text = "IDLE"
				countLabel.BackgroundColor3 = C_ROW_HOT
			end
		end
		countLabel.Size = UDim2.fromOffset(70, 22)
		return
	elseif activeTab.isMisc then
		countLabel.Text = "TOOLS"
		countLabel.BackgroundColor3 = C_ACCENT
		countLabel.Size = UDim2.fromOffset(60, 22)
		return
	elseif activeTab.isConfigs then
		local count = activeTab.state.shownCount or 0
		countLabel.Text = count .. " saved"
		countLabel.BackgroundColor3 = C_ACCENT
		countLabel.Size = UDim2.fromOffset(70, 22)
		return
	end

	local count = activeTab.state.shownCount or 0
	if activeTab.name == "Items" then
		countLabel.Text = count .. " spawned"
		countLabel.Size = UDim2.fromOffset(75, 22)
		countLabel.BackgroundColor3 = C_ACCENT
	elseif activeTab.name == "Supplies" then
		countLabel.Text = count .. " spawned"
		countLabel.Size = UDim2.fromOffset(75, 22)
		countLabel.BackgroundColor3 = C_ACCENT
	elseif activeTab.name == "Cases" then
		countLabel.Text = count .. " found"
		countLabel.Size = UDim2.fromOffset(70, 22)
		countLabel.BackgroundColor3 = C_ACCENT
	elseif activeTab.name == "Scrap Barges" then
		countLabel.Text = count .. " active"
		countLabel.Size = UDim2.fromOffset(65, 22)
		countLabel.BackgroundColor3 = C_ACCENT
	elseif activeTab.name == "World Events" then
		countLabel.Text = count .. " drops"
		countLabel.Size = UDim2.fromOffset(65, 22)
		countLabel.BackgroundColor3 = C_ACCENT
	else
		countLabel.Text = "Total: " .. count
		countLabel.Size = UDim2.fromOffset(60, 22)
		countLabel.BackgroundColor3 = C_ACCENT
	end
end

local function showTab(tab)
	activeTab = tab
	for _, t in ipairs(tabs) do
		local isSelected = (t == tab)
		t.body.Visible = isSelected

		t.tabBtn.BackgroundColor3 = isSelected and C_PANEL or C_HEADER
		t.tabBtn.BackgroundTransparency = isSelected and 0 or 1
		t.tabBtn.TextColor3       = isSelected and C_TEXT or C_SUB
		t.tabBtn.Font             = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham
		if t.activeBar then
			t.activeBar.Visible = isSelected
		end
	end
	updateCountLabel()
end

for _, tab in ipairs(tabs) do
	tab.tabBtn.MouseButton1Click:Connect(function() showTab(tab) end)
end

