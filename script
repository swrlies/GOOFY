local savedPosition = nil

LocalPlayer.CharacterAdded:Connect(function()
	savedPosition = nil
end)

local function teleportToItem(item)
	local part = getPart(item)
	if not part then return false, "Item has no BasePart." end
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, "Character not available." end
	if not savedPosition then savedPosition = hrp.CFrame end
	hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
	Camera.CameraType = Enum.CameraType.Custom
	return true
end

local function returnToSaved()
	if not savedPosition then return false, "No saved position." end
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, "Character not available." end
	hrp.CFrame = savedPosition
	savedPosition = nil
	return true
end

