local function hasEliminationWork()
	if not elimState.running then return false end
	local b = elimState.bounty or { State = "Idle" }
	if b.State == "Active" or b.State == "Searching" or b.State == "Completing" then
		return true
	end
	if elimState.autoStart and os.clock() >= (elimState.searchBackoffUntil or 0) then
		return true
	end
	return false
end

