--=====================================================================
-- Unified Auto-Farm Priority Coordinator (Bosses / AutoCollect / Eliminations)
--=====================================================================
;(function()
	local DEFAULT_ORDER = { "Bosses", "AutoCollect", "Eliminations" }
	local VALID_KEYS = { Bosses = true, AutoCollect = true, Eliminations = true }

	local coordinator = {
		order        = { "Bosses", "AutoCollect", "Eliminations" },
		handlers     = {},
		currentOwner = nil,
		lastResolve  = 0,
	}

	appMod.farmPriority = coordinator

	appMod.registerFarmHandler = function(key, def)
		if VALID_KEYS[key] and type(def) == "table" then
			coordinator.handlers[key] = def
		end
	end

	appMod.getActiveFarmOwner = function(force)
		local now = os.clock()
		if not force and (now - (coordinator.lastResolve or 0)) < 0.12 then
			return coordinator.currentOwner
		end
		coordinator.lastResolve = now

		local desired = nil
		for _, key in ipairs(coordinator.order) do
			local h = coordinator.handlers[key]
			if h and type(h.isEnabled) == "function" and h.isEnabled() then
				local okW, hasW = true, true
				if type(h.hasWork) == "function" then
					okW, hasW = pcall(h.hasWork)
				end
				if okW and hasW == true then
					desired = key
					break
				end
			end
		end

		if desired ~= coordinator.currentOwner then
			local oldKey = coordinator.currentOwner
			coordinator.currentOwner = desired
			if oldKey then
				local oldH = coordinator.handlers[oldKey]
				if oldH and type(oldH.onYield) == "function" then
					pcall(oldH.onYield)
				end
			end
			task.defer(function()
				if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
				if updateCountLabel then updateCountLabel() end
			end)
		end

		return coordinator.currentOwner
	end

	appMod.isFarmOwner = function(key)
		return appMod.getActiveFarmOwner(false) == key
	end

	appMod.hasOtherRunningFarm = function(excludeKey)
		for _, key in ipairs(coordinator.order) do
			if key ~= excludeKey then
				local h = coordinator.handlers[key]
				if h and type(h.isEnabled) == "function" and h.isEnabled() then
					return true
				end
			end
		end
		return false
	end

	appMod.setFarmOrder = function(newOrder)
		if type(newOrder) ~= "table" then return end
		local clean, seen = {}, {}
		for _, k in ipairs(newOrder) do
			if VALID_KEYS[k] and not seen[k] then
				seen[k] = true
				table.insert(clean, k)
			end
		end
		for _, k in ipairs(DEFAULT_ORDER) do
			if not seen[k] then
				seen[k] = true
				table.insert(clean, k)
			end
		end
		coordinator.order = clean
		appMod.getActiveFarmOwner(true)
		if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
	end

	appMod.moveFarmPriority = function(key, delta)
		local idx
		for i, k in ipairs(coordinator.order) do
			if k == key then idx = i; break end
		end
		if not idx then return end
		local targetIdx = idx + delta
		if targetIdx < 1 or targetIdx > #coordinator.order then return end
		coordinator.order[idx], coordinator.order[targetIdx] = coordinator.order[targetIdx], coordinator.order[idx]
		appMod.getActiveFarmOwner(true)
		if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
	end

	appMod.setAllFarmsRunning = function(shouldRun)
		shouldRun = (shouldRun == true)
		for _, key in ipairs(coordinator.order) do
			local h = coordinator.handlers[key]
			if h and type(h.setEnabled) == "function" then
				pcall(h.setEnabled, shouldRun)
			end
		end
		appMod.getActiveFarmOwner(true)
		if appMod.refreshPriorityUI then appMod.refreshPriorityUI() end
	end
end)()

--=====================================================================
-- Tabbed-Out Safe Interact: Prompts + ClickDetectors + Remotes
--=====================================================================
local function isItemCollectedState(targetItem)
	if not targetItem or not targetItem:IsDescendantOf(workspace) then
		return true
	end
	if targetItem:GetAttribute("GardenSupplyAvailable") == false then
		return true
	end
	return false
end

local function fireInstantPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
	local fired = false
	if typeof(fireproximityprompt) == "function" then
		if pcall(function() return fireproximityprompt(prompt) end) then fired = true end
	end
	pcall(function()
		prompt:InputHoldBegin()
		task.wait(0.03)
		prompt:InputHoldEnd()
		fired = true
	end)
	return fired
end

local function fireHoldPrompt(prompt, targetItem, shouldInterrupt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end

	-- Preserve HoldDuration so the server's hold-duration check accepts the trigger;
	-- disable RequiresLineOfSight temporarily so camera angle/tab-out never hides the prompt.
	local origLoS = prompt.RequiresLineOfSight
	pcall(function() prompt.RequiresLineOfSight = false end)

	local promptTriggered = false
	local c1 = prompt.Triggered:Connect(function()
		promptTriggered = true
	end)
	local c2 = ProximityPromptService.PromptTriggered:Connect(function(pr)
		if pr == prompt then
			promptTriggered = true
		end
	end)

	local beganOk = pcall(function()
		prompt:InputHoldBegin()
	end)

	if beganOk then
		-- Tabbed-out / throttled clients can advance prompt hold progress slower than real time
		local maxWait = math.max((prompt.HoldDuration or 1.2) * 3.5 + 1.5, 4.5)
		local t0 = os.clock()
		while not promptTriggered and (os.clock() - t0 < maxWait) do
			if not autoCollectState.running then break end
			if shouldInterrupt and shouldInterrupt() then break end
			if isItemCollectedState(targetItem) then break end
			if not prompt.Parent or not prompt.Enabled then break end
			task.wait(0.05)
		end
		pcall(function() prompt:InputHoldEnd() end)
	end

	c1:Disconnect()
	c2:Disconnect()
	pcall(function() prompt.RequiresLineOfSight = origLoS end)

	if promptTriggered and targetItem then
		local tSettle = os.clock()
		while not isItemCollectedState(targetItem) and (os.clock() - tSettle < 0.6) do
			if not autoCollectState.running then break end
			task.wait(0.05)
		end
	end

	if not beganOk and typeof(fireproximityprompt) == "function" then
		pcall(function() return fireproximityprompt(prompt) end)
		return true
	end
	return promptTriggered or isItemCollectedState(targetItem)
end

local function fireSinglePromptZeroHold(prompt, targetItem, shouldInterrupt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
	if (prompt.HoldDuration or 0) > 0.05 then
		return fireHoldPrompt(prompt, targetItem, shouldInterrupt)
	end
	return fireInstantPrompt(prompt)
end

local function triggerInteractOnItem(targetItem, shouldInterrupt)
	if not targetItem then return false end
	if isItemCollectedState(targetItem) then return true end
	local triggered = false

	-- 1. Check targetItem itself & all descendants for ProximityPrompt / ClickDetector
	local candidates = { targetItem }
	for _, desc in ipairs(targetItem:GetDescendants()) do
		table.insert(candidates, desc)
	end

	for _, inst in ipairs(candidates) do
		if isItemCollectedState(targetItem) then break end
		if inst:IsA("ProximityPrompt") and inst.Enabled then
			if fireSinglePromptZeroHold(inst, targetItem, shouldInterrupt) then
				triggered = true
			end
		elseif inst:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
			if pcall(fireclickdetector, inst) then
				triggered = true
			end
		end
	end

	-- 2. Also check any enabled ProximityPrompt within 12 studs of the item
	if not isItemCollectedState(targetItem) then
		local itemPos = getItemPosition(targetItem)
		if itemPos then
			local g = workspace:FindFirstChild("Game")
			if g then
				for _, desc in ipairs(g:GetDescendants()) do
					if isItemCollectedState(targetItem) then break end
					if desc:IsA("ProximityPrompt") and desc.Enabled then
						local p = desc.Parent and getPart(desc.Parent)
						if p and (p.Position - itemPos).Magnitude <= 12 then
							if fireSinglePromptZeroHold(desc, targetItem, shouldInterrupt) then
								triggered = true
							end
						end
					end
				end
			end
		end
	end

	-- 3. Replay cached pickup/interact remote if captured (dot-syntax avoids __namecall issues)
	if not isItemCollectedState(targetItem) and _G.StandOut_CachedInteract and _G.StandOut_CachedInteractArgs then
		local rem = _G.StandOut_CachedInteract
		local argsCopy = table.clone(_G.StandOut_CachedInteractArgs)
		for i = 1, #argsCopy do
			if typeof(argsCopy[i]) == "Instance" then
				argsCopy[i] = targetItem
			end
		end
		local ok = pcall(function()
			if _G.StandOut_CachedInteractMethod == "InvokeServer" then
				rem.InvokeServer(rem, table.unpack(argsCopy))
			else
				rem.FireServer(rem, table.unpack(argsCopy))
			end
		end)
		if ok then triggered = true end
	end

	return triggered
end

local function waitUntilStable(maxWait)
	maxWait = maxWait or 0.5
	local t0 = os.clock()
	local char = LocalPlayer.Character
	while os.clock() - t0 < maxWait do
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return false end
		local state = hum:GetState()
		if state == Enum.HumanoidStateType.Running
			or state == Enum.HumanoidStateType.RunningNoPhysics
			or state == Enum.HumanoidStateType.Landed
			or state == Enum.HumanoidStateType.Idle then
			return true
		end
		task.wait(0.05)
	end
	return false
end

--=====================================================================
-- Key simulation (only used when window is focused as a backup)
--=====================================================================
local function simulateKey(key, holdTime, targetItem, shouldInterrupt)
	if not UserInputService.WindowFocused then
		return false, "unfocused-skipped"
	end

	holdTime = holdTime or 0.05
	local kc = Enum.KeyCode[key]
	if not kc then return false, "bad-keycode" end

	local keyStr = string.lower(key)
	local keyNum = kc.Value
	local method = nil

	if typeof(keypress) == "function" and typeof(keyrelease) == "function" then
		if pcall(keypress, keyStr) then method = "keypress-str" end
	end
	if not method and typeof(keypress) == "function" and typeof(keyrelease) == "function" then
		if pcall(keypress, keyNum) then method = "keypress-num" end
	end
	if not method and VirtualInputManager then
		if pcall(function() VirtualInputManager:SendKeyEvent(true, kc, false) end) then
			method = "vim"
		end
	end

	if not method then return false, "no-method" end

	local t0 = os.clock()
	while os.clock() - t0 < holdTime do
		if not autoCollectState.running then break end
		if targetItem and not targetItem:IsDescendantOf(workspace) then break end
		if shouldInterrupt and shouldInterrupt() then break end
		task.wait(0.03)
	end

	if method == "keypress-str" then
		pcall(keyrelease, keyStr)
	elseif method == "keypress-num" then
		pcall(keyrelease, keyNum)
	else
		pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false) end)
	end

	return true, method
end

