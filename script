	optScroll.BackgroundTransparency = 1
	optScroll.BorderSizePixel = 0
	optScroll.ScrollBarThickness = 4
	optScroll.ScrollBarImageColor3 = Color3.fromRGB(90, 96, 110)
	optScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	optScroll.CanvasSize = UDim2.new()
	optScroll.ZIndex = 20
	optScroll.Parent = optionsFrame

	local optList = Instance.new("UIListLayout")
	optList.Padding = UDim.new(0, 2)
	optList.SortOrder = Enum.SortOrder.LayoutOrder
	optList.Parent = optScroll

	local function selectOption(idx, opt, fireCb)
		currentOpt = opt
		button.Text = opt
		optionsFrame.Visible = false
		container.ZIndex = 1
		if fireCb ~= false and onChange then
			onChange(idx, opt)
		end
	end

	button.MouseButton1Click:Connect(function()
		local wasOpen = optionsFrame.Visible
		closeAllDropdowns(parent)
		if not wasOpen then
			container.ZIndex = 50
			optionsFrame.Visible = true
		end
	end)

	for i, opt in ipairs(options) do
		local optBtn = Instance.new("TextButton")
		optBtn.Text = opt
		optBtn.Font = Enum.Font.Gotham
		optBtn.TextSize = 12
		optBtn.TextColor3 = C_TEXT
		optBtn.BackgroundColor3 = C_PANEL
		optBtn.BorderSizePixel = 0
		optBtn.Size = UDim2.new(1, -4, 0, 24)
		optBtn.LayoutOrder = i
		optBtn.TextXAlignment = Enum.TextXAlignment.Left
		optBtn.ZIndex = 21
		optBtn.Parent = optScroll
		corner(optBtn, 4)
		local sp2 = Instance.new("UIPadding"); sp2.PaddingLeft = UDim.new(0, 8); sp2.Parent = optBtn

		optBtn.MouseEnter:Connect(function() optBtn.BackgroundColor3 = C_ROW_HOT end)
		optBtn.MouseLeave:Connect(function() optBtn.BackgroundColor3 = C_PANEL end)

		optBtn.MouseButton1Click:Connect(function()
			selectOption(i, opt, true)
		end)
	end

	return {
		getValue = function()
			return currentOpt
		end,
		setValue = function(opt, fireCb)
			for i, o in ipairs(options) do
				if o == opt then
					selectOption(i, o, fireCb)
					return true
				end
			end
			return false
		end,
	}
end

