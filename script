local function ensureStandReadyForBarge(char, hrp)
	local standName = getEquippedStandName()
	if standName == "" then return false, nil end

	local rems = ReplicatedStorage:FindFirstChild("Remotes")
	local combatRemote = rems and rems:FindFirstChild("Combat")
	local standObj = getStandActorModel()

	if char:GetAttribute("Summoned") == true and standObj and hrp then
		local sHrp = standObj:FindFirstChild("HumanoidRootPart")
		if sHrp and (sHrp.Position - hrp.Position).Magnitude > 30 then
			local tWait = os.clock()
			while (sHrp.Position - hrp.Position).Magnitude > 30 and os.clock() - tWait < 0.35 do
				task.wait(0.04)
			end
			if (sHrp.Position - hrp.Position).Magnitude > 30 and combatRemote and combatRemote:IsA("RemoteEvent") then
				pcall(function() combatRemote.FireServer(combatRemote, "Summon", false) end)
				task.wait(0.22)
			end
		end
	end

	local alreadyOut, readyObj = isStandProperlySummoned(char)
	if alreadyOut then
		return true, readyObj
	end

	local ctrl = getPlayerController()
	if ctrl and type(ctrl.summonStand) == "function" then
		pcall(function() ctrl:summonStand(true) end)
	end
	if char:GetAttribute("Summoned") ~= true and combatRemote and combatRemote:IsA("RemoteEvent") then
		pcall(function() combatRemote.FireServer(combatRemote, "Summon", true) end)
	end

	local t0 = os.clock()
	local retriedCtrl = false
	while os.clock() - t0 < 1.5 do
		local okOut, curObj = isStandProperlySummoned(char)
		if okOut then
			return true, curObj
		end
		if not retriedCtrl and (os.clock() - t0) >= 0.45 then
			retriedCtrl = true
			ctrl = getPlayerController()
			if ctrl and type(ctrl.summonStand) == "function" then
				pcall(function() ctrl:summonStand(true) end)
			end
		end
		task.wait(0.04)
	end

	local finalOk, finalObj = isStandProperlySummoned(char)
	return finalOk, finalObj or getStandActorModel()
end

local function buildDynamicHeavyPayload(char, token, standObj)
	local standName = getEquippedStandName()
	local data = LocalPlayer:FindFirstChild("Data")
	local wov = data and data:FindFirstChild("WeaponOverride")
	local wv  = data and data:FindFirstChild("Weapon")
	local weaponName = (wov and wov.Value ~= "" and wov.Value) or (wv and wv.Value ~= "" and wv.Value) or "Fists"

	local mods = ReplicatedStorage:FindFirstChild("Modules")
	local okW, Weapons = pcall(require, mods and mods:FindFirstChild("Weapons"))
	local okS, Stands  = pcall(require, mods and mods:FindFirstChild("Stands"))
	local okU, Utility = pcall(require, mods and mods:FindFirstChild("Utility"))

	local sDef = (okS and type(Stands) == "table" and standName ~= "" and Stands.GetDefinition)
		and Stands:GetDefinition(char, standName) or nil
	local combatName = (okW and type(Weapons) == "table" and sDef and Weapons.GetStandCombatName)
		and Weapons:GetStandCombatName(standName, sDef) or weaponName
	local animName = (okW and type(Weapons) == "table" and sDef and Weapons.GetStandAnimationName)
		and Weapons:GetStandAnimationName(standName, sDef) or combatName

	local wInfo = (okW and type(Weapons) == "table" and type(Weapons.weaponInfo) == "table")
		and Weapons.weaponInfo[combatName] or nil
	local useStand = (standName ~= "" and char:GetAttribute("Summoned") == true and sDef ~= nil
		and not sDef.NoStandM1 and not (wInfo and wInfo.HeavyOnCharacter))

	local profile = useStand and combatName or weaponName
	local pInfo = (okW and type(Weapons) == "table" and type(Weapons.weaponInfo) == "table")
		and (Weapons.weaponInfo[profile] or Weapons.weaponInfo.Fists) or nil

	local mult = 1
	if okU and type(Utility) == "table" and type(Utility.getAttackTimeMultiplier) == "function" then
		local okM, m = pcall(Utility.getAttackTimeMultiplier, Utility, char, nil, nil, {
			BasicAttack = "Heavy",
			BasicAttackProfile = profile,
			BasicAttackOnCharacter = (pInfo and pInfo.HeavyOnCharacter == true) or false,
		})
		if okM and type(m) == "number" and m > 0 then mult = m end
	end

	local activeTimes = pInfo and pInfo.HeavySwingActiveTimes and pInfo.HeavySwingActiveTimes[1]
	local at1  = ((activeTimes and activeTimes[1]) or 0.375) * mult
	local len1 = ((activeTimes and activeTimes[2]) or 0.2) * mult
	local speed1 = (pInfo and pInfo.HeavyAnimationSpeed and pInfo.HeavyAnimationSpeed[1]) or 1
	local size1 = (pInfo and pInfo.M2Hitbox and pInfo.M2Hitbox[1]) or Vector3.new(8, 6.65, 8.8)
	local offset1 = (pInfo and pInfo.HeavyOffset) or CFrame.new(0, 0, -size1.Z / 2)

	local animObj
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local anims = assets and assets:FindFirstChild("Animations")
	if anims then
		local folder = anims:FindFirstChild(animName) or anims:FindFirstChild(profile) or anims:FindFirstChild("Fists")
		local heavyFolder = folder and folder:FindFirstChild("Heavy")
		animObj = heavyFolder and heavyFolder:FindFirstChild("1")
	end
	local actorModel = useStand and (standObj or getStandActorModel()) or char

	local contacts = {}
	local eventTimes = pInfo and pInfo.HeavyHitEventTimes and pInfo.HeavyHitEventTimes[1]
	if type(eventTimes) == "table" and #eventTimes > 0 then
		for idx, tVal in ipairs(eventTimes) do
			local isLast = (idx == #eventTimes)
			table.insert(contacts, {
				At = tVal * mult,
				Length = len1,
				Swing = { Iteration = 1, HeavyHit = true, Length = 0.6, Finisher = isLast },
				Hit = {
					SwingIteration = 1,
					HeavyIteration = 1,
					HeavyHit = isLast,
					AirBody = false,
					AirStand = false,
					Uptilt = false,
				},
			})
		end
	else
		table.insert(contacts, {
			At = at1,
			Length = len1,
			Swing = { Iteration = 1, HeavyHit = true, Length = 0.6, Finisher = true },
			Hit = {
				SwingIteration = 1,
				HeavyIteration = 1,
				HeavyHit = true,
				AirBody = false,
				AirStand = false,
				Uptilt = false,
			},
		})
	end

	local animTbl
	if animObj and actorModel then
		animTbl = {
			Actor = actorModel,
			Id = animObj.AnimationId,
			Speed = speed1 / mult,
			Step = (useStand and sDef and sDef.HeavyAttackMovementLead) and sDef.HeavyAttackOffset or nil,
		}
	end

	return {
		Heavy = true,
		Size = size1,
		Offset = offset1,
		Profile = profile,
		ActorStand = useStand,
		Chained = false,
		Anim = animTbl,
		Contacts = contacts,
		Token = token,
	}
end

local function fireDirectServerMeleeRemote(ctrl, u69)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hrp then return nil end

	local remote = getMeleeRemote(u69)
	if not remote then return nil end

	resetStuckCombatStates(ctrl, u69)
	local _, standObj = ensureStandReadyForBarge(char, hrp)

	local isJob = (remote.Name == "Remote") or (workspace:GetAttribute("ServerMelee") == true)
	local nextToken = ((u69 and rawget(u69, "serverMeleeToken")) or _G.StandOut_LastToken or 0) + 1
	_G.StandOut_LastToken = nextToken

	local pend: { [string]: any } = { Token = nextToken, Chained = false }
	if u69 then
		rawset(u69, "serverMeleeToken", nextToken)
		rawset(u69, "serverMeleePending", pend)
	end

	local payload = buildDynamicHeavyPayload(char, nextToken, standObj)

	local finishDelay = 0.95
	if type(payload.Contacts) == "table" then
		local maxAt = 0
		for _, c in ipairs(payload.Contacts) do
			if type(c) == "table" and type(c.At) == "number" then
				local endAt = c.At + (tonumber(c.Length) or 0.2)
				if endAt > maxAt then maxAt = endAt end
			end
		end
		if maxAt > 0 then
			finishDelay = math.clamp(maxAt + 0.1, 0.55, 2.0)
		end
	end

	-- Always invoke FireServer via dot syntax so __namecall hooks cannot throw "Unable to cast value to Object"
	local okFire = pcall(function()
		if isJob then
			remote.FireServer(remote, "Job", "BasicAttack", true, true, 1, char)
			remote.FireServer(remote, "Job", "ServerMelee", payload, char)
		else
			remote.FireServer(remote, "BasicAttack", true, true, 1, char)
			remote.FireServer(remote, "ServerMelee", payload, char)
		end
	end)

	if not okFire then return nil end
	lastBargeSwingAt = os.clock()

	task.delay(finishDelay, function()
		pcall(function()
			if isJob then
				remote.FireServer(remote, "Job", "BasicAttack", false, true)
			else
				remote.FireServer(remote, "BasicAttack", false, true)
			end
		end)
	end)

	local waitStart = os.clock()
	while pend.Answer == nil and os.clock() - waitStart < 0.3 do
		task.wait(0.02)
	end

	return "remote-ServerMelee"
end

local function fireHeavySwing()
	local ctrl, u69 = getPlayerController()
	resetStuckCombatStates(ctrl, u69)

	-- 1. Primary: Direct ServerMelee remote dispatch using dot syntax (avoids broken __namecall and stuck client flags)
	local directMethod = fireDirectServerMeleeRemote(ctrl, u69)
	if directMethod then
		return directMethod
	end

	-- 2. Fallback: PlayerController:heavySwing() if direct remote wasn't found
	if ctrl then
		local prevToken = u69 and rawget(u69, "serverMeleeToken")
		local prevAt = _G.StandOut_LastServerMeleeAt or 0

		task.spawn(function()
			pcall(function()
				ctrl:heavySwing()
			end)
		end)

		local t0 = os.clock()
		while os.clock() - t0 < 0.25 do
			local curToken = u69 and rawget(u69, "serverMeleeToken")
			if (curToken ~= nil and curToken ~= prevToken)
				or ((_G.StandOut_LastServerMeleeAt or 0) > prevAt) then
				lastBargeSwingAt = os.clock()
				return "heavySwing-remote"
			end
			task.wait(0.02)
		end
	end

	-- 3. Replay cached melee remote using dot syntax if captured
	if _G.StandOut_CachedMelee and _G.StandOut_CachedMeleeArgs then
		local rem = _G.StandOut_CachedMelee
		local ok = pcall(function()
			if _G.StandOut_CachedMeleeMethod == "InvokeServer" then
				rem.InvokeServer(rem, table.unpack(_G.StandOut_CachedMeleeArgs))
			else
				rem.FireServer(rem, table.unpack(_G.StandOut_CachedMeleeArgs))
			end
		end)
		if ok then
			lastBargeSwingAt = os.clock()
			return "cached-remote"
		end
	end

	-- 4. Last resort: Input simulation (only if focused)
	if UserInputService.WindowFocused then
		pressAllMethods()
		lastBargeSwingAt = os.clock()
		return "input"
	end
	return "no-method"
end

local function attemptBreakBarge(targetItem, shouldInterrupt)
	local anchorPos = getItemPosition(targetItem)
	if not anchorPos then return false, "no-pos" end
	local liveDebrisPos = findNearestDebrisPos(anchorPos, 26)
	local bargePos = liveDebrisPos or anchorPos

	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, "no-hrp" end
	if not autoCollectState.running then return false, "stopped" end
	if shouldInterrupt and shouldInterrupt() then return false, "preempt" end

	-- Prevent Noclip from dropping the character through the barge platform or geometry
	autoCollectState.busyBarge = true
	setCharCollide(char, false)

	local function finishBargeAttempt()
		autoCollectState.busyBarge = false
		if hrp and hrp.Parent then
			hrp.Anchored = false
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end

	local strikeCF = getBargeStandCFrame(bargePos, hrp.Position)
	ensureBargePlatform(targetItem, strikeCF.Position)

	hrp.Anchored = true
	hrp.CFrame = strikeCF
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	pcall(function()
		Camera.CFrame = CFrame.new(Camera.CFrame.Position, bargePos)
	end)

	task.wait(0.2)

	-- Respect heavy swing cooldown cleanly while anchored & solid on platform
	local ctrl, u69 = getPlayerController()
	resetStuckCombatStates(ctrl, u69)
	while os.clock() - lastBargeSwingAt < 1.25 do
		if not autoCollectState.running then finishBargeAttempt(); return false, "stopped" end
		if shouldInterrupt and shouldInterrupt() then finishBargeAttempt(); return false, "preempt" end
		if not findNearestDebrisPos(anchorPos, 26) then
			scheduleBargePlatformDespawn(targetItem)
			finishBargeAttempt()
			return true, "already-broken"
		end
		if hrp and hrp.Parent then
			hrp.Anchored = true
			hrp.CFrame = strikeCF
		end
		task.wait(0.05)
	end

	if not autoCollectState.running then finishBargeAttempt(); return false, "stopped" end
	if shouldInterrupt and shouldInterrupt() then finishBargeAttempt(); return false, "preempt" end

	-- Re-lock onto live DebrisPiece center before firing heavy swing
	local latestPos = findNearestDebrisPos(anchorPos, 26)
	if not latestPos then
		scheduleBargePlatformDespawn(targetItem)
		finishBargeAttempt()
		return true, "already-broken"
	end
	bargePos = latestPos
	strikeCF = getBargeStandCFrame(bargePos, strikeCF.Position)
	ensureBargePlatform(targetItem, strikeCF.Position)
	hrp.Anchored = true
	hrp.CFrame = strikeCF
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	local usedMethod = fireHeavySwing()

	local waitStart = os.clock()
	while os.clock() - waitStart < 1.5 do
		if not autoCollectState.running then finishBargeAttempt(); return false, "stopped" end
		if shouldInterrupt and shouldInterrupt() then finishBargeAttempt(); return false, "preempt" end
		if not findNearestDebrisPos(anchorPos, 26) then
			scheduleBargePlatformDespawn(targetItem)
			finishBargeAttempt()
			return true, usedMethod
		end
		if hrp and hrp.Parent then
			hrp.Anchored = true
			if (hrp.Position - strikeCF.Position).Magnitude > 1.5 then
				hrp.CFrame = strikeCF
			end
		end
		task.wait(0.05)
	end

	if not findNearestDebrisPos(anchorPos, 26) then
		scheduleBargePlatformDespawn(targetItem)
		finishBargeAttempt()
		return true, usedMethod
	end
	finishBargeAttempt()
	return false, "no-break"
end

