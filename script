-- Main Boss Auto-Farm loop
task.spawn(function()
	while isInstanceAlive() and not appMod.combat do
		task.wait(0.05)
	end
	local prevBossModel = nil
	local waitDur = 0.12
	while true do
		task.wait(waitDur)
		waitDur = 0.12
		if not isInstanceAlive() then return end

		if prevBossModel and prevBossModel.Parent then
			local prevHum = prevBossModel:FindFirstChildOfClass("Humanoid")
			if prevHum and prevHum.Health <= 0 then
				bossFarmState.completedCount += 1
				bossFarmState.activeBossId = nil
				prevBossModel = nil
				releaseBossCharacterLock()
			end
		elseif prevBossModel and not prevBossModel.Parent then
			prevBossModel = nil
		end

		if not bossFarmState.running then
			continue
		end

		if appMod.isFarmOwner and not appMod.isFarmOwner("Bosses") then
			local owner = appMod.getActiveFarmOwner()
			if owner then
				if next(bossFarmState.noclipModified) or bossFarmState.usedNoclipLatch then
					releaseBossCharacterLock()
				end
				setBossFarmStatus("Status: Yielded to " .. tostring(owner), C_WARN)
				continue
			end
		end

		local best = pickActiveBossTarget()
		if not best then
			if bossFarmState.activeBossId ~= nil then
				bossFarmState.activeBossId = nil
				releaseBossCharacterLock()
			end
			if bossFarmState.running then
				setBossFarmStatus("Status: Waiting for boss spawn... | Clears: " .. tostring(bossFarmState.completedCount), C_SUB)
			end
			continue
		end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not char or not hrp or not hum or hum.Health <= 0 then
			releaseBossCharacterLock()
			setBossFarmStatus("Status: Waiting for character...", C_WARN)
			continue
		end

		local tHrp, tHum = best.model and appMod.combat.isModelAlive(best.model) or nil, nil
		if best.model then
			tHrp, tHum = appMod.combat.isModelAlive(best.model)
		end

		if not tHrp or not tHum then
			releaseBossCharacterLock()
			if typeof(best.pos) == "Vector3" then
				local dist = (hrp.Position - best.pos).Magnitude
				if dist > 24 then
					hrp.CFrame = CFrame.new(best.pos + Vector3.new(0, 6, 0))
				end
				setBossFarmStatus(string.format("Streaming %s (%.0f studs)...", tostring(best.bossKind), dist), C_WARN)
			else
				setBossFarmStatus("Locating " .. tostring(best.bossKind) .. "...", C_WARN)
			end
			continue
		end

		prevBossModel = best.model
		if bossFarmState.activeBossId ~= best.id then
			bossFarmState.activeBossId = best.id
			bossFarmState.m1ComboCount = 0
		end

		if appMod.combat.getEquippedStand and appMod.combat.isStandSummoned and appMod.combat.ensureStandSummon then
			if appMod.combat.getEquippedStand() ~= "" and not appMod.combat.isStandSummoned(char) then
				releaseBossCharacterLock()
				setBossFarmStatus("Status: Summoning Stand...", C_WARN)
				appMod.combat.ensureStandSummon(char, hrp)
				continue
			end
		end

		waitDur = 0.03
		local hpCur = math.floor(tHum.Health + 0.5)
		local hpMax = math.max(1, math.floor(tHum.MaxHealth + 0.5))
		setBossFarmStatus(string.format("Fighting %s [Lvl %s] | HP: %d/%d | Clears: %d",
			tostring(best.bossKind), tostring(best.level or "-"), hpCur, hpMax, bossFarmState.completedCount), C_OK)

		appMod.combat.runComboStep(bossFarmState, char, hrp, best.model, tHrp)
		if tHum.Health <= 0 then
			bossFarmState.completedCount += 1
			bossFarmState.activeBossId = nil
			prevBossModel = nil
			releaseBossCharacterLock()
		end
	end
end)

