	txtDist.Size = UDim2.new(1, 0, 0.5, 0)
	txtDist.Position = UDim2.new(0, 0, 0.5, 0)
	txtDist.BackgroundTransparency = 1
	txtDist.Text = ""
	txtDist.TextColor3 = Color3.fromRGB(255, 0, 0)
	txtDist.TextStrokeTransparency = 0
	txtDist.TextStrokeColor3 = Color3.new(0, 0, 0)
	txtDist.Font = Enum.Font.GothamBold
	txtDist.TextSize = 14
	txtDist.Parent = bb

	espData[p] = { highlight = hl, billboard = bb, txtDist = txtDist, char = char }
end

local function updateESP()
	if not espEnabled then
		for p in pairs(espData) do removeESPForPlayer(p) end
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			task.spawn(createESPForPlayer, p)
		end
	end
end

local function hookPlayerESP(p)
	if p == LocalPlayer then return end
	p.CharacterAdded:Connect(function()
		removeESPForPlayer(p)
		if espEnabled then
			task.wait(0.4)
			if espEnabled then createESPForPlayer(p) end
		end
	end)
	p.CharacterRemoving:Connect(function()
		removeESPForPlayer(p)
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	hookPlayerESP(p)
end
Players.PlayerAdded:Connect(function(p)
	hookPlayerESP(p)
	if espEnabled then task.spawn(createESPForPlayer, p) end
end)
Players.PlayerRemoving:Connect(removeESPForPlayer)

task.spawn(function()
	while true do
		task.wait(0.5)
		if not isInstanceAlive() then return end
		if espEnabled then
			local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					local char = p.Character
					local head = char and char:FindFirstChild("Head")
					local data = espData[p]

					if char and head then
						if not data or data.char ~= char or not data.highlight or not data.highlight.Parent or not data.billboard or not data.billboard.Parent then
							task.spawn(createESPForPlayer, p)
							data = espData[p]
						end
					elseif data then
						removeESPForPlayer(p)
						data = nil
					end

					if data and data.txtDist then
						if showEspDistance and char and char:FindFirstChild("HumanoidRootPart") and lhrp then
							local dist = math.floor((lhrp.Position - char.HumanoidRootPart.Position).Magnitude)
							data.txtDist.Text = "[" .. dist .. " studs]"
						else
							data.txtDist.Text = ""
						end
					end
				end
			end
		end
	end
end)

