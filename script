--=====================================================================
-- Auto Collect Logic
--=====================================================================
local autoCollectState = {
	running      = false,
	targets      = {},
	mode         = "Teleport",
	collected    = {},
	attempts     = {},
	busy         = false,
	statusTab    = nil,
	tweenSpeed   = 200,
	delayTime    = 0,
	cancelMove   = nil,
}

local VK_CODES = {
	H = 0x48,
	R = 0x52,
	E = 0x45,
}

local function triggerPromptsOnItem(targetItem, holdTime)
	if not targetItem then return end
	for _, desc in ipairs(targetItem:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			if typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, desc)
			end
			pcall(function()
				desc:InputHoldBegin()
				task.wait(math.max(holdTime or 0.05, desc.HoldDuration + 0.03))
				desc:InputHoldEnd()
			end)
		end
	end
end

local function simulateKey(key, holdTime, targetItem)
	holdTime = holdTime or 0.05
	local kc = Enum.KeyCode[key]
	local vk = VK_CODES[key] or (kc and kc.Value)

	local function smartHoldWait(duration)
		if duration <= 0.25 or not targetItem then
			if duration > 0 then
				task.wait(duration)
			end
			return
		end
		local t0 = os.clock()
		while (os.clock() - t0) < duration do
			if not autoCollectState.running or not targetItem:IsDescendantOf(workspace) then
				break
			end
			task.wait(0.15)
		end
	end

	local vimOk = false
	if kc and VirtualInputManager then
		local ok = pcall(function()
			VirtualInputManager:SendKeyEvent(true, kc, false, game)
		end)
		if ok then
			smartHoldWait(holdTime)
			pcall(function()
				VirtualInputManager:SendKeyEvent(false, kc, false, game)
			end)
			vimOk = true
		end
	end

	if not vimOk and keypress and keyrelease and vk then
		pcall(function()
			keypress(vk)
			smartHoldWait(holdTime)
			keyrelease(vk)
		end)
	end
	return true
end

local function isPileOfMoney(item)
	if not item then return false end
	local rawName = string.lower(item.Name)
	local dispName = string.lower(getDisplayName(item, "World Events"))
	return (string.find(rawName, "pile of money", 1, true) ~= nil)
		or (string.find(dispName, "pile of money", 1, true) ~= nil)
end

local function getCollectAction(item, catName)
	if catName == "Buried Supplies" then
		return {key = "H", holdTime = 1.3, multiHolds = 2, hint = "Holding H for supplies..."}
	elseif catName == "Scrap Barges" then
		return {key = "R", holdTime = 0.05, multiHolds = 1}
	elseif catName == "World Events" then
		if isPileOfMoney(item) then
			return {key = "H", holdTime = 15.0, multiHolds = 1, isMoneyPile = true, hint = "Holding H (15s) for Pile of Money..."}
		else
			return {key = "H", holdTime = 0.02, multiHolds = 1, fastChain = true}
		end
	else
		return {key = "H", holdTime = 0.08, multiHolds = 1}
	end
end

local function getItemsForCategory(catName)
	local items = {}
	if catName == "Spawned Items" then
		local g = workspace:FindFirstChild("Game")
		local c = g and g:FindFirstChild("SpawnedItems")
		if c then
			for _, item in ipairs(collectEntries(c, "Items")) do
				if isValidItem(item, "Items") then table.insert(items, item) end
			end
		end
	elseif catName == "Buried Supplies" then
		local g = workspace:FindFirstChild("Game")
		local gar = g and g:FindFirstChild("Gardening")
		local for_ = gar and gar:FindFirstChild("Foraging")
		if for_ then
			for _, child in ipairs(for_:GetChildren()) do
				if child.Name:match("^BuriedSupplies") then table.insert(items, child) end
			end
		end
	elseif catName == "Scrap Barges" then
		for obj in pairs(scrapPieces) do
			if obj and obj:IsDescendantOf(workspace) then
				table.insert(items, obj)
			end
		end
	elseif catName == "World Events" then
		local g = workspace:FindFirstChild("Game")
		local w = g and g:FindFirstChild("WorldEventDrops")
		if w then
			for _, item in ipairs(collectEntries(w, "World Events")) do
				table.insert(items, item)
			end
		end
	end
	return items
end

local function moveToItem(item, keepAnchoredOnArrive, onComplete)
	local targetPos = getItemPosition(item)
	if not targetPos then
		if onComplete then onComplete(false) end
		return false
	end
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if onComplete then onComplete(false) end
		return false
	end

	local startCF  = hrp.CFrame
	local endCF    = CFrame.new(targetPos + Vector3.new(0, 3, 0))
	local dist     = (startCF.Position - endCF.Position).Magnitude
	local duration = math.max(0.05, dist / math.max(1, autoCollectState.tweenSpeed))

	createTweenVisuals(hrp, item, targetPos)

	hrp.Anchored = true
	local cancelled = false
	autoCollectState.cancelMove = function() cancelled = true end

	local t0 = os.clock()
	while os.clock() - t0 < duration do
		if cancelled or not autoCollectState.running then
			cancelled = true
			break
		end
		local alpha = math.clamp((os.clock() - t0) / duration, 0, 1)
		if hrp and hrp.Parent then
			hrp.CFrame = startCF:Lerp(endCF, alpha)
		end
		local updatedPos = getItemPosition(item)
		if updatedPos and tweenVisuals.targetNode then
			tweenVisuals.targetNode.Position = updatedPos
		end
		task.wait()
	end

	autoCollectState.cancelMove = nil
	clearTweenVisuals()

	if hrp and hrp.Parent then
		if not cancelled and autoCollectState.running then
			hrp.CFrame = endCF
		end
		hrp.Anchored = (keepAnchoredOnArrive == true and not cancelled and autoCollectState.running)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	if onComplete then onComplete(not cancelled) end
	return true
end

local lastLoopFast = false

task.spawn(function()
	while true do
		if lastLoopFast then
			task.wait()
		else
			task.wait(0.25)
		end
		lastLoopFast = false

		if not autoCollectState.running then continue end
		if autoCollectState.busy then continue end

		for inst in pairs(autoCollectState.collected) do
			if not inst:IsDescendantOf(workspace) then
				autoCollectState.collected[inst] = nil
			end
		end
		for inst in pairs(autoCollectState.attempts) do
			if not inst:IsDescendantOf(workspace) then
				autoCollectState.attempts[inst] = nil
			end
		end

		local char = LocalPlayer.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then continue end

		local available = {}
		for targetName in pairs(autoCollectState.targets) do
			local items = getItemsForCategory(targetName)
			for _, item in ipairs(items) do
				if not autoCollectState.collected[item] and item:IsDescendantOf(workspace) then
					local pos = getItemPosition(item)
					if pos then
						table.insert(available, {item = item, pos = pos, catName = targetName})
					end
				end
			end
		end

		if #available == 0 then
			if hrp and hrp.Parent then hrp.Anchored = false end
			if autoCollectState.statusTab and autoCollectState.statusTab.status then
				autoCollectState.statusTab.status.Text = "Waiting for items..."
				autoCollectState.statusTab.status.TextColor3 = C_SUB
			end
			continue
		end

		local ppos = hrp.Position
		table.sort(available, function(a, b)
			return (a.pos - ppos).Magnitude < (b.pos - ppos).Magnitude
		end)

		local targetData = available[1]
		local targetItem = targetData.item
		local targetCat  = targetData.catName
		local name       = getDisplayName(targetItem, targetCat == "World Events" and "World Events" or "Items")
		local action     = getCollectAction(targetItem, targetCat)
		local isFastWorldEvent = (action and action.fastChain == true)
		local isScrapBarge     = (targetCat == "Scrap Barges")

		local att = autoCollectState.attempts[targetItem]
		local retryNum = att and att.count or 0
		local isRetry = (retryNum > 0)

		if autoCollectState.statusTab and autoCollectState.statusTab.status then
			if isRetry then
				autoCollectState.statusTab.status.Text =
					string.format("Retrying %s (%d/%d)", name, retryNum, COLLECT_MAX_TRIES)
				autoCollectState.statusTab.status.TextColor3 = C_WARN
			else
				autoCollectState.statusTab.status.Text = "Collecting: " .. name
				autoCollectState.statusTab.status.TextColor3 = C_OK
			end
		end

		autoCollectState.busy = true

		local distToTarget = (targetData.pos - hrp.Position).Magnitude
		local moved = false

		local retryMoveThreshold = (targetCat == "Buried Supplies") and 2 or 3
		local shouldMove = (distToTarget > 12) or (retryNum >= retryMoveThreshold)

		if shouldMove then
			if autoCollectState.mode == "Teleport" then
				local ok = teleportToItem(targetItem, isScrapBarge)
				moved = ok == true
				if moved then
					if isFastWorldEvent then
						RunService.Heartbeat:Wait()
					elseif isScrapBarge then
						task.wait(0.06)
					else
						task.wait(TELEPORT_SETTLE)
					end
				end
			elseif autoCollectState.mode == "Tween" then
				local ok = false
				moveToItem(targetItem, isScrapBarge, function(s) ok = s end)
				moved = ok
				if moved then
					if isFastWorldEvent then
						RunService.Heartbeat:Wait()
					elseif isScrapBarge then
						task.wait(0.06)
					else
						task.wait(TWEEN_SETTLE)
					end
				end
			end
		else
			if isScrapBarge and hrp and hrp.Parent then
				hrp.Anchored = true
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
			moved = true
		end

		if not autoCollectState.running then
			if hrp and hrp.Parent then hrp.Anchored = false end
			autoCollectState.busy = false
			continue
		end

		if moved and targetItem:IsDescendantOf(workspace) and action then
			if isScrapBarge and hrp and hrp.Parent then
				local bPos = getItemPosition(targetItem)
				if bPos then
					local lookAt = Vector3.new(bPos.X, hrp.Position.Y, bPos.Z)
					if (lookAt - hrp.Position).Magnitude > 0.1 then
						hrp.CFrame = CFrame.new(hrp.Position, lookAt)
					end
				end
			end

			if autoCollectState.statusTab and autoCollectState.statusTab.status then
				if action.hint then
					autoCollectState.statusTab.status.Text = action.hint
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				else
					autoCollectState.statusTab.status.Text = "Pressing " .. action.key .. " for " .. name
					autoCollectState.statusTab.status.TextColor3 = C_OK
				end
			end

			for _ = 1, (action.multiHolds or 1) do
				if not targetItem:IsDescendantOf(workspace) then break end
				if not autoCollectState.running then break end
				if not isScrapBarge then
					task.spawn(triggerPromptsOnItem, targetItem, action.holdTime)
				end
				simulateKey(action.key, action.holdTime, targetItem)
				if not isFastWorldEvent and not isScrapBarge then
					task.wait(0.2)
				end
			end

			if isScrapBarge then
				local waitStart = os.clock()
				while targetItem:IsDescendantOf(workspace) and (os.clock() - waitStart) < 0.75 do
					if not autoCollectState.running then break end
					task.wait(0.05)
				end
			end
		end

		if isScrapBarge and hrp and hrp.Parent then
			hrp.Anchored = false
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end

		if not targetItem:IsDescendantOf(workspace) then
			autoCollectState.collected[targetItem] = true
			autoCollectState.attempts[targetItem]  = nil

			if isFastWorldEvent then
				lastLoopFast = true
			elseif autoCollectState.delayTime and autoCollectState.delayTime > 0 then
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = string.format("Waiting %.1fs...", autoCollectState.delayTime)
					autoCollectState.statusTab.status.TextColor3 = C_SUB
				end
				task.wait(autoCollectState.delayTime)
			end
		else
			local nextAtt = autoCollectState.attempts[targetItem] or {count = 0}
			nextAtt.count += 1
			autoCollectState.attempts[targetItem] = nextAtt

			if nextAtt.count >= COLLECT_MAX_TRIES then
				autoCollectState.collected[targetItem] = true
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = "Gave up: " .. name
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				end
				task.wait(isFastWorldEvent and 0.08 or 0.6)
			else
				task.wait(isFastWorldEvent and 0.08 or (isScrapBarge and 0.45 or COLLECT_RETRY_DELAY))
			end
		end

		autoCollectState.busy = false
	end
end)

