local function playerPosition()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

task.spawn(function()
	while true do
		task.wait(1 / TEXT_HZ)
		if activeTab and not activeTab.isAutoCollect and not activeTab.isMisc and not activeTab.isSpawnRoute then
			local ppos = playerPosition()
			for _, data in pairs(activeTab.state.rows) do
				local p = data.part
				if p and p:IsDescendantOf(workspace) then
					if activeTab.state.showDistance then
						local txt = "Unknown distance"
						if ppos then
							txt = string.format("%d studs", math.round((p.Position - ppos).Magnitude))
						end
						if data.info.Text ~= txt then
							data.info.Text = txt
						end
					else
						if data.info.Text ~= "" then
							data.info.Text = ""
						end
					end
					if data.tp.BackgroundColor3 ~= C_ACCENT then
						data.tp.BackgroundColor3 = C_ACCENT
					end
				else
					if data.info.Text ~= "No BasePart found" then
						data.info.Text = "No BasePart found"
					end
					if data.tp.BackgroundColor3 ~= C_ROW_HOT then
						data.tp.BackgroundColor3 = C_ROW_HOT
					end
				end
			end
		end
	end
end)

