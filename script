	textBox.Font = Enum.Font.Gotham
	textBox.TextSize = 12
	textBox.Text = isInt and string.format("%d", defaultVal) or string.format("%.1f", defaultVal)
	textBox.Parent = container
	corner(textBox, 4)
	stroke(textBox, C_STROKE, 1, 0.35)

	local currentVal = defaultVal

	local function setValue(val)
		currentVal = math.clamp(val, minVal, maxVal)
		if isInt then currentVal = math.round(currentVal) end
		local alpha = (currentVal - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		thumb.Position = UDim2.new(alpha, -8, 0.5, -8)
		textBox.Text = isInt and string.format("%d", currentVal) or string.format("%.1f", currentVal)
		if onChange then onChange(currentVal) end
	end

	textBox.FocusLost:Connect(function()
		local num = tonumber(textBox.Text)
		if num then
			setValue(num)
		else
			textBox.Text = isInt and string.format("%d", currentVal) or string.format("%.1f", currentVal)
		end
	end)

	local dragging = false
	sliderFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local relX = math.clamp((input.Position.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
			setValue(minVal + relX * (maxVal - minVal))
		end
	end)
	sliderFrame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local relX = math.clamp((input.Position.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
			setValue(minVal + relX * (maxVal - minVal))
		end
	end)

	setValue(defaultVal)
end

-- Keybind Manager for Misc Toggles
local registeredKeybinds = {}
local listeningToggle = nil

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local kc = input.KeyCode
	if kc == Enum.KeyCode.Unknown then return end

	if listeningToggle then
		local target = listeningToggle
		listeningToggle = nil
		if kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete or kc == Enum.KeyCode.Escape then
			target.key = nil
			target.btn.Text = "Click to bind"
			target.btn.TextColor3 = C_SUB
		else
			target.key = kc
			target.btn.Text = "[" .. kc.Name .. "]"
			target.btn.TextColor3 = C_TEXT
		end
		return
	end

	if gameProcessed or UserInputService:GetFocusedTextBox() then return end

	for _, entry in ipairs(registeredKeybinds) do
		if entry.key and entry.key == kc then
			entry.toggle()
		end
	end
end)

local function buildToggle(parent, label, yOffset, defaultState, onChange, allowKeybind)
