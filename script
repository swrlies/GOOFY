local MAIN_GAME_PLACE_ID = 128828638194450
local MENU_PLACE_ID      = 130066193263686

local function isStrandedOnMainMenu()
	if game.PlaceId == MENU_PLACE_ID then return true end
	if game.PlaceId ~= MAIN_GAME_PLACE_ID and ReplicatedStorage:FindFirstChild("StandOutCustomization") then
		return true
	end
	local mainGui = PlayerGui:FindFirstChild("Main")
	local choices = mainGui and mainGui.Enabled and mainGui:FindFirstChild("Choices")
	local playCell = choices and choices:FindFirstChild("PlayCell")
	return (playCell and playCell:FindFirstChild("Play") ~= nil) == true
end

local function clickGuiButtonSignal(btn)
	if not btn then return false end
	local fired = false
	if typeof(firesignal) == "function" then
		pcall(function() firesignal(btn.Activated); fired = true end)
		if fired then return true end
	end
	if typeof(getconnections) == "function" then
		for _, sigName in ipairs({"Activated", "MouseButton1Click"}) do
			local ok, conns = pcall(getconnections, btn[sigName])
			if ok and type(conns) == "table" and #conns > 0 then
				for _, c in ipairs(conns) do
					if type(c.Function) == "function" then
						task.spawn(pcall, c.Function)
						fired = true
					elseif type(c.Fire) == "function" then
						task.spawn(pcall, c.Fire, c)
						fired = true
					end
				end
			end
		end
	end
	return fired
end

if isStrandedOnMainMenu() then
	local autoPlayEnabled = false
	local ecoAuto = false
	pcall(function()
		if typeof(isfile) == "function" and typeof(readfile) == "function" then
			if isfile("StandOutHold/_autoplay_menu.txt") then
				autoPlayEnabled = (tostring(readfile("StandOutHold/_autoplay_menu.txt")):gsub("%s+", "") == "1")
			end
			if isfile("StandOutConfigs/_autoload.txt") then
				local autoName = tostring(readfile("StandOutConfigs/_autoload.txt")):gsub("^%s+", ""):gsub("%s+$", "")
				local cfgPath = "StandOutConfigs/" .. autoName .. ".json"
				if autoName ~= "" and isfile(cfgPath) then
					local dec = HttpService:JSONDecode(readfile(cfgPath))
					if type(dec) == "table" then
						local perfTbl = type(dec.perf) == "table" and dec.perf or dec.autoCollect
						if type(perfTbl) == "table" then
							if perfTbl.ecoMode == true then ecoAuto = true end
							if not isfile("StandOutHold/_autoplay_menu.txt") and perfTbl.autoPlay == true then
								autoPlayEnabled = true
							end
						end
					end
				end
			end
		end
	end)

	if ecoAuto and typeof(setfpscap) == "function" then
		pcall(setfpscap, 15)
	end

	if autoPlayEnabled then
		local menuGui = Instance.new("ScreenGui")
		menuGui.Name = "SIM_MenuAutoPlay"
		menuGui.ResetOnSpawn = false
		menuGui.DisplayOrder = 1000
		menuGui.Parent = PlayerGui

		local pill = Instance.new("TextLabel")
		pill.Size = UDim2.fromOffset(264, 28)
		pill.Position = UDim2.new(0.5, -132, 0, 12)
		pill.BackgroundColor3 = Color3.fromRGB(22, 25, 32)
		pill.TextColor3 = Color3.fromRGB(238, 241, 246)
		pill.Font = Enum.Font.GothamBold
		pill.TextSize = 12
		pill.Text = "Stand Out v65: Auto-Play waiting..."
		pill.Parent = menuGui
		local mc = Instance.new("UICorner"); mc.CornerRadius = UDim.new(0, 6); mc.Parent = pill

		local triedRemoteAt = 0
		while isInstanceAlive() and isStrandedOnMainMenu() do
			local ready = (LocalPlayer:GetAttribute("MenuPlayReady") == true)
			local busy  = (LocalPlayer:GetAttribute("MenuPlayBusy") == true)
			local statusAttr = LocalPlayer:GetAttribute("MenuPlayStatus")

			if type(statusAttr) == "string" and statusAttr ~= "" then
				pill.Text = "Auto-Play: " .. statusAttr
			elseif busy then
				pill.Text = "Auto-Play: Teleporting into game..."
			elseif ready then
				pill.Text = "Auto-Play: Clicking Play..."
				local mainGui = PlayerGui:FindFirstChild("Main")
				local playBtn = mainGui and mainGui:FindFirstChild("Choices")
					and mainGui.Choices:FindFirstChild("PlayCell")
					and mainGui.Choices.PlayCell:FindFirstChild("Play")

				local clicked = false
				if playBtn and playBtn.Active then
					clicked = clickGuiButtonSignal(playBtn)
				end
				if (not clicked or (os.clock() - triedRemoteAt) > 6) and (os.clock() - triedRemoteAt) > 3.5 then
					triedRemoteAt = os.clock()
					task.spawn(function()
						local soc = ReplicatedStorage:FindFirstChild("StandOutCustomization")
						local rems = soc and soc:FindFirstChild("Remotes")
						local req = rems and rems:FindFirstChild("Request")
						if req and req:IsA("RemoteFunction") then
							pcall(function() req.InvokeServer(req, "Play") end)
						end
					end)
				end
				task.wait(2.5)
			else
				pill.Text = "Auto-Play: Waiting for menu ready..."
				task.wait(0.5)
			end
		end
		if menuGui then menuGui:Destroy() end
	end
	if game.PlaceId ~= MAIN_GAME_PLACE_ID then return end
end

