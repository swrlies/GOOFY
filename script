local PAGE_PAD_X = 16
local PAGE_WIDTH_OFFSET = -(PAGE_PAD_X * 2)

local function closeAllDropdowns(parent)
	for _, child in ipairs(parent:GetDescendants()) do
		if child:IsA("Frame") and child.Name == "DropdownOptions" then
			child.Visible = false
		elseif child:IsA("Frame") and child.Name == "SIM_DropdownContainer" then
			child.ZIndex = 1
		end
	end
end

local function buildDropdown(parent, label, options, defaultIndex, yOffset, onChange)
	local container = Instance.new("Frame")
	container.Name = "SIM_DropdownContainer"
	container.Size = UDim2.new(1, PAGE_WIDTH_OFFSET, 0, 50)
	container.Position = UDim2.fromOffset(PAGE_PAD_X, yOffset)
