					prev.btn.Text = prev.key and ("[" .. prev.key.Name .. "]") or "Click to bind"
					prev.btn.TextColor3 = prev.key and C_TEXT or C_SUB
				end
				listeningToggle = kbEntry
				kbBtn.Text = "Press key..."
				kbBtn.TextColor3 = C_WARN
			end
		end)
	end

	if onChange then onChange(state) end

	return {
		getState = function()
			return state
		end,
		setState = function(newState)
			setState(newState == true)
		end,
		getKeybind = function()
			return kbEntry and kbEntry.key and kbEntry.key.Name or nil
		end,
		setKeybind = function(keyName)
			if not kbEntry then return end
			if type(keyName) == "string" and keyName ~= "" then
				local ok, kc = pcall(function() return Enum.KeyCode[keyName] end)
				if ok and kc and kc ~= Enum.KeyCode.Unknown then
					kbEntry.key = kc
					kbEntry.btn.Text = "[" .. kc.Name .. "]"
					kbEntry.btn.TextColor3 = C_TEXT
					return
				end
			end
			kbEntry.key = nil
			kbEntry.btn.Text = "Click to bind"
			kbEntry.btn.TextColor3 = C_SUB
		end,
	}
end

