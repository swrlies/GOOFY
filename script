local savedPosition = nil

LocalPlayer.CharacterAdded:Connect(function()
	savedPosition = nil
end)

local function teleportToCFrame(targetCF, keepAnchored)
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, "Character not available." end
	if not savedPosition then savedPosition = hrp.CFrame end
	hrp.Anchored = (keepAnchored == true)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = targetCF
	Camera.CameraType = Enum.CameraType.Custom
	return true
end

local function teleportToPosition(targetPos, keepAnchored)
	return teleportToCFrame(CFrame.new(targetPos + Vector3.new(0, 3, 0)), keepAnchored)
end

local function teleportToItem(item, keepAnchored)
	local pos = getItemPosition(item)
	if not pos then return false, "Item has no position." end
	return teleportToPosition(pos, keepAnchored)
end

local function returnToSaved()
	if not savedPosition then return false, "No saved position." end
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hrp then return false, "Character not available." end
	hrp.Anchored = false
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = savedPosition
	savedPosition = nil
	return true
end

