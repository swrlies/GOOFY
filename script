-- Hook PlayerBounties updates
task.spawn(function()
	local rems = ReplicatedStorage:WaitForChild("Remotes", 15)
	local pb = rems and rems:WaitForChild("PlayerBounties", 15)
	if not (pb and pb:IsA("RemoteEvent")) then return end

	pb.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" or type(payload.State) ~= "string" then return end
		if payload.State == "Completed" then
			elimState.completedCount += 1
			elimState.bounty = { State = "Idle", Message = payload.Message }
			elimState.searchBackoffUntil = os.clock() + 1.0
			releaseElimCharacterLock()
		elseif payload.State == "Cancelled" or (payload.State == "Idle" and payload.SearchFailed) then
			elimState.bounty = { State = "Idle", Message = payload.Message, SearchFailed = payload.SearchFailed }
			if payload.SearchFailed then
				local msgLower = string.lower(tostring(payload.Message or ""))
				local waitSec = msgLower:find("later", 1, true) and 12.0 or 3.5
				elimState.searchBackoffUntil = os.clock() + waitSec
			end
			releaseElimCharacterLock()
		else
			elimState.bounty = payload
		end
	end)

	task.wait(0.4)
	if isInstanceAlive() then
		pcall(function() pb.FireServer(pb, "Sync") end)
	end
end)

