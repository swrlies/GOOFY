local lastLoopFast = false

local function hasAvailableCollectTarget()
	if not autoCollectState.running then return false end
	if getPriorityCache().item ~= nil then
		return true
	end
	if autoCollectState.targets["Scrap Barges"]
		and (not appMod.shouldTryBarge or appMod.shouldTryBarge()) then
		for _, item in ipairs(getItemsForCategory("Scrap Barges")) do
			if not autoCollectState.collected[item] and item:IsDescendantOf(workspace) then
				return true
			end
		end
	end
	return false
end

local function yieldAutoCollectControl()
	if autoCollectState.cancelMove then
		autoCollectState.cancelMove()
		autoCollectState.cancelMove = nil
	end
	clearTweenVisuals()
	autoCollectState.lockedBarge   = nil
	autoCollectState.lockedBargeCF = nil
	autoCollectState.busy          = false
	autoCollectState.busyBarge     = false
	local c = LocalPlayer.Character
	local h = c and c:FindFirstChild("HumanoidRootPart")
	if h then h.Anchored = false end
	local ctrl, u69 = getPlayerController()
	if ctrl then
		resetStuckCombatStates(ctrl, u69)
	end
end

if appMod.registerFarmHandler then
	appMod.registerFarmHandler("AutoCollect", {
		label     = "Auto Collect (Items / Barges)",
		isEnabled = function() return autoCollectState.running == true end,
		setEnabled = function(s)
			if autoCollectState.setRunning then autoCollectState.setRunning(s) end
		end,
		hasWork   = hasAvailableCollectTarget,
		onYield   = yieldAutoCollectControl,
	})
end

task.spawn(function()
	while true do
		if not isInstanceAlive() then return end
		if not autoCollectState.running then
			autoCollectState.busy = false
			task.wait(0.15)
			continue
		end

		if appMod.isFarmOwner and not appMod.isFarmOwner("AutoCollect") then
			local owner = appMod.getActiveFarmOwner()
			if owner then
				if autoCollectState.busy or autoCollectState.busyBarge then
					yieldAutoCollectControl()
				end
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = "Yielded to " .. tostring(owner)
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				end
				task.wait(0.15)
				continue
			elseif appMod.hasOtherRunningFarm and appMod.hasOtherRunningFarm("AutoCollect") then
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = "Waiting for items..."
					autoCollectState.statusTab.status.TextColor3 = C_SUB
				end
				task.wait(0.2)
				continue
			end
		end

		local ok, err = pcall(function()
			for inst in pairs(autoCollectState.collected) do
				if not inst:IsDescendantOf(workspace) then
					autoCollectState.collected[inst] = nil
				end
			end
			for inst in pairs(autoCollectState.attempts) do
				if not inst:IsDescendantOf(workspace) then
					autoCollectState.attempts[inst] = nil
				end
			end

			local char = LocalPlayer.Character
			local hrp  = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end

			local available = {}
			for targetName in pairs(autoCollectState.targets) do
				if targetName == "Scrap Barges" and appMod.shouldTryBarge and not appMod.shouldTryBarge() then
					continue
				end
				local prio = CATEGORY_PRIORITY[targetName] or 2
				local items = getItemsForCategory(targetName)
				for _, item in ipairs(items) do
					if not autoCollectState.collected[item] and item:IsDescendantOf(workspace) then
						local pos = getItemPosition(item)
						if pos then
							table.insert(available, {
								item = item, pos = pos,
								catName = targetName, priority = prio,
							})
						end
					end
				end
			end

			if #available == 0 then
				if hrp and hrp.Parent then hrp.Anchored = false end

				local origin = savedPosition or autoCollectState.originCFrame
				local otherFarmActive = appMod.hasOtherRunningFarm and appMod.hasOtherRunningFarm("AutoCollect")
				local hideActive = appMod.isHideWhileWaitingEnabled and appMod.isHideWhileWaitingEnabled()
				if origin and hrp and hrp.Parent and not autoCollectState.returnedToOrigin and not otherFarmActive and not hideActive then
					if (hrp.Position - origin.Position).Magnitude > 15 then
						if autoCollectState.statusTab and autoCollectState.statusTab.status then
							autoCollectState.statusTab.status.Text = "Returning to origin..."
							autoCollectState.statusTab.status.TextColor3 = C_SUB
						end
						local returnedOk = false
						if autoCollectState.mode == "Tween" then
							returnedOk = moveToCFrame(origin, nil, origin.Position, false)
						else
							returnedOk = (teleportToCFrame(origin, false) == true)
						end
						if returnedOk then
							autoCollectState.returnedToOrigin = true
						end
					else
						autoCollectState.returnedToOrigin = true
					end
				end

				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = "Waiting for items..."
					autoCollectState.statusTab.status.TextColor3 = C_SUB
				end
				task.wait(0.25)
				return
			end

			local ppos = hrp.Position
			table.sort(available, function(a, b)
				if a.priority ~= b.priority then return a.priority < b.priority end
				return (a.pos - ppos).Magnitude < (b.pos - ppos).Magnitude
			end)

			local targetData       = available[1]
			local targetItem       = targetData.item
			local targetCat        = targetData.catName
			local currentPriority  = targetData.priority
			local name             = getDisplayName(targetItem, targetCat == "World Events" and "World Events" or "Items")
			local action           = getCollectAction(targetItem, targetCat)
			local isFastWorldEvent = (action and action.fastChain == true)
			local isScrapBarge     = (targetCat == "Scrap Barges")

			local att      = autoCollectState.attempts[targetItem]
			local retryNum = att and att.count or 0
			local isRetry  = (retryNum > 0)

			if autoCollectState.statusTab and autoCollectState.statusTab.status then
				if isRetry then
					autoCollectState.statusTab.status.Text =
						string.format("Retrying %s (%d/%d)", name, retryNum, COLLECT_MAX_TRIES)
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				else
					autoCollectState.statusTab.status.Text = "Collecting: " .. name
					autoCollectState.statusTab.status.TextColor3 = C_OK
				end
			end

			autoCollectState.busy = true
			autoCollectState.returnedToOrigin = false

			if isScrapBarge then
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = string.format("Barge %s: attempting (%d/%d)",
						name, retryNum + 1, COLLECT_MAX_TRIES)
					autoCollectState.statusTab.status.TextColor3 = C_OK
				end

				local function shouldInterruptBarge()
					return shouldPreempt(currentPriority, targetItem)
				end

				local preBreakSnap = appMod.snapshotRewardState and appMod.snapshotRewardState() or nil
				local isProbeBreak = (appMod.consumeBargeProbeFlag and appMod.consumeBargeProbeFlag() == true)
				local broke, reason = attemptBreakBarge(targetItem, shouldInterruptBarge)

				if broke then
					autoCollectState.collected[targetItem] = true
					autoCollectState.attempts[targetItem]  = nil
					rescanScrapPieces()
					updateScrapBeacons()
					if appMod.onBargeBroken then
						appMod.onBargeBroken(preBreakSnap, reason, isProbeBreak)
					end
					if autoCollectState.statusTab and autoCollectState.statusTab.status then
						autoCollectState.statusTab.status.Text = (isProbeBreak and "Hold test barge broken (" or "Broke barge (") .. reason .. ")"
						autoCollectState.statusTab.status.TextColor3 = C_OK
					end
					autoCollectState.busy = false
					return
				end

				if reason == "preempt" then
					autoCollectState.busy = false
					if autoCollectState.statusTab and autoCollectState.statusTab.status then
						autoCollectState.statusTab.status.Text = "Barge preempted for higher priority"
						autoCollectState.statusTab.status.TextColor3 = C_WARN
					end
					return
				end

				if reason == "stopped" or reason == "no-hrp" or reason == "no-pos" then
					autoCollectState.busy = false
					return
				end

				local nextAtt = autoCollectState.attempts[targetItem] or {count = 0}
				nextAtt.count += 1
				autoCollectState.attempts[targetItem] = nextAtt

				if nextAtt.count >= COLLECT_MAX_TRIES then
					autoCollectState.collected[targetItem] = true
					autoCollectState.attempts[targetItem]  = nil
					if autoCollectState.statusTab and autoCollectState.statusTab.status then
						autoCollectState.statusTab.status.Text = "Gave up on barge after " .. COLLECT_MAX_TRIES .. " tries"
						autoCollectState.statusTab.status.TextColor3 = C_ERR
					end
					autoCollectState.busy = false
					interruptibleWait(0.5, currentPriority, targetItem)
					return
				end

				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = string.format("Barge retry %d/%d", nextAtt.count, COLLECT_MAX_TRIES)
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				end

				interruptibleWait(0.25, currentPriority, targetItem)
				autoCollectState.busy = false
				return
			end

			local distToTarget = (targetData.pos - hrp.Position).Magnitude
			local moved        = false
			local preempted    = false

			local retryMoveThreshold = (targetCat == "Buried Supplies") and 2 or 3
			local shouldMove = (distToTarget > 12) or (retryNum >= retryMoveThreshold)

			if shouldMove then
				if autoCollectState.mode == "Teleport" then
					local targetCF = CFrame.new(targetData.pos + Vector3.new(0, 3, 0))
					local okMove = teleportToCFrame(targetCF, false)
					moved = okMove == true
					if moved then
						local settleDur = isFastWorldEvent and 0.02 or TELEPORT_SETTLE
						local _, reason = interruptibleWait(settleDur, currentPriority, targetItem)
						if reason == "preempt" then preempted = true end
					end
				elseif autoCollectState.mode == "Tween" then
					local okMove = false
					moveToItem(targetItem, function(s) okMove = s end)
					moved = okMove
					if moved then
						local settleDur = isFastWorldEvent and 0.02 or TWEEN_SETTLE
						local _, reason = interruptibleWait(settleDur, currentPriority, targetItem)
						if reason == "preempt" then preempted = true end
					end
				end
			else
				moved = true
			end

			if preempted then
				autoCollectState.busy = false
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = "Preempted for higher priority"
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				end
				return
			end

			if not autoCollectState.running then
				autoCollectState.busy = false
				return
			end

			if moved and not isItemCollectedState(targetItem) and action then
				if targetCat == "Spawned Items" or targetCat == "World Events" or targetCat == "Buried Supplies" then
					waitUntilStable(0.5)
				end

				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					if action.hint then
						autoCollectState.statusTab.status.Text = action.hint
						autoCollectState.statusTab.status.TextColor3 = C_WARN
					else
						autoCollectState.statusTab.status.Text = "Collecting: " .. name
						autoCollectState.statusTab.status.TextColor3 = C_OK
					end
				end

				local function shouldInterrupt()
					return shouldPreempt(currentPriority, targetItem)
				end

				local lastMethod = nil
				for _ = 1, (action.multiHolds or 1) do
					if isItemCollectedState(targetItem) then break end
					if not autoCollectState.running then break end
					if shouldInterrupt() then preempted = true; break end

					local interactOk = triggerInteractOnItem(targetItem, shouldInterrupt)
					if interactOk then lastMethod = "prompt/remote" end

					if not isItemCollectedState(targetItem) then
						local keyOk, method = simulateKey(action.key, action.holdTime, targetItem, shouldInterrupt)
						if keyOk and method then lastMethod = method end
					end

					if not isFastWorldEvent then
						local _, reason = interruptibleWait(0.2, currentPriority, targetItem)
						if reason == "preempt" then preempted = true; break end
					end
				end

				if lastMethod and autoCollectState.statusTab and autoCollectState.statusTab.status
						and not preempted and not isItemCollectedState(targetItem) then
					autoCollectState.statusTab.status.Text =
						string.format("Triggered via %s (%s)", lastMethod, name)
				end
			end

			if preempted then
				autoCollectState.busy = false
				return
			end

			if isItemCollectedState(targetItem) then
				autoCollectState.collected[targetItem] = true
				autoCollectState.attempts[targetItem]  = nil

				if isFastWorldEvent then
					lastLoopFast = true
				elseif autoCollectState.delayTime and autoCollectState.delayTime > 0 then
					if autoCollectState.statusTab and autoCollectState.statusTab.status then
						autoCollectState.statusTab.status.Text = string.format("Waiting %.1fs...", autoCollectState.delayTime)
						autoCollectState.statusTab.status.TextColor3 = C_SUB
					end
					interruptibleWait(autoCollectState.delayTime, currentPriority, targetItem)
				end
			else
				local nextAtt = autoCollectState.attempts[targetItem] or {count = 0}
				nextAtt.count += 1
				autoCollectState.attempts[targetItem] = nextAtt

				if nextAtt.count >= COLLECT_MAX_TRIES then
					autoCollectState.collected[targetItem] = true
					if autoCollectState.statusTab and autoCollectState.statusTab.status then
						autoCollectState.statusTab.status.Text = "Gave up: " .. name
						autoCollectState.statusTab.status.TextColor3 = C_WARN
					end
					task.wait(isFastWorldEvent and 0.03 or 0.5)
				else
					if isFastWorldEvent then
						lastLoopFast = true
					else
						interruptibleWait(COLLECT_RETRY_DELAY, currentPriority, targetItem)
					end
				end
			end

			autoCollectState.busy = false
		end)

		if not ok then
			warn("[AutoCollect] Recovered from loop error:", err)
			autoCollectState.busy = false
			autoCollectState.busyBarge = false
			autoCollectState.lockedBarge = nil
			autoCollectState.lockedBargeCF = nil
			local c = LocalPlayer.Character
			local h = c and c:FindFirstChild("HumanoidRootPart")
			if h then h.Anchored = false end
			local stopCtrl, stopU69 = getPlayerController()
			if stopCtrl then
				resetStuckCombatStates(stopCtrl, stopU69)
			end
			task.wait(0.5)
		end

		if not lastLoopFast then
			task.wait(0.15)
		end
		lastLoopFast = false
	end
end)

