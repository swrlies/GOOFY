		kbBtn.MouseButton1Click:Connect(function()
			if listeningToggle == kbEntry then
				listeningToggle = nil
				kbBtn.Text = kbEntry.key and ("[" .. kbEntry.key.Name .. "]") or "Click to bind"
				kbBtn.TextColor3 = kbEntry.key and C_TEXT or C_SUB
			else
