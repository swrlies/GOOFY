		local coord = appMod.farmPriority
		if not coord then return end

		local activeOwner = coord.currentOwner
		local enabledCount = 0
		for _, k in ipairs(coord.order) do
			local h = coord.handlers[k]
			if h and h.isEnabled and h.isEnabled() then
				enabledCount += 1
			end
		end

		local ownerLabel = (activeOwner and coord.handlers[activeOwner] and coord.handlers[activeOwner].label) or "None"
		prioRefs.ownerLbl.Text = string.format("Active: %s  |  Enabled: %d/3", ownerLabel, enabledCount)
		prioRefs.ownerLbl.TextColor3 = activeOwner and C_OK or C_SUB

		if prioRefs.masterBtn then
			if enabledCount > 0 then
				prioRefs.masterBtn.Text = "Stop All Farms (" .. enabledCount .. " ON)"
				prioRefs.masterBtn.BackgroundColor3 = C_ERR
			else
				prioRefs.masterBtn.Text = "Start All Farms"
				prioRefs.masterBtn.BackgroundColor3 = C_ACCENT
			end
		end

		for rank, k in ipairs(coord.order) do
			local card = prioRefs.cards[k]
			local h = coord.handlers[k]
			if card and h then
				card.frame.LayoutOrder = rank
