--=====================================================================
-- Anti-Farm Hold / Cap Tracker (OceanCratesPerHour = 20, WorldItemsCapped)
--=====================================================================
;(function()
	local HOLD_WINDOW_SEC   = 3600
	local OCEAN_CRATE_CAP   = 20
	local PROBE_INTERVAL_SEC = 180 -- test 1 barge every 3 minutes during hold
	local HOLD_DIR          = "StandOutHold"
	local uid               = tostring(LocalPlayer.UserId or 0)
	local holdFile          = HOLD_DIR .. "/barge_" .. uid .. ".json"
	local holdLabelRef      = autoCollectState.holdLbl
	local bargeTimestamps   = {}
	local holdDetectedAt    = nil
	local nextProbeAt       = nil
	local pendingProbeFlag  = false
	local lastOceanFoundAt  = 0

	-- Hook Beachcombing "Found" remote event (catches Coins, Scrap, Steel, Arrows, Outfits)
	task.spawn(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 10)
		local bc = remotes and (remotes:FindFirstChild("Beachcombing") or remotes:WaitForChild("Beachcombing", 10))
		if bc and bc:IsA("RemoteEvent") then
			bc.OnClientEvent:Connect(function(kind)
				if not isInstanceAlive() then return end
				if kind == "Found" then
					lastOceanFoundAt = os.clock()
				end
			end)
		end
	end)

	local function hasHoldFileApi()
		return typeof(isfolder) == "function" and typeof(makefolder) == "function"
			and typeof(writefile) == "function" and typeof(readfile) == "function"
			and typeof(isfile) == "function"
	end

	local function cleanupLegacyHoldFiles()
		if typeof(isfolder) ~= "function" or typeof(listfiles) ~= "function" or typeof(delfile) ~= "function" then
			return
		end
		pcall(function()
			if not isfolder("StandOutConfigs") then return end
			for _, full in ipairs(listfiles("StandOutConfigs")) do
				local name = tostring(full):match("([^/\\]+)$")
				if name and name:match("^_barge_hold_.*%.json$") then
					pcall(delfile, full)
				end
			end
		end)
	end

	local function pruneHistory(nowSec)
		local kept = {}
		for _, ts in ipairs(bargeTimestamps) do
			if type(ts) == "number" and (nowSec - ts) < HOLD_WINDOW_SEC and ts <= (nowSec + 60) then
				table.insert(kept, ts)
			end
		end
		table.sort(kept)
		bargeTimestamps = kept
		if holdDetectedAt and (nowSec - holdDetectedAt) >= HOLD_WINDOW_SEC then
			holdDetectedAt = nil
		end
	end

	local function isHoldActive(nowSec)
		pruneHistory(nowSec)
		return (holdDetectedAt ~= nil) or (#bargeTimestamps >= OCEAN_CRATE_CAP)
	end

	local function saveHoldFile()
		if not hasHoldFileApi() then return end
		pcall(function()
			if not isfolder(HOLD_DIR) then makefolder(HOLD_DIR) end
			writefile(holdFile, HttpService:JSONEncode({
				version        = 2,
				timestamps     = bargeTimestamps,
				holdDetectedAt = holdDetectedAt,
				nextProbeAt    = nextProbeAt,
			}))
		end)
	end

	local function loadHoldFile()
		cleanupLegacyHoldFiles()
		if not hasHoldFileApi() then return end
		pcall(function()
			if not isfile(holdFile) then return end
			local raw = readfile(holdFile)
			local dec = HttpService:JSONDecode(raw)
			if type(dec) == "table" and dec.version == 2 then
				if type(dec.timestamps) == "table" then
					bargeTimestamps = dec.timestamps
				end
				if type(dec.holdDetectedAt) == "number" then
					holdDetectedAt = dec.holdDetectedAt
				end
				if type(dec.nextProbeAt) == "number" then
					nextProbeAt = dec.nextProbeAt
				end
			end
		end)
		local nowSec = os.time()
		pruneHistory(nowSec)
		if isHoldActive(nowSec) and (not nextProbeAt or nextProbeAt < nowSec) then
			nextProbeAt = nowSec + PROBE_INTERVAL_SEC
		end
	end

	local function fmtMinSec(sec)
		sec = math.max(0, math.floor(sec + 0.5))
		return string.format("%02d:%02d", math.floor(sec / 60), sec % 60)
	end

	local function updateHoldLabel()
		if not holdLabelRef or not holdLabelRef.Parent then return end
		local nowSec = os.time()
		local holding = isHoldActive(nowSec)

		local itemsCapped = (LocalPlayer:GetAttribute("WorldItemsCapped") == true)
		local arrowPart = itemsCapped and "Arrows: CAPPED" or "Arrows: OK"

		local count = #bargeTimestamps
		local shownCount = math.min(count, OCEAN_CRATE_CAP)
		local bargePart
		local textColor = C_SUB

		if holding then
			local probeRem = nextProbeAt and math.max(0, nextProbeAt - nowSec) or 0
			local probeStr = (probeRem <= 0) and "Testing next" or ("Test " .. fmtMinSec(probeRem))
			if count >= OCEAN_CRATE_CAP then
				local oldestActive = bargeTimestamps[count - OCEAN_CRATE_CAP + 1]
				local slotRem = math.max(0, HOLD_WINDOW_SEC - (nowSec - oldestActive))
				bargePart = string.format("HOLD %s (%s)", fmtMinSec(slotRem), probeStr)
			else
				bargePart = string.format("HOLD Active (%s)", probeStr)
			end
			textColor = C_WARN
		else
			bargePart = string.format("Barges (1h): %d/%d Ready", shownCount, OCEAN_CRATE_CAP)
			textColor = (shownCount > 0) and C_OK or C_SUB
		end

		if itemsCapped then
			textColor = C_ERR
		end

		holdLabelRef.Text = bargePart .. " | " .. arrowPart
		holdLabelRef.TextColor3 = textColor
	end

	local function readStatsSnapshot()
		local data  = LocalPlayer:FindFirstChild("Data")
		local stats = data and data:FindFirstChild("Stats")
		local inv   = stats and stats:FindFirstChild("Inventory")
		local pts   = stats and stats:FindFirstChild("Points")
		local coins = stats and stats:FindFirstChild("Coins")
		local bc    = stats and stats:FindFirstChild("BoundCoins")
		return {
			inv    = inv and tostring(inv.Value) or nil,
			pts    = pts and tonumber(pts.Value) or nil,
			coins  = coins and tonumber(coins.Value) or nil,
			bcoins = bc and tonumber(bc.Value) or nil,
			clock  = os.clock(),
		}
	end

	appMod.snapshotRewardState = readStatsSnapshot

	appMod.shouldTryBarge = function()
		local nowSec = os.time()
		if not isHoldActive(nowSec) then
			pendingProbeFlag = false
			return true
		end
		if not nextProbeAt then
			nextProbeAt = nowSec + PROBE_INTERVAL_SEC
			saveHoldFile()
			return false
		end
		if nowSec >= nextProbeAt then
			pendingProbeFlag = true
			return true
		end
		return false
	end

	appMod.consumeBargeProbeFlag = function()
		local was = pendingProbeFlag
		pendingProbeFlag = false
		return was
	end

	appMod.requestHoldProbeNow = function()
		nextProbeAt = 0
		updateHoldLabel()
	end

	appMod.onBargeBroken = function(preSnap, breakReason, wasProbe)
		-- Only schedule the probe cooldown once we actually break one
		if wasProbe then
			nextProbeAt = os.time() + PROBE_INTERVAL_SEC
		end
		task.spawn(function()
			local isPreBroken = (breakReason == "already-broken")
			local waitBudget  = isPreBroken and 0.6 or 1.8
			local gotReward   = false

			if preSnap then
				local t0 = os.clock()
				while os.clock() - t0 < waitBudget do
					local cur = readStatsSnapshot()
					if (preSnap.inv ~= nil and cur.inv ~= nil and cur.inv ~= preSnap.inv)
						or (preSnap.coins and cur.coins and cur.coins > preSnap.coins)
						or (preSnap.bcoins and cur.bcoins and cur.bcoins > preSnap.bcoins)
						or (preSnap.pts and cur.pts and cur.pts ~= preSnap.pts)
						or (lastOceanFoundAt > preSnap.clock) then
						gotReward = true
						break
					end
					task.wait(0.1)
				end
			end

			local nowSec = os.time()
			pruneHistory(nowSec)

			if gotReward then
				holdDetectedAt = nil
				nextProbeAt = nil
				-- If a periodic probe succeeded while >=20 were tracked locally, free slots cleanly
				while #bargeTimestamps >= OCEAN_CRATE_CAP do
					table.remove(bargeTimestamps, 1)
				end
				table.insert(bargeTimestamps, nowSec)
			elseif not isPreBroken then
				holdDetectedAt = holdDetectedAt or nowSec
				nextProbeAt = nowSec + PROBE_INTERVAL_SEC
			end

			saveHoldFile()
			updateHoldLabel()
		end)
	end

	appMod.bindHoldLabel = function(lbl)
		holdLabelRef = lbl
		updateHoldLabel()
	end

	loadHoldFile()
	LocalPlayer:GetAttributeChangedSignal("WorldItemsCapped"):Connect(function()
		if isInstanceAlive() then updateHoldLabel() end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if not isInstanceAlive() then return end
			updateHoldLabel()
		end
	end)
end)()

