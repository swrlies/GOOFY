local notifCounter = 0
local lastNotifTime = {}

local function notifySpawn(item, tabName)
	local name = getDisplayName(item, tabName)
	local now = os.clock()
	
	if tabName == "Items" and not isValidItem(item, tabName) then
		return
	end

	if lastNotifTime[name] and (now - lastNotifTime[name]) < 2 then
		return
	end
	lastNotifTime[name] = now

	notifCounter += 1
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 40)
	label.BackgroundTransparency = 1
	if tabName == "Cases" then
		label.Text = name .. " detected!"
	else
		label.Text = name .. " spawned!"
	end
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 1
	label.TextTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 28
	label.LayoutOrder = notifCounter
	label.Parent = notifFrame

	TweenService:Create(label, TweenInfo.new(0.2), {
		TextTransparency = 0, TextStrokeTransparency = 0,
	}):Play()

	task.delay(2.5, function()
		if not label or not label.Parent then return end
		TweenService:Create(label, TweenInfo.new(0.6), {
			TextTransparency = 1, TextStrokeTransparency = 1,
		}):Play()
		task.wait(0.7)
		if label then label:Destroy() end
	end)
end

