		textLbl.Font = Enum.Font.Gotham
		textLbl.TextSize = 12
		textLbl.TextColor3 = C_TEXT
		textLbl.BackgroundTransparency = 1
		textLbl.Position = UDim2.fromOffset(28, 0)
		textLbl.Size = UDim2.new(1, -34, 1, 0)
		textLbl.TextXAlignment = Enum.TextXAlignment.Left
		textLbl.ZIndex = 22
		textLbl.Parent = optBtn

		optUI[opt] = { checkBg = checkBg, checkMark = checkMark }

		optBtn.MouseEnter:Connect(function() optBtn.BackgroundColor3 = C_ROW_HOT end)
		optBtn.MouseLeave:Connect(function() optBtn.BackgroundColor3 = C_PANEL end)

		optBtn.MouseButton1Click:Connect(function()
			if selected[opt] then
				selected[opt] = nil
				checkBg.BackgroundColor3 = C_BG
				checkMark.Visible = false
			else
				selected[opt] = true
				checkBg.BackgroundColor3 = C_ACCENT_DIM
				checkMark.Visible = true
			end
			updateButtonText(true)
		end)
	end

	return {
		getValue = function()
			local list = {}
			for _, opt in ipairs(options) do
				if selected[opt] then
					table.insert(list, opt)
				end
			end
			return list
		end,
		setValue = function(tblOrArr, fireCb)
			table.clear(selected)
			if type(tblOrArr) == "table" then
				for k, v in pairs(tblOrArr) do
					if type(k) == "number" and type(v) == "string" and optUI[v] then
						selected[v] = true
					elseif type(k) == "string" and v == true and optUI[k] then
						selected[k] = true
					end
				end
			end
			for opt, ui in pairs(optUI) do
				local on = selected[opt] == true
				ui.checkBg.BackgroundColor3 = on and C_ACCENT_DIM or C_BG
				ui.checkMark.Visible = on
			end
			updateButtonText(fireCb)
		end,
	}
end

local function buildSlider(parent, label, minVal, maxVal, defaultVal, yOffset, isInt, onChange)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, PAGE_WIDTH_OFFSET, 0, 50)
	container.Position = UDim2.fromOffset(PAGE_PAD_X, yOffset)
	container.BackgroundTransparency = 1
	container.Parent = parent

	local labelLbl = Instance.new("TextLabel")
	labelLbl.Text = label
	labelLbl.Font = Enum.Font.GothamBold
	labelLbl.TextSize = 11
	labelLbl.TextColor3 = C_SUB
	labelLbl.BackgroundTransparency = 1
	labelLbl.Size = UDim2.new(1, 0, 0, 16)
	labelLbl.TextXAlignment = Enum.TextXAlignment.Left
	labelLbl.Parent = container

	local sliderFrame = Instance.new("Frame")
	sliderFrame.Size = UDim2.new(1, -72, 0, 20)
	sliderFrame.Position = UDim2.new(0, 4, 0, 18)
	sliderFrame.BackgroundTransparency = 1
	sliderFrame.Parent = container

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 4)
	track.Position = UDim2.new(0, 0, 0.5, -2)
	track.BackgroundColor3 = C_ROW_HOT
	track.BorderSizePixel = 0
	track.Parent = sliderFrame
	corner(track, 2)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = C_ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = track
	corner(fill, 2)

	local thumb = Instance.new("Frame")
	thumb.Size = UDim2.fromOffset(14, 14)
	thumb.Position = UDim2.new(0, -7, 0.5, -7)
	thumb.BackgroundColor3 = C_TEXT
	thumb.BorderSizePixel = 0
	thumb.Parent = sliderFrame
	corner(thumb, 7)
	stroke(thumb, C_ACCENT, 1.5, 0.25)

	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.fromOffset(52, 24)
	textBox.Position = UDim2.new(1, -52, 0, 16)
	textBox.BackgroundColor3 = C_PANEL
	textBox.TextColor3 = C_TEXT
	textBox.Font = Enum.Font.GothamBold
	textBox.TextSize = 11
	textBox.Text = isInt and string.format("%d", defaultVal) or string.format("%.1f", defaultVal)
	textBox.Parent = container
	corner(textBox, 5)
	stroke(textBox, C_STROKE, 1, 0.45)

	local currentVal = defaultVal

	local function setValue(val)
		currentVal = math.clamp(val, minVal, maxVal)
		if isInt then currentVal = math.round(currentVal) end
		local alpha = (currentVal - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		thumb.Position = UDim2.new(alpha, -7, 0.5, -7)
		textBox.Text = isInt and string.format("%d", currentVal) or string.format("%.1f", currentVal)
		if onChange then onChange(currentVal) end
	end

	textBox.FocusLost:Connect(function()
		local num = tonumber(textBox.Text)
		if num then
			setValue(num)
		else
			textBox.Text = isInt and string.format("%d", currentVal) or string.format("%.1f", currentVal)
		end
	end)

	local dragging = false
	sliderFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local relX = math.clamp((input.Position.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
			setValue(minVal + relX * (maxVal - minVal))
		end
	end)
	sliderFrame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local relX = math.clamp((input.Position.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
			setValue(minVal + relX * (maxVal - minVal))
		end
	end)

	setValue(defaultVal)

	return {
		getValue = function()
			return currentVal
		end,
		setValue = function(val)
			if type(val) == "number" then
				setValue(val)
			end
		end,
	}
end

local registeredKeybinds = {}
local listeningToggle = nil

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not isInstanceAlive() then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local kc = input.KeyCode
	if kc == Enum.KeyCode.Unknown then return end

	if listeningToggle then
		local target = listeningToggle
		listeningToggle = nil
		if kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete or kc == Enum.KeyCode.Escape then
			target.key = nil
			target.btn.Text = "Click to bind"
			target.btn.TextColor3 = C_SUB
		else
			target.key = kc
			target.btn.Text = "[" .. kc.Name .. "]"
			target.btn.TextColor3 = C_TEXT
		end
		return
	end

	if gameProcessed or UserInputService:GetFocusedTextBox() then return end

	for _, entry in ipairs(registeredKeybinds) do
		if entry.key and entry.key == kc then
			entry.toggle()
		end
	end
end)

