local function notifySpawn(item, tabName)
	local name = getDisplayName(item, tabName)
	local now = os.clock()

	if tabName == "Items" and not isValidItem(item, tabName) then return end
	if lastNotifTime[name] and (now - lastNotifTime[name]) < 2 then return end
	lastNotifTime[name] = now

	notifCounter += 1
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 40)
	label.BackgroundTransparency = 1
	if tabName == "Cases" then
