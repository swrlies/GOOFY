local caseCount = #STATIC_CASES

local function scanForCases()
	local localProps = workspace:FindFirstChild("LocalProps")
	if not localProps then return end

	for _, child in localProps:GetChildren() do
		if child.Name == "Case" then
			local pos
			if child:IsA("BasePart") then pos = child.Position
			elseif child:IsA("Model") then pos = child:GetPivot().Position end

			if pos then
				local isSaved = false
				for _, beacon in caseBeaconFolder:GetChildren() do
					if (beacon.Position - pos).Magnitude < 15 then
						isSaved = true
						break
					end
				end

				if not isSaved then
					caseCount += 1
					local beacon = Instance.new("Part")
					beacon.Name = "Case " .. caseCount
					beacon.Position = pos
					beacon.Anchored = true
					beacon.CanCollide = false
					beacon.Transparency = 1
					beacon.Size = Vector3.new(1, 1, 1)
					beacon.Parent = caseBeaconFolder
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		if not isInstanceAlive() then return end
		scanForCases()
		task.wait(2)
	end
end)

