local function setCharacterNoclipState(st, char, enabled)
	if not char then return end
	st.noclipModified = st.noclipModified or {}
	if enabled then
		if st.noclipChar ~= char or not st.noclipParts then
			st.noclipChar = char
			local parts = {}
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					local n = part.Name
					if part.CanCollide or n == "HumanoidRootPart" or n == "Torso" or n == "Head"
						or n == "UpperTorso" or n == "LowerTorso"
						or n == "Left Arm" or n == "Right Arm" or n == "Left Leg" or n == "Right Leg" then
						table.insert(parts, part)
					end
				end
			end
			st.noclipParts = parts
		end
		for _, part in ipairs(st.noclipParts) do
			if part and part.Parent and part.CanCollide then
				st.noclipModified[part] = true
				part.CanCollide = false
			end
		end
	else
		for part in pairs(st.noclipModified) do
			if part and part.Parent and part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
		table.clear(st.noclipModified)
	end
end

local function applyCharacterLatchCFrame(st, char, hrp, tCF)
	local flatLook = Vector3.new(tCF.LookVector.X, 0, tCF.LookVector.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	local offset = math.clamp(tonumber(st.latchDistance) or 4.5, 1.5, 10)
	local mode = st.latchMode or "Behind"
	st.lastTargetY = tCF.Position.Y

	if hrp.Anchored and not autoCollectState.busyBarge then
		hrp.Anchored = false
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	if mode == "Above (Face Down)" then
		setCharacterNoclipState(st, char, true)
		st.usedNoclipLatch = true
		local abovePos = Vector3.new(tCF.Position.X, tCF.Position.Y + offset, tCF.Position.Z)
		hrp.CFrame = CFrame.lookAt(abovePos, tCF.Position, flatLook)
	elseif mode == "Below (Face Up)" then
		setCharacterNoclipState(st, char, true)
		st.usedNoclipLatch = true
		local belowPos = Vector3.new(tCF.Position.X, tCF.Position.Y - offset, tCF.Position.Z)
		hrp.CFrame = CFrame.lookAt(belowPos, tCF.Position, flatLook)
	else
		if st.usedNoclipLatch then
			setCharacterNoclipState(st, char, false)
			st.usedNoclipLatch = false
		end
		local behindPos = Vector3.new(tCF.Position.X - flatLook.X * offset, tCF.Position.Y, tCF.Position.Z - flatLook.Z * offset)
		local facePos = Vector3.new(tCF.Position.X, behindPos.Y, tCF.Position.Z)
		hrp.CFrame = CFrame.lookAt(behindPos, facePos)
	end
end

local function releaseCharacterLockState(st)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and not autoCollectState.busyBarge then
		if st.usedNoclipLatch and st.lastTargetY then
			local safeY = math.max(hrp.Position.Y, st.lastTargetY + 2.5)
			hrp.CFrame = CFrame.new(hrp.Position.X, safeY, hrp.Position.Z)
		end
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	if char then
		setCharacterNoclipState(st, char, false)
	elseif st.noclipModified then
		table.clear(st.noclipModified)
	end
	st.usedNoclipLatch = false
	st.m1ComboCount = 0
	if hum then
		hum.AutoRotate = true
	end
	local ctrl, u69 = getPlayerController()
	if ctrl then
		resetStuckCombatStates(ctrl, u69)
	end
end

local function runComboCombatStep(st, char, hrp, targetModel, tHrp)
	local now = os.clock()
	local data = LocalPlayer:FindFirstChild("Data")
	local skillBusy = data and data:FindFirstChild("SkillActive") and data.SkillActive.Value == true
	local isStunned = (char:GetAttribute("Stunned") == true)
	if skillBusy or isStunned or now < (st.attackBusyUntil or 0) then
		return false
	end

	-- Ensure equipped Stand is fully summoned & visible before executing ANY attack or skill
	if getEquippedStandName() ~= "" then
		local standOut = isStandProperlySummoned(char)
		if not standOut then
			if (now - (st.lastSummonAt or 0)) >= 0.45 then
				st.lastSummonAt = now
				ensureStandReadyForBarge(char, hrp)
			end
			if not isStandProperlySummoned(char) then
				return false
			end
		end
	end

	local distToTarget = (hrp.Position - tHrp.Position).Magnitude
	if distToTarget > ((st.latchDistance or 4.5) + 6) then
		return false
	end

	local nReq = math.max(0, math.floor(tonumber(st.m1BeforeMove) or 0))
	local needBuildM1 = st.autoLight and (nReq > 0) and ((st.m1ComboCount or 0) < nReq)

	if needBuildM1 then
		st.lastLightAt = now
		st.m1ComboCount = (st.m1ComboCount or 0) + 1
		local _, lightDur = fireLightSwing(targetModel, st)
		st.attackBusyUntil = now + (lightDur or 0.34)
		return true
	end

	local exOk, exDur = tryCastSelectedEX(targetModel, tHrp, st)
	if exOk then
		st.m1ComboCount = 0
		st.attackBusyUntil = now + (exDur or 0.18)
		return true
	end

	local skOk, skDur = tryCastSelectedBaseSkill(targetModel, tHrp, st)
	if skOk then
		st.m1ComboCount = 0
		st.attackBusyUntil = now + (skDur or 0.18)
		return true
	end

	if st.autoHeavy and (now - (st.lastHeavyAt or 0)) >= 2.2 then
		st.lastHeavyAt = now
		st.m1ComboCount = 0
		st.attackBusyUntil = now + 0.58
		fireHeavySwing()
		return true
	elseif st.autoLight then
		st.lastLightAt = now
		st.m1ComboCount = (st.m1ComboCount or 0) + 1
		local _, lightDur = fireLightSwing(targetModel, st)
		st.attackBusyUntil = now + (lightDur or 0.34)
		return true
	end

	return false
end

