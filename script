local function extractInternalState(pc)
	if type(pc) ~= "table" or typeof(debug) ~= "table" or type(debug.getupvalues) ~= "function" then
		return nil
	end
	for _, fnName in ipairs({"beginBasicAttack", "startServerMelee", "finishBasicAttack", "heavySwing"}) do
		local fn = rawget(pc, fnName)
		if type(fn) == "function" then
			local okUp, ups = pcall(debug.getupvalues, fn)
			if okUp and type(ups) == "table" then
				for _, v in pairs(ups) do
					if type(v) == "table" and type(rawget(v, "sendCombat")) == "function" then
						return v
					end
				end
			end
		end
	end
	return nil
end

local function getMeleeRemote(u69)
	if u69 and type(rawget(u69, "meleeRemote")) == "function" then
		local ok, mr = pcall(u69.meleeRemote)
		if ok and mr and typeof(mr) == "Instance" then
			_G.StandOut_KnownMeleeRemote = mr
			return mr
		end
	end
	if workspace:GetAttribute("ServerMelee") == true then
		local mods = ReplicatedStorage:FindFirstChild("Modules")
		local smas = mods and mods:FindFirstChild("ServerMeleeAnimSync")
		local rem = smas and smas:FindFirstChild("Remote")
		if rem and rem:IsA("RemoteEvent") then
			_G.StandOut_KnownMeleeRemote = rem
			return rem
		end
	end
	local rems = ReplicatedStorage:FindFirstChild("Remotes")
	local combat = rems and rems:FindFirstChild("Combat")
	if combat and (combat:IsA("RemoteEvent") or combat:IsA("UnreliableRemoteEvent")) then
		return combat
	end
	return _G.StandOut_KnownMeleeRemote or _G.StandOut_CachedMelee
end

local function getPlayerController()
	local char = LocalPlayer.Character
	if not char then return nil, nil end

	if cachedController and cachedControllerChar == char then
		local okFn, hs = pcall(function() return cachedController.heavySwing end)
		local disposed = cachedInternalState and rawget(cachedInternalState, "disposed") == true
		if okFn and type(hs) == "function" and not disposed then
			getMeleeRemote(cachedInternalState)
			return cachedController, cachedInternalState
		end
		cachedController = nil
		cachedInternalState = nil
		cachedControllerChar = nil
	end

	local core = char:FindFirstChild("Core")
	local pcMod = core and core:FindFirstChild("PlayerController")
	if not pcMod then return nil, nil end

	local okReq, pc = pcall(require, pcMod)
	if not okReq or type(pc) ~= "table" or type(rawget(pc, "heavySwing")) ~= "function" then
		return nil, nil
	end

	local u69 = extractInternalState(pc)
	if u69 and not rawget(u69, "_standOutSendCombatWrapped") then
		local origSend = rawget(u69, "sendCombat")
		if type(origSend) == "function" then
			rawset(u69, "_standOutSendCombatWrapped", true)
			rawset(u69, "sendCombat", function(a1, ...)
				local cb = _G.StandOut_OnSendCombat
				if type(cb) == "function" then
					pcall(cb, a1, ...)
				end
				return origSend(a1, ...)
			end)
		end
	end

	cachedController = pc
	cachedInternalState = u69
	cachedControllerChar = char
	getMeleeRemote(u69)
	return pc, u69
end

