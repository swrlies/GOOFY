appMod.refreshBossMonitorUI = function()
	local tab = bossMonitorState.tab
	if not tab or not tab.body then return end

	local night = isGameNight()
	local clkStr = formatClockTime(LightingService.ClockTime)
	if night then
		tab.timeLbl.Text = string.format("Time: %s | NIGHT (DIO spawns at night)", clkStr)
		tab.timeLbl.TextColor3 = C_OK
	else
