	billboard.Parent         = part

	local dot = Instance.new("Frame")
	dot.AnchorPoint      = Vector2.new(0.5, 0.5)
	dot.Position         = UDim2.fromScale(0.5, 0.5)
	dot.Size             = UDim2.fromOffset(16, 16)
	dot.BackgroundColor3 = HL_FILL
	dot.BorderSizePixel  = 0
	dot.Parent           = billboard
	corner(dot, 8)

	local dotStroke = Instance.new("UIStroke")
	dotStroke.Color     = HL_OUTLINE
	dotStroke.Thickness = 2.5
	dotStroke.Parent    = dot

	local core = Instance.new("Frame")
	core.AnchorPoint      = Vector2.new(0.5, 0.5)
	core.Position         = UDim2.fromScale(0.5, 0.5)
	core.Size             = UDim2.fromOffset(6, 6)
	core.BackgroundColor3 = Color3.new(1, 1, 1)
	core.BorderSizePixel  = 0
	core.Parent           = billboard
	corner(core, 3)

	local ring = Instance.new("Frame")
	ring.AnchorPoint            = Vector2.new(0.5, 0.5)
	ring.Position               = UDim2.fromScale(0.5, 0.5)
	ring.Size                   = UDim2.fromOffset(18, 18)
	ring.BackgroundTransparency = 1
	ring.BorderSizePixel        = 0
	ring.Parent                 = billboard
	corner(ring, 999)

	local ringStroke = Instance.new("UIStroke")
	ringStroke.Color        = HL_OUTLINE
	ringStroke.Thickness    = 2.2
	ringStroke.Transparency = 0
	ringStroke.Parent       = ring

	local tInfo       = TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tweenRing   = TweenService:Create(ring, tInfo, {Size = UDim2.fromOffset(150, 150)})
	local tweenStroke = TweenService:Create(ringStroke, tInfo, {Transparency = 1})

	tweenRing:Play()
	tweenStroke:Play()

	table.insert(activeMarkers, {
		gui = billboard, ring = ring, stroke = ringStroke,
		tweenRing = tweenRing, tweenStroke = tweenStroke,
	})

	return billboard
end

task.spawn(function()
	while true do
		task.wait(1.7)
		if not isInstanceAlive() then return end
		for i = #activeMarkers, 1, -1 do
			local m = activeMarkers[i]
			if not m.gui or not m.gui.Parent then
				table.remove(activeMarkers, i)
			else
				m.ring.Size = UDim2.fromOffset(18, 18)
				m.stroke.Transparency = 0
				m.tweenRing:Play()
				m.tweenStroke:Play()
			end
		end
	end
end)

local function applyHighlight(item, part)
	if highlights[item] then return end
	local adorn = getAdornee(item, part)
	if not adorn or not part then return end

	local hl = Instance.new("Highlight")
	hl.Name                = "SIM_Highlight"
	hl.FillColor           = HL_FILL
	hl.FillTransparency    = 0.25
	hl.OutlineColor        = HL_OUTLINE
	hl.OutlineTransparency = 0
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee             = adorn
	hl.Parent              = adorn

	highlights[item] = { highlight = hl, marker = buildMarker(part) }
end

local function clearHighlight(item)
	local data = highlights[item]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.marker    then data.marker:Destroy()    end
	highlights[item] = nil
end

