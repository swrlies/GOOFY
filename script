-- Background / Multi-Instance Optimization (Eco Mode + 3D Render Toggle)
--=====================================================================
local LightingService = game:GetService("Lighting")

local ecoState = {
	enabled = false,
	no3d = false,
	origFpsCap = nil,
	origQualityLevel = nil,
	origSavedQuality = nil,
	origMasterVolume = nil,
	origGlobalShadows = nil,
	origTechnology = nil,
	origFogEnd = nil,
	origTerrain = nil,
	origEffects = {},
	descConn = nil,
}

local function isEcoVfxInstance(inst)
	return inst:IsA("PostEffect")
		or inst:IsA("ParticleEmitter")
		or inst:IsA("Trail")
		or inst:IsA("Beam")
		or inst:IsA("Fire")
		or inst:IsA("Smoke")
		or inst:IsA("Sparkles")
		or inst:IsA("Clouds")
end

local function disableVfxForEco(inst)
	if not ecoState.enabled then return end
	if isEcoVfxInstance(inst) then
		if ecoState.origEffects[inst] == nil then
			local okEn, en = pcall(function() return inst.Enabled end)
			if okEn and type(en) == "boolean" then
				ecoState.origEffects[inst] = en
			end
		end
		pcall(function() inst.Enabled = false end)
	end
end

local function applyEcoRuntimeSettings()
	if not ecoState.enabled then return end
	local ugs
	pcall(function() ugs = UserSettings():GetService("UserGameSettings") end)
	local renderSettings
	pcall(function()
		if typeof(settings) == "function" then
			renderSettings = settings().Rendering
		end
	end)
	if typeof(setfpscap) == "function" then
		pcall(setfpscap, 15)
	end
	if renderSettings then
		pcall(function() renderSettings.QualityLevel = Enum.QualityLevel.Level01 end)
	end
	if ugs then
		pcall(function() ugs.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1 end)
		pcall(function() ugs.MasterVolume = 0 end)
	end
	pcall(function() LightingService.GlobalShadows = false end)
end

local function ensureOrigGfxBaseline(ugs, renderSettings, terrain)
	if type(_G.StandOut_OrigGfx) == "table" then
		return _G.StandOut_OrigGfx
	end
	local base = {
		qualityLevel  = Enum.QualityLevel.Automatic,
		savedQuality  = Enum.SavedQualitySetting.Automatic,
		masterVolume  = 0.5,
		globalShadows = true,
		terrain       = {
			WaterWaveSize     = 0.15,
			WaterWaveSpeed    = 10,
			WaterReflectance  = 1,
			WaterTransparency = 0.3,
			Decoration        = true,
		},
	}
	if renderSettings then
		pcall(function()
			if renderSettings.QualityLevel ~= Enum.QualityLevel.Level01 then
				base.qualityLevel = renderSettings.QualityLevel
			end
		end)
	end
	if ugs then
		pcall(function()
			if ugs.SavedQualityLevel ~= Enum.SavedQualitySetting.QualityLevel1 then
				base.savedQuality = ugs.SavedQualityLevel
			end
			if ugs.MasterVolume and ugs.MasterVolume > 0.01 then
				base.masterVolume = ugs.MasterVolume
			end
		end)
	end
	pcall(function()
		if LightingService.GlobalShadows then
			base.globalShadows = true
		end
	end)
	if terrain then
		pcall(function()
			if terrain.Decoration or terrain.WaterWaveSize > 0 then
				base.terrain = {
					WaterWaveSize     = terrain.WaterWaveSize,
					WaterWaveSpeed    = terrain.WaterWaveSpeed,
					WaterReflectance  = terrain.WaterReflectance,
					WaterTransparency = terrain.WaterTransparency,
					Decoration        = terrain.Decoration,
				}
			end
		end)
	end
	_G.StandOut_OrigGfx = base
	return base
end

local function toggleEcoMode(state)
	state = (state == true)
	if state and ecoState.enabled then
	
		return
	end
	ecoState.enabled = state

	local ugs
	pcall(function() ugs = UserSettings():GetService("UserGameSettings") end)
	local renderSettings
	pcall(function()
		if typeof(settings) == "function" then
			renderSettings = settings().Rendering
		end
	end)
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	local baseGfx = ensureOrigGfxBaseline(ugs, renderSettings, terrain)

	if ecoState.enabled then
		-- 1. Save & limit FPS to 15 (avoid capturing leftover 15 FPS from server hops)
		if typeof(getfpscap) == "function" then
			local okCap, curCap = pcall(getfpscap)
			if okCap and type(curCap) == "number" and curCap > 15 then
				_G.StandOut_OrigFpsCap = curCap
				ecoState.origFpsCap = curCap
			elseif type(_G.StandOut_OrigFpsCap) == "number" and _G.StandOut_OrigFpsCap > 15 then
				ecoState.origFpsCap = _G.StandOut_OrigFpsCap
			else
				ecoState.origFpsCap = 60
			end
		else
			ecoState.origFpsCap = 60
		end
		if typeof(setfpscap) == "function" then
			pcall(setfpscap, 15)
		end

		-- 2. Drop Rendering Quality & SavedQualityLevel to lowest
		if renderSettings then
			pcall(function()
				ecoState.origQualityLevel = baseGfx.qualityLevel
				renderSettings.QualityLevel = Enum.QualityLevel.Level01
			end)
		end
		if ugs then
			pcall(function()
				ecoState.origSavedQuality = baseGfx.savedQuality
				ugs.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
			end)
			-- 3. Mute audio across background instances
			pcall(function()
				ecoState.origMasterVolume = baseGfx.masterVolume
				ugs.MasterVolume = 0
			end)
		end

		-- 4. Disable shadows & post-effects
		pcall(function()
			ecoState.origGlobalShadows = baseGfx.globalShadows
			LightingService.GlobalShadows = false
		end)

		-- 5. Flatten terrain water & grass decoration
		if terrain then
			pcall(function()
				ecoState.origTerrain = baseGfx.terrain
				terrain.WaterWaveSize = 0
				terrain.WaterWaveSpeed = 0
				terrain.WaterReflectance = 0
				terrain.WaterTransparency = 1
				terrain.Decoration = false
			end)
		end

		-- 6. Disable post-processing & particle/trail/beam VFX
		table.clear(ecoState.origEffects)
		for _, d in ipairs(LightingService:GetDescendants()) do
			disableVfxForEco(d)
		end
		for _, d in ipairs(workspace:GetDescendants()) do
			disableVfxForEco(d)
		end
		if ecoState.descConn then
			ecoState.descConn:Disconnect()
			ecoState.descConn = nil
		end
		ecoState.descConn = workspace.DescendantAdded:Connect(function(inst)
			if not isInstanceAlive() or not ecoState.enabled then return end
			disableVfxForEco(inst)
		end)
	else
		if ecoState.descConn then
			ecoState.descConn:Disconnect()
			ecoState.descConn = nil
		end

		local restoreCap = math.max(60, tonumber(ecoState.origFpsCap or _G.StandOut_OrigFpsCap or 60) or 60)
		if typeof(setfpscap) == "function" then
			pcall(setfpscap, restoreCap)
		end
		local qLvl = ecoState.origQualityLevel or baseGfx.qualityLevel
		if renderSettings and qLvl ~= nil then
			pcall(function() renderSettings.QualityLevel = qLvl end)
		end
		if ugs then
			local sqLvl = ecoState.origSavedQuality or baseGfx.savedQuality
			if sqLvl ~= nil then
				pcall(function() ugs.SavedQualityLevel = sqLvl end)
			end
			local mVol = ecoState.origMasterVolume or baseGfx.masterVolume
			if mVol ~= nil then
				pcall(function() ugs.MasterVolume = mVol end)
			end
		end
		local gs = (ecoState.origGlobalShadows ~= nil) and ecoState.origGlobalShadows or baseGfx.globalShadows
		if gs ~= nil then
			pcall(function() LightingService.GlobalShadows = gs end)
		end
		local ter = ecoState.origTerrain or baseGfx.terrain
		if terrain and ter then
			pcall(function()
				terrain.WaterWaveSize = ter.WaterWaveSize
				terrain.WaterWaveSpeed = ter.WaterWaveSpeed
				terrain.WaterReflectance = ter.WaterReflectance
				terrain.WaterTransparency = ter.WaterTransparency
				terrain.Decoration = ter.Decoration
			end)
		end
		for inst, origEn in pairs(ecoState.origEffects) do
			if inst and inst.Parent then
				pcall(function() inst.Enabled = origEn end)
			end
		end
		table.clear(ecoState.origEffects)
	end

end

local no3dSessionGen = 0

local function reassertNo3DRender()
	if not isInstanceAlive() or not ecoState.no3d then return end
	pcall(function()
		RunService:Set3dRenderingEnabled(false)
	end)
	applyEcoRuntimeSettings()
end

local function toggleNo3DRender(state)
	ecoState.no3d = (state == true)
	no3dSessionGen += 1
	local gen = no3dSessionGen
	pcall(function()
		RunService:Set3dRenderingEnabled(not ecoState.no3d)
	end)
	-- Server-hops / autoexec can race engine render init; re-assert during join settle
	if ecoState.no3d then
		for _, delaySec in ipairs({0.5, 2.0, 5.0}) do
			task.delay(delaySec, function()
				if no3dSessionGen ~= gen then return end
				reassertNo3DRender()
			end)
		end
	end

end

appMod.toggleEcoMode = toggleEcoMode
appMod.toggleNo3DRender = toggleNo3DRender
