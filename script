	if configControls.bossDIO and cfg.monitorDIO ~= nil then configControls.bossDIO.setState(cfg.monitorDIO) end
	if configControls.bossJotaro and cfg.monitorJotaro ~= nil then configControls.bossJotaro.setState(cfg.monitorJotaro) end
	if configControls.bossAutoHL and cfg.autoHighlight ~= nil then configControls.bossAutoHL.setState(cfg.autoHighlight) end
	if bossFarmUi.autoLight and cfg.autoLight ~= nil then bossFarmUi.autoLight.setState(cfg.autoLight) end
	if bossFarmUi.autoHeavy and cfg.autoHeavy ~= nil then bossFarmUi.autoHeavy.setState(cfg.autoHeavy) end
	if bossFarmUi.m1CountSlider and cfg.m1BeforeMove ~= nil then bossFarmUi.m1CountSlider.setValue(cfg.m1BeforeMove) end
	if bossFarmUi.latchModeDrop and cfg.latchMode ~= nil then bossFarmUi.latchModeDrop.setValue(cfg.latchMode, true) end
	if bossFarmUi.latchOffset and cfg.latchDistance ~= nil then bossFarmUi.latchOffset.setValue(cfg.latchDistance) end
	if bossFarmUi.skillsDrop and type(cfg.skills) == "table" then bossFarmUi.skillsDrop.setValue(cfg.skills, true) end
	if bossFarmUi.holdSkillsDrop and type(cfg.holdSkills) == "table" then bossFarmUi.holdSkillsDrop.setValue(cfg.holdSkills, true) end
	if bossFarmUi.exMovesDrop and type(cfg.exMoves) == "table" then bossFarmUi.exMovesDrop.setValue(cfg.exMoves, true) end
	if cfg.farmRunning ~= nil then setBossFarmRunning(cfg.farmRunning == true) end
end

