			startBtn.BackgroundColor3 = C_ERR
			status.Text = "Status: Running"
			status.TextColor3 = C_OK
		else
			if autoCollectState.currentTween then
				pcall(function() autoCollectState.currentTween:Cancel() end)
				autoCollectState.currentTween = nil
			end
			autoCollectState.busy = false

			startBtn.Text = "Start Auto Collect"
			startBtn.BackgroundColor3 = C_ACCENT
			status.Text = "Status: Stopped"
			status.TextColor3 = C_SUB
		end
		updateCountLabel()
	end)

	tab.body = body
	tab.state = { shownCount = 0 }
	tab.status = status
	tab.startBtn = startBtn

	autoCollectState.statusTab = tab
end

for i, tab in ipairs(tabs) do
	tab.tabBtn = buildTabBtn(tab, i - 1, tabBar)
	if tab.isAutoCollect then
		buildAutoCollectBody(tab, main)
	else
		buildTabBody(tab, main)
	end
end

--=====================================================================
-- manager factory
--=====================================================================
local function createManager(tab)
	local state = {
		rows = {}, addedConn = nil, removedConn = nil,
		lastContainer = nil, lastItemSet = {}, knownItems = {},
		initialized = false, rebuildQueued = false, rebuildVersion = 0,
		shownCount = 0,
		showDistance = false,
	}
	tab.state = state

	tab.toggleBtn.MouseButton1Click:Connect(function()
		state.showDistance = not state.showDistance
		if state.showDistance then
			tab.toggleBtn.Text = "ON"
			tab.toggleBtn.BackgroundColor3 = C_OK
		else
			tab.toggleBtn.Text = "OFF"
			tab.toggleBtn.BackgroundColor3 = C_ROW
		end

		for item, data in pairs(state.rows) do
			if state.showDistance then
				data.info.Text = "Calculating..."
			else
				data.info.Text = ""
			end
		end
	end)

	local function matchesFilter(item)
		local q = string.lower(tab.search.Text)
		if q == "" then return true end
		return string.find(string.lower(getDisplayName(item, tab.name)), q, 1, true) ~= nil
	end

	local function createRow(item, order)
		local part        = getPart(item)
		local displayName = getDisplayName(item, tab.name)

		if tab.name == "Supplies" then
			displayName = "Buried Supplies #" .. order
		end

		local rightMargin = -8
		local hasHL   = not tab.autoHighlight
		local hasCopy = (tab.name == "Cases" or tab.name == "Teleports" or tab.name == "Scrap Barges")

		if hasCopy then rightMargin = rightMargin - 40 - 6 end
		if hasHL   then rightMargin = rightMargin - 34 - 6 end
		rightMargin = rightMargin - 58 - 8

		local row = Instance.new("Frame")
		row.Size             = UDim2.new(1, 0, 0, 46)
		row.BackgroundColor3 = C_ROW
		row.BorderSizePixel  = 0
		row.LayoutOrder      = order
		row.Parent           = tab.scroll
		corner(row, 6)

		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Position       = UDim2.fromOffset(8, 4)
		nameLabel.Size           = UDim2.new(1, rightMargin, 0, 16)
		nameLabel.Font           = Enum.Font.GothamMedium
		nameLabel.TextSize       = 12
		nameLabel.TextColor3     = C_TEXT
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate   = Enum.TextTruncate.AtEnd
		nameLabel.Text           = displayName
		nameLabel.Parent         = row

		local info = Instance.new("TextLabel")
		info.BackgroundTransparency = 1
		info.Position       = UDim2.fromOffset(8, 22)
		info.Size           = UDim2.new(1, rightMargin, 0, 16)
		info.Font           = Enum.Font.Code
		info.TextSize       = 11
		info.TextColor3     = C_SUB
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.TextTruncate   = Enum.TextTruncate.AtEnd
		info.Text           = state.showDistance and "Calculating..." or ""
		info.Parent         = row

		local tp = Instance.new("TextButton")
		tp.Text             = "Teleport"
		tp.Font             = Enum.Font.GothamBold
		tp.TextSize         = 11
		tp.TextColor3       = Color3.new(1, 1, 1)
		tp.TextStrokeColor3 = Color3.new(0, 0, 0)
		tp.TextStrokeTransparency = 0.5

		tp.BackgroundColor3 = part and C_ACCENT or C_ROW_HOT
		tp.BorderSizePixel  = 0
		tp.Position         = UDim2.new(1, -66, 0.5, -14)
		tp.Size             = UDim2.fromOffset(58, 28)
		tp.Parent           = row
		corner(tp, 5)

		local hlBtn
		if hasHL then
			hlBtn = Instance.new("TextButton")
			hlBtn.Text             = "HL"
			hlBtn.Font             = Enum.Font.GothamBold
			hlBtn.TextSize         = 11
			hlBtn.TextColor3       = C_TEXT
			hlBtn.BackgroundColor3 = highlights[item] and C_ACCENT or C_ROW_HOT
			hlBtn.BorderSizePixel  = 0
			hlBtn.Position         = UDim2.new(1, -108, 0.5, -14)
			hlBtn.Size             = UDim2.fromOffset(34, 28)
			hlBtn.Parent           = row
			corner(hlBtn, 5)

			hlBtn.MouseButton1Click:Connect(function()
				if highlights[item] then
					clearHighlight(item)
					hlBtn.BackgroundColor3 = C_ROW_HOT
				elseif part and part:IsDescendantOf(workspace) then
					applyHighlight(item, part)
					hlBtn.BackgroundColor3 = C_ACCENT
				end
			end)
		end

		if hasCopy then
			local copyBtn = Instance.new("TextButton")
			copyBtn.Text             = "Copy"
			copyBtn.Font             = Enum.Font.GothamBold
			copyBtn.TextSize         = 11
			copyBtn.TextColor3       = C_TEXT
			copyBtn.BackgroundColor3 = C_PANEL
			copyBtn.BorderSizePixel  = 0
			copyBtn.Position         = UDim2.new(1, -148, 0.5, -14)
			copyBtn.Size             = UDim2.fromOffset(34, 28)
			copyBtn.Parent           = row
			corner(copyBtn, 5)

			copyBtn.MouseButton1Click:Connect(function()
				if part then
					local pos = part.Position
					local text = string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
					if setclipboard then
						pcall(setclipboard, text)
						copyBtn.Text = "✔"
						copyBtn.TextColor3 = C_OK
						task.delay(1.5, function()
							if copyBtn and copyBtn.Parent then
								copyBtn.Text = "Copy"
								copyBtn.TextColor3 = C_TEXT
							end
						end)
					else
						tab.status.Text = "Clipboard not supported."
						tab.status.TextColor3 = C_ERR
					end
				end
			end)
		end

		row.MouseEnter:Connect(function() row.BackgroundColor3 = C_ROW_HOT end)
		row.MouseLeave:Connect(function() row.BackgroundColor3 = C_ROW end)

		tp.MouseButton1Click:Connect(function()
			if not item:IsDescendantOf(workspace) then
				tab.status.Text = "Item no longer exists."
				tab.status.TextColor3 = C_ERR
				return
			end
			local ok, err = teleportToItem(item)
			if ok then
				tab.status.Text       = "Teleported to: " .. displayName
				tab.status.TextColor3 = C_OK
			else
				tab.status.Text       = err
				tab.status.TextColor3 = C_ERR
			end
		end)

		state.rows[item] = { frame = row, info = info, tp = tp, hl = hlBtn, part = part }
	end

	local function clearRows()
		for _, data in pairs(state.rows) do
			if data.frame then data.frame:Destroy() end
		end
		state.rows = {}
	end

	local function rebuild()
		state.rebuildQueued  = false
		state.rebuildVersion = (state.rebuildVersion or 0) + 1

		clearRows()

		local container = tab.getContainer()
		if container ~= state.lastContainer then
			if state.addedConn   then state.addedConn:Disconnect();   state.addedConn   = nil end
			if state.removedConn then state.removedConn:Disconnect(); state.removedConn = nil end
			state.lastContainer = container
			if container then
				local function queue(child)
					if child and (child.Name == "SIM_Marker" or child.Name == "SIM_Highlight") then return end
					if state.rebuildQueued then return end

					state.rebuildQueued = true
					local version = state.rebuildVersion
					task.delay(0.2, function()
						if state.rebuildQueued and state.rebuildVersion == version then
							rebuild()
						else
							state.rebuildQueued = false
						end
					end)
				end
				state.addedConn   = container.DescendantAdded:Connect(queue)
				state.removedConn = container.DescendantRemoving:Connect(queue)
			end
		end

		if not container then
			state.shownCount = 0
			tab.status.Text       = "Waiting"
			tab.status.TextColor3 = C_SUB
			tab.empty.Text        = tab.emptyText
			tab.empty.Visible     = true
			for item in pairs(state.knownItems) do clearHighlight(item) end
			state.knownItems  = {}
			state.lastItemSet = {}
			if tab == activeTab then updateCountLabel() end
			return
		end

		local rawEntries = collectEntries(container, tab.name)

		local entries = {}
		for _, item in ipairs(rawEntries) do
			if isValidItem(item, tab.name) then
				table.insert(entries, item)
			end
		end

		table.sort(entries, function(a, b)
			return string.lower(getDisplayName(a, tab.name)) < string.lower(getDisplayName(b, tab.name))
		end)

		local currentAll = {}
		for _, item in ipairs(entries) do currentAll[item] = true end

		if state.initialized and tab.notify then
			for item in pairs(currentAll) do
				if not state.knownItems[item] then notifySpawn(item, tab.name) end
			end
		end

		for item in pairs(state.knownItems) do
			if not currentAll[item] then clearHighlight(item) end
		end

		state.knownItems  = currentAll
		state.lastItemSet = currentAll
		state.initialized = true

		if tab.autoHighlight then
			for item in pairs(currentAll) do
				if not highlights[item] then
					local p = getPart(item)
					if p then applyHighlight(item, p) end
				end
			end
		end

		local shown = 0

		if tab.name == "Teleports" then
			local groups = {
				["Miscellaneous"] = {},
				["Raids"] = {}
			}

			for _, item in ipairs(entries) do
				local group = item:GetAttribute("Group") or "Miscellaneous"
				if groups[group] then
					table.insert(groups[group], item)
				end
			end

			local function renderGroup(groupName, list)
				if #list == 0 then return end

				shown += 1
				local header = Instance.new("TextLabel")
				header.Size = UDim2.new(1, 0, 0, 28)
				header.BackgroundTransparency = 1
				header.Text = groupName
				header.Font = Enum.Font.GothamBold
				header.TextSize = 12
				header.TextColor3 = C_ACCENT
				header.TextXAlignment = Enum.TextXAlignment.Left
				header.LayoutOrder = shown
				header.Parent = tab.scroll

				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 8)
				pad.Parent = header

				table.sort(list, function(a, b)
					return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
				end)

				for _, item in ipairs(list) do
					shown += 1
					createRow(item, shown)
				end
			end

			renderGroup("Miscellaneous", groups["Miscellaneous"])
			renderGroup("Raids", groups["Raids"])

		else
			for _, item in ipairs(entries) do
				if matchesFilter(item) then
					shown += 1
					createRow(item, shown)
				end
			end
		end

		state.shownCount = shown
		if tab == activeTab then updateCountLabel() end

		if shown == 0 then
			tab.empty.Text    = (#entries == 0) and tab.emptyText or "No items match the filter."
			tab.empty.Visible = true
			tab.status.Text   = (#entries == 0) and "Waiting" or "Filter active"
			tab.status.TextColor3 = C_SUB
		else
			tab.empty.Visible = false
			tab.status.Text   = ""
		end
	end

	tab.rebuild = rebuild
	tab.getItemSet = function(cont)
		local set = {}
		if not cont then return set end
		for _, item in ipairs(collectEntries(cont, tab.name)) do
			if isValidItem(item, tab.name) then
				set[item] = true
			end
		end
		return set
	end
end

for _, tab in ipairs(tabs) do
	if not tab.isAutoCollect then
		createManager(tab)
	end
end

