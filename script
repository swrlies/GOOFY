returnBtn.MouseButton1Click:Connect(function()
	local ok, err = returnToSaved()
	if activeTab and activeTab.status then
		if ok then
			activeTab.status.Text = "Returned to your saved position."
			activeTab.status.TextColor3 = C_SUB
		else
			activeTab.status.Text = err
			activeTab.status.TextColor3 = C_WARN
		end
	end
end)

do
	local dragging, dragStart, startPos
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging  = true
			dragStart = input.Position
			startPos  = main.Position
		end
	end)
	header.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
end

local toggleDragging = false
local toggleDragStart = nil
local toggleStartPos = nil
local toggleHasMoved = false

toggleBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		toggleDragging  = true
		toggleHasMoved  = false
		toggleDragStart = input.Position
		toggleStartPos  = toggleBtn.Position
	end
end)

toggleBtn.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		toggleDragging = false
		if not toggleHasMoved then
			main.Visible = true
			toggleBtn.Visible = false
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not toggleDragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - toggleDragStart
		if d.Magnitude > 5 then
			toggleHasMoved = true
		end

		toggleBtn.Position = UDim2.new(
			toggleStartPos.X.Scale, toggleStartPos.X.Offset + d.X,
			toggleStartPos.Y.Scale, toggleStartPos.Y.Offset + d.Y
		)
	end
end)

local minimized     = false
local expandedSize  = UDim2.fromOffset(490, 464)
local collapsedSize = UDim2.fromOffset(490, 38)

minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "-"

	if minimized then
		tabBar.Visible = false
		separator.Visible = false
		footer.Visible = false
		for _, t in ipairs(tabs) do t.body.Visible = false end

		TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = collapsedSize
		}):Play()
	else
		TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = expandedSize
		}):Play()

		task.delay(0.1, function()
			if not minimized then
				tabBar.Visible = true
				separator.Visible = true
				footer.Visible = true
				if activeTab then activeTab.body.Visible = true end
			end
		end)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	main.Visible = false
	toggleBtn.Visible = true
end)

