--=====================================================================
local function isPileOfMoney(item)
	if not item then return false end
	local rawName = string.lower(item.Name)
	local dispName = string.lower(getDisplayName(item, "World Events"))
	return (string.find(rawName, "pile of money", 1, true) ~= nil)
		or (string.find(dispName, "pile of money", 1, true) ~= nil)
end

local function getCollectAction(item, catName)
	if catName == "Buried Supplies" then
		return {key = "H", holdTime = 1.3, multiHolds = 2, hint = "Collecting supplies..."}
	elseif catName == "Scrap Barges" then
		return {key = "R", holdTime = 0.08, multiHolds = 1}
	elseif catName == "World Events" then
		if isPileOfMoney(item) then
			return {key = "H", holdTime = 15.0, multiHolds = 1, isMoneyPile = true, hint = "Collecting Pile of Money..."}
		else
			return {key = "H", holdTime = 0.01, multiHolds = 1, fastChain = true}
		end
	else
		return {key = "H", holdTime = 0.08, multiHolds = 1}
	end
end

local function getItemsForCategory(catName)
	local items = {}
	if catName == "Spawned Items" then
		local g = workspace:FindFirstChild("Game")
		local c = g and g:FindFirstChild("SpawnedItems")
		if c then
			for _, item in ipairs(collectEntries(c, "Items")) do
				if isValidItem(item, "Items") then table.insert(items, item) end
			end
		end
	elseif catName == "Buried Supplies" then
		local g = workspace:FindFirstChild("Game")
		local gar = g and g:FindFirstChild("Gardening")
		local for_ = gar and gar:FindFirstChild("Foraging")
		if for_ then
			for _, child in ipairs(for_:GetChildren()) do
				if child.Name:match("^BuriedSupplies") and child:GetAttribute("GardenSupplyAvailable") ~= false then
					table.insert(items, child)
				end
			end
		end
	elseif catName == "Scrap Barges" then
		rescanScrapPieces()
		for obj in pairs(scrapPieces) do
			if obj and obj:IsDescendantOf(workspace) then
				table.insert(items, obj)
			else
				scrapPieces[obj] = nil
			end
		end
	elseif catName == "World Events" then
		local g = workspace:FindFirstChild("Game")
		local w = g and g:FindFirstChild("WorldEventDrops")
		if w then
			for _, item in ipairs(collectEntries(w, "World Events")) do
				table.insert(items, item)
			end
		end
	end
	return items
end

