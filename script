	labelLbl.Font = Enum.Font.GothamBold
	labelLbl.TextSize = 11
	labelLbl.TextColor3 = C_SUB
	labelLbl.BackgroundTransparency = 1
	labelLbl.Size = UDim2.new(1, allowKeybind and -138 or -50, 1, 0)
	labelLbl.TextXAlignment = Enum.TextXAlignment.Left
	labelLbl.Parent = container

	local switchBg = Instance.new("Frame")
	switchBg.Size = UDim2.fromOffset(40, 20)
	switchBg.Position = allowKeybind and UDim2.new(1, -124, 0.5, -10) or UDim2.new(1, -40, 0.5, -10)
	switchBg.BackgroundColor3 = defaultState and C_OK or C_ROW_HOT
	switchBg.BorderSizePixel = 0
	switchBg.Parent = container
	corner(switchBg, 10)

	local thumb = Instance.new("Frame")
	thumb.Size = UDim2.fromOffset(16, 16)
	thumb.Position = defaultState and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
	thumb.BackgroundColor3 = C_TEXT
	thumb.BorderSizePixel = 0
	thumb.Parent = switchBg
	corner(thumb, 8)

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Parent = switchBg

	local state = defaultState
	local function setState(newState)
		state = newState
		switchBg.BackgroundColor3 = state and C_OK or C_ROW_HOT
		TweenService:Create(thumb, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
		}):Play()
		if onChange then onChange(state) end
	end

	btn.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	if allowKeybind then
		local kbBtn = Instance.new("TextButton")
		kbBtn.Size = UDim2.fromOffset(76, 22)
		kbBtn.Position = UDim2.new(1, -76, 0.5, -11)
		kbBtn.BackgroundColor3 = C_PANEL
		kbBtn.BorderSizePixel = 0
		kbBtn.Font = Enum.Font.GothamBold
		kbBtn.TextSize = 10
		kbBtn.TextColor3 = C_SUB
		kbBtn.Text = "Click to bind"
		kbBtn.TextTruncate = Enum.TextTruncate.AtEnd
		kbBtn.Parent = container
		corner(kbBtn, 5)
		stroke(kbBtn, C_STROKE, 1, 0.35)

		local entry = {
			key = nil,
			btn = kbBtn,
			toggle = function()
				setState(not state)
			end,
		}
		table.insert(registeredKeybinds, entry)

		kbBtn.MouseButton1Click:Connect(function()
			if listeningToggle == entry then
				listeningToggle = nil
				kbBtn.Text = entry.key and ("[" .. entry.key.Name .. "]") or "Click to bind"
				kbBtn.TextColor3 = entry.key and C_TEXT or C_SUB
			else
				if listeningToggle then
					local prev = listeningToggle
					prev.btn.Text = prev.key and ("[" .. prev.key.Name .. "]") or "Click to bind"
					prev.btn.TextColor3 = prev.key and C_TEXT or C_SUB
				end
				listeningToggle = entry
				kbBtn.Text = "Press key..."
				kbBtn.TextColor3 = C_WARN
			end
		end)
	end

	if onChange then onChange(state) end
end

