local function getPart(inst)
	if not inst then return nil end
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	if inst:IsA("Folder") then
		return inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function getItemPosition(item)
	local part = getPart(item)
	if part then return part.Position end
	if item and item:IsA("Model") then
		local ok, cf = pcall(function() return item:GetPivot() end)
		if ok and cf then return cf.Position end
	end
	return nil
end

local function getBargeStandCFrame(bargePos, refPos)
	local flatAway = Vector3.new(refPos.X - bargePos.X, 0, refPos.Z - bargePos.Z)
	if flatAway.Magnitude < 0.05 then
		flatAway = Vector3.new(0, 0, 1)
	else
		flatAway = flatAway.Unit
	end
	local standPos = Vector3.new(bargePos.X, bargePos.Y, bargePos.Z) + (flatAway * 3.2) + Vector3.new(0, 1.8, 0)
	local lookAt   = Vector3.new(bargePos.X, standPos.Y, bargePos.Z)
	return CFrame.new(standPos, lookAt)
end

