			local newW = math.clamp(math.round(rStartSize.X + delta.X), uiChrome.minW, maxW)
			local newH = math.clamp(math.round(rStartSize.Y + delta.Y), uiChrome.minH, maxH)
			expandedSize = UDim2.fromOffset(newW, newH)
			collapsedSize = UDim2.fromOffset(newW, 38)
			main.Size = expandedSize
		end
	end)
end

minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "–"

	if minimized then
		TweenService:Create(headerCorner, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CornerRadius = UDim.new(0, 10)
		}):Play()
		tabBar.Visible = false
		separator.Visible = false
		footer.Visible = false
		resizeHandle.Visible = false
