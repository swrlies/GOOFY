local highlights = {}

local function buildMarker(part)
	local billboard = Instance.new("BillboardGui")
	billboard.Name           = "SIM_Marker"
	billboard.Size           = UDim2.fromOffset(220, 220)
	billboard.AlwaysOnTop    = true
	billboard.MaxDistance    = 20000
	billboard.LightInfluence = 0
	billboard.Adornee        = part
	billboard.Parent         = part

	local dot = Instance.new("Frame")
	dot.Size             = UDim2.fromOffset(26, 26)
	dot.Position         = UDim2.fromOffset(97, 97)
	dot.BackgroundColor3 = HL_FILL
	dot.BorderSizePixel  = 0
	dot.Parent           = billboard
	corner(dot, 13)
	local dotStroke = Instance.new("UIStroke")
	dotStroke.Color = HL_OUTLINE; dotStroke.Thickness = 3
	dotStroke.Parent = dot

	local ring = Instance.new("Frame")
	ring.Size                   = UDim2.fromOffset(26, 26)
	ring.Position               = UDim2.fromOffset(97, 97)
	ring.BackgroundTransparency = 1
	ring.BorderSizePixel        = 0
	ring.BackgroundColor3       = HL_FILL
	ring.Parent                 = billboard
	corner(ring, 13)
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Color = HL_OUTLINE; ringStroke.Thickness = 3
	ringStroke.Transparency = 0
	ringStroke.Parent = ring

	task.spawn(function()
		while billboard.Parent do
			ring.Size     = UDim2.fromOffset(26, 26)
			ring.Position = UDim2.fromOffset(97, 97)
			ringStroke.Transparency = 0
			TweenService:Create(ring, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.fromOffset(210, 210), Position = UDim2.fromOffset(5, 5),
			}):Play()
			TweenService:Create(ringStroke, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1,
			}):Play()
			task.wait(1.6)
		end
	end)

	return billboard
end

local function applyHighlight(item, part)
	if highlights[item] then return end
	local adorn = getAdornee(item, part)
	if not adorn or not part then return end

	local hl = Instance.new("Highlight")
	hl.Name                = "SIM_Highlight"
	hl.FillColor           = HL_FILL
	hl.FillTransparency    = 0.15
	hl.OutlineColor        = HL_OUTLINE
	hl.OutlineTransparency = 0
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee             = adorn
	hl.Parent              = adorn

	highlights[item] = { highlight = hl, marker = buildMarker(part) }
end

local function clearHighlight(item)
	local data = highlights[item]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.marker    then data.marker:Destroy()    end
	highlights[item] = nil
end

