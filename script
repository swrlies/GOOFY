local autoCollectState = {
	running      = false,
	targets      = {},
	mode         = "Teleport",
	collected    = {},
	attempts     = {},
	currentTween = nil,
	busy         = false,
	statusTab    = nil,
}

local function getItemsForCategory(catName)
	local items = {}
	if catName == "Spawned Items" then
		local g = workspace:FindFirstChild("Game")
		local c = g and g:FindFirstChild("SpawnedItems")
		if c then
			for _, item in ipairs(collectEntries(c, "Items")) do
				if isValidItem(item, "Items") then table.insert(items, item) end
			end
		end
	elseif catName == "Buried Supplies" then
		local g = workspace:FindFirstChild("Game")
		local gar = g and g:FindFirstChild("Gardening")
		local for_ = gar and gar:FindFirstChild("Foraging")
		if for_ then
			for _, child in ipairs(for_:GetChildren()) do
				if child.Name:match("^BuriedSupplies") then table.insert(items, child) end
			end
		end
	elseif catName == "Scrap Barges" then
		for _, item in ipairs(scrapBeaconFolder:GetChildren()) do
			table.insert(items, item)
		end
	end
	return items
end

-- Tween toward an item. Returns true if tween started. onComplete(ok) fires once.
local function tweenToItem(item, onComplete)
	local part = getPart(item)
	if not part then
		if onComplete then onComplete(false) end
		return false
	end
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if onComplete then onComplete(false) end
		return false
	end

	if autoCollectState.currentTween then
		pcall(function() autoCollectState.currentTween:Cancel() end)
		autoCollectState.currentTween = nil
	end

	local startCF = hrp.CFrame
	local endCF   = CFrame.new(part.Position + Vector3.new(0, 3, 0))
	local cframeVal = Instance.new("CFrameValue")
	cframeVal.Value = startCF

	hrp.Anchored = true

	local tween = TweenService:Create(cframeVal, TweenInfo.new(TWEEN_DURATION, Enum.EasingStyle.Linear), {Value = endCF})
	autoCollectState.currentTween = tween

	local finished = false
	local cancelled = false
	local conn

	local function finalize(success)
		if finished then return end
		finished = true

		if conn then
			conn:Disconnect()
			conn = nil
		end
		if hrp and hrp.Parent then
			hrp.Anchored = false
		end
		if cframeVal and cframeVal.Parent then
			cframeVal:Destroy()
		end
		if autoCollectState.currentTween == tween then
			autoCollectState.currentTween = nil
		end
		if onComplete then onComplete(success and not cancelled) end
	end

	conn = cframeVal.Changed:Connect(function(val)
		if finished then return end
		if not autoCollectState.running then
			cancelled = true
			pcall(function() tween:Cancel() end)
			return
		end
		if hrp and hrp.Parent then
			hrp.CFrame = val
		end
	end)

	tween.Completed:Connect(function()
		finalize(true)
	end)

	tween:Play()
	return true
end

-- Main collection driver
task.spawn(function()
	while true do
		task.wait(0.15)
		if not autoCollectState.running then continue end
		if autoCollectState.busy then continue end

		for inst in pairs(autoCollectState.collected) do
			if not inst:IsDescendantOf(workspace) then
				autoCollectState.collected[inst] = nil
			end
		end
		for inst in pairs(autoCollectState.attempts) do
			if not inst:IsDescendantOf(workspace) then
				autoCollectState.attempts[inst] = nil
			end
		end

		local char = LocalPlayer.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then continue end

		local available = {}
		for targetName in pairs(autoCollectState.targets) do
			local items = getItemsForCategory(targetName)
			for _, item in ipairs(items) do
				if not autoCollectState.collected[item] and item:IsDescendantOf(workspace) then
					local part = getPart(item)
					if part then
						table.insert(available, {item = item, pos = part.Position})
					end
				end
			end
		end

		if #available == 0 then
			if autoCollectState.statusTab and autoCollectState.statusTab.status then
				autoCollectState.statusTab.status.Text = "Waiting for items..."
				autoCollectState.statusTab.status.TextColor3 = C_SUB
			end
			continue
		end

		local ppos = hrp.Position
		table.sort(available, function(a, b)
			return (a.pos - ppos).Magnitude < (b.pos - ppos).Magnitude
		end)

		local targetItem = available[1].item
		local name       = getDisplayName(targetItem, "Items")

		if autoCollectState.statusTab and autoCollectState.statusTab.status then
			autoCollectState.statusTab.status.Text = "Collecting: " .. name
			autoCollectState.statusTab.status.TextColor3 = C_OK
		end

		autoCollectState.busy = true

		local moved = false
		if autoCollectState.mode == "Teleport" then
			local ok = teleportToItem(targetItem)
			moved = ok == true
			if moved then
				task.wait(TELEPORT_SETTLE)
			end
		elseif autoCollectState.mode == "Tween" then
			local done, ok = false, false
			tweenToItem(targetItem, function(success)
				done = true
				ok   = success
			end)
			local t0 = os.clock()
			while not done and autoCollectState.running and (os.clock() - t0) < (TWEEN_DURATION + 2) do
				task.wait(0.05)
			end
			moved = ok
			if moved then
				task.wait(TWEEN_SETTLE)
			end
		end

		if not autoCollectState.running then
			autoCollectState.busy = false
			continue
		end

		if not targetItem:IsDescendantOf(workspace) then
			autoCollectState.collected[targetItem] = true
			autoCollectState.attempts[targetItem]  = nil
		else
			local att = autoCollectState.attempts[targetItem] or {count = 0}
			att.count += 1
			autoCollectState.attempts[targetItem] = att

			if att.count >= COLLECT_MAX_TRIES then
				autoCollectState.collected[targetItem] = true
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text = "Gave up: " .. name
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				end
				task.wait(0.8)
			else
				if autoCollectState.statusTab and autoCollectState.statusTab.status then
					autoCollectState.statusTab.status.Text =
						string.format("Retrying %s (%d/%d)", name, att.count, COLLECT_MAX_TRIES)
					autoCollectState.statusTab.status.TextColor3 = C_WARN
				end
				task.wait(COLLECT_RETRY_DELAY)
			end
		end

		autoCollectState.busy = false
	end
end)

